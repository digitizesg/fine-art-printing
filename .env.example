# Supabase — frame-examples backend
# Copy to .env.local for local dev. In Vercel, set as Project Settings → Environment Variables.
# PUBLIC_* vars are exposed to the client; the service role key is server-only.

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy hook — POSTed when admin clicks "Publish to live"
VERCEL_DEPLOY_HOOK_URL=

# Stripe — test keys for now; swap to live keys before going public.
# Used by /api/checkout to create Stripe Checkout sessions.
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks.
# Used by /api/stripe-webhook to verify event authenticity.
STRIPE_WEBHOOK_SECRET=
# Public key is currently not used by the codebase (Stripe Checkout handles
# the redirect on the server) but reserved for embedded card forms later.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional email for order confirmations + contact form.
RESEND_API_KEY=
# Where order + contact-form notifications land for the studio (you).
ORDER_NOTIFICATION_EMAIL=hello@fineartprinting.com.sg
# The "From" address customer-facing emails are sent from. Must be on a
# domain that's verified in Resend.
ORDER_FROM_EMAIL=hello@fineartprinting.com.sg

# Cloudflare Turnstile — bot/spam protection on the contact form.
# Site key is public (rendered client-side). Secret key verifies tokens
# server-side. Sign up at cloudflare.com → Turnstile → Add site, then
# paste both keys here. If left blank, the form still works (with
# honeypot only) but is more exposed to bots.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
