---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { business } from "../../data/business";
import { createSupabaseAdminClient } from "../../lib/supabase-server";

// Anyone with an order's stripe_session_id can hit this page. Session
// IDs aren't auth tokens — they leak via referrers, browser history,
// shared screenshots — so we only surface non-PII fields here:
// reference + total + delivery-method label + kind. Customer name and
// shipping address are NOT shown; the customer gets the full details
// via the confirmation email.
const sessionId = Astro.url.searchParams.get("session_id");
let reference: string | null = null;
let deliveryMethod: "self" | "local" | null = null;
let totalSGD: number | null = null;
let kind: "shop" | "custom_payment" | "valuation" | null = null;

if (sessionId) {
  const supabase = createSupabaseAdminClient();
  if (supabase) {
    const { data } = await supabase
      .from("orders")
      .select("reference, delivery_method, total_sgd, kind")
      .eq("stripe_session_id", sessionId)
      .maybeSingle();
    reference = data?.reference ?? null;
    deliveryMethod = (data?.delivery_method as "self" | "local") ?? null;
    totalSGD = data?.total_sgd != null ? Number(data.total_sgd) : null;
    kind = (data?.kind as typeof kind) ?? null;
  }
}

const description = "Thanks for your order at Fine Art Printing.";
---
<BaseLayout title="Order confirmed · Fine Art Printing" description={description}>
  <section class="bg-white">
    <div class="mx-auto max-w-[720px] px-6 pt-14 pb-20 md:pt-20 md:pb-28 text-center">
      <Eyebrow>Order confirmed</Eyebrow>
      <h1 class="mt-3 font-serif text-[clamp(1.85rem,3.5vw,2.4rem)] font-medium leading-[1.1] text-ink text-balance">
        Thank you.
      </h1>
      <p class="mt-6 mx-auto max-w-[560px] text-[15.5px] leading-relaxed text-subtle">
        {kind === "valuation"
          ? "Your payment was successful and we've received your submission. We'll review the artwork(s) and respond within 2 to 3 working days. A confirmation email is on its way."
          : "Your payment was successful and your order is in our queue. A confirmation email is on its way with your full order details."}
      </p>

      {reference && (
        <div class="mt-10 mx-auto max-w-[480px] rounded-card border border-border-soft bg-[#FAF7F1] p-6 text-left">
          <div class="flex items-baseline justify-between gap-4">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-muted">Reference</p>
            <p class="font-mono text-[16px] font-medium text-ink tracking-tight">{reference}</p>
          </div>
          {totalSGD != null && (
            <div class="mt-3 flex items-baseline justify-between gap-4">
              <p class="text-[12px] font-semibold uppercase tracking-wide text-muted">Total paid</p>
              <p class="font-serif text-[18px] font-medium text-ink">S${totalSGD.toLocaleString("en-SG")}</p>
            </div>
          )}
          {kind !== "valuation" && deliveryMethod === "self" && (
            <p class="mt-3 text-[13px] text-subtle">
              Self-collection from our studio. We'll WhatsApp or email you
              when your order is ready (typically 5-7 working days).
            </p>
          )}
          {deliveryMethod === "local" && (
            <p class="mt-3 text-[13px] text-subtle">
              We'll arrange courier once your order is ready (typically 5-7
              working days). The full delivery address and a tracking link
              are in your confirmation email.
            </p>
          )}
        </div>
      )}

      <p class="mt-8 text-[13px] text-subtle">
        Don't see the email? Check your spam folder, or{" "}
        <a href={business.whatsappLink} target="_blank" rel="noopener" class="font-semibold text-petrol hover:underline">message us on WhatsApp</a>.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/shop" class="inline-flex items-center justify-center rounded-full bg-petrol px-6 py-3 text-[14px] font-semibold text-white">Browse more artwork</a>
        <a href="/" class="inline-flex items-center justify-center rounded-full border border-border-soft px-6 py-3 text-[14px] font-semibold text-ink">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Clear the cart on the success page so it's empty next time the user
  // visits /cart. We assume the order is finalised at this point because
  // Stripe only redirects here on a completed payment.
  import { cart } from "../../lib/cart";
  cart.clear();
</script>
