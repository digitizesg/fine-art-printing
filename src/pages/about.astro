---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import GoogleReviewsBadge from "../components/GoogleReviewsBadge.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import ReviewSection from "../components/ReviewSection.astro";
import DarkCTA from "../components/DarkCTA.astro";
import { business } from "../data/business";
import reviewsData from "../data/reviews.json";

const { rating, userRatingsTotal } = reviewsData;

const description =
  "Fine Art Printing is the only Hahnemühle Gold-certified print, canvas stretching, and framing studio in Singapore. Meet the team and see how we work in Lower Delta.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Fine Art Printing",
  url: `https://${business.domain}/about`,
  about: {
    "@type": "LocalBusiness",
    name: business.name,
    url: `https://${business.domain}`,
  },
};

const differentiators = [
  {
    title: "Hahnemühle Gold-certified.",
    body:
      "We're the first and only studio in Singapore awarded Gold certification by Hahnemühle, granted only to studios that meet their print quality standards over time. Not a one-off badge, an ongoing benchmark.",
  },
  {
    title: "Latest Canon Pro-566, manufacturer inks only.",
    body:
      "A 12-colour large-format pigment printer paired with original Canon inks. We never substitute third-party inks, the savings aren't worth the loss in colour accuracy and longevity.",
  },
  {
    title: "Colour-managed end to end.",
    body:
      "ICC profiling and consistent calibration across every paper and canvas we stock, so what comes off the printer matches what you saw on screen.",
  },
  {
    title: "Print, stretch, frame, all under one roof.",
    body:
      "Same studio, same team. Drop in a file or a canvas and walk out with a finished, ready-to-hang piece in days rather than coordinating across vendors for weeks.",
  },
];

---
<BaseLayout
  title="About us | Fine Art Printing Singapore"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-14 pb-12 md:pt-20 md:pb-16">
      <div class="grid items-start gap-10 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-7">
          <Eyebrow>About us</Eyebrow>
          <h1 class="mt-4 font-serif text-[clamp(2.2rem,5vw,3rem)] font-medium leading-[1.08] text-ink">
            A printing and framing studio in Singapore.
          </h1>
          <p class="mt-6 text-[16px] leading-relaxed text-subtle">
            We are a Singapore based fine art printing studio offering
            high-quality printing, canvas stretching, custom framing, art
            restoration, and professional installation services. We work with
            individuals, businesses, and organisations to produce and present
            everything from personal prints and office displays to large-scale
            projects.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-subtle">
            Our focus is on delivering consistent, high-quality results across a
            wide range of applications. Whether it's a single print for the home
            or a full fit-out for a commercial space, we combine technical
            expertise with a strong understanding of materials to ensure a
            refined, long-lasting finish.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-subtle">
            We are proud to be the first and only studio in Singapore to receive
            Gold Certification from Hahnemühle, reflecting our commitment to
            excellence and adherence to internationally recognised standards in
            fine art printing.
          </p>

          <GoogleReviewsBadge class="mt-6" />
        </div>

        <div class="md:col-span-5 md:sticky md:top-8">
          <div class="aspect-[4/5] overflow-hidden rounded-2xl border border-border-soft bg-stone-100 shadow-sm">
            <img
              src="/photos/hahnemuhle-canvas-artist-1.jpg"
              alt="Canvas print on Hahnemühle Artist Canvas, framed and on display"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What sets us apart -->
  <section class="border-t border-border-soft bg-[#FAF7F1]">
    <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5">
          <Eyebrow>What sets us apart</Eyebrow>
          <DisplayHeading level={2} class="mt-3">
            Four things that show up in every job.
          </DisplayHeading>
          <p class="mt-6 max-w-[420px] font-serif italic text-[18px] leading-relaxed text-subtle">
            Whether it's a single archival print or a full corporate fit-out,
            these are the constants.
          </p>
        </div>

        <ol class="md:col-span-7 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2">
          {differentiators.map((row, i) => (
            <li class="border-t border-ink/10 pt-6">
              <span class="font-serif italic text-[14px] text-[var(--color-gold-text)]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 font-serif text-[20px] font-medium leading-[1.25] text-ink">
                {row.title}
              </h3>
              <p class="mt-3 text-[14.5px] leading-relaxed text-subtle">
                {row.body}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Founder + Canon video -->
  <section class="border-t border-border-soft bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
      <div class="grid gap-12 md:grid-cols-12 md:items-center">
        <div class="md:col-span-5">
          <Eyebrow>The founder</Eyebrow>
          <DisplayHeading level={2} class="mt-3">
            Why we obsess over media and ink.
          </DisplayHeading>
          <p class="mt-6 text-[15.5px] leading-relaxed text-subtle">
            Canon sat down with our founder Ben to talk about printing as a
            craft, the move to the Pro-566, and why the choice of paper and
            ink decides whether a print holds up over decades or fades in a
            few years.
          </p>
          <p class="mt-4 text-[15.5px] leading-relaxed text-subtle">
            If you're considering a piece for your home or office and want to
            understand what you're paying for, this is a good place to start.
          </p>
          <img
            src="/logos/clients/canon.svg"
            alt="Canon"
            width="120"
            height="28"
            class="mt-8 h-7 w-auto opacity-90"
            loading="lazy"
          />
        </div>
        <div class="md:col-span-7">
          <YouTubeEmbed
            videoId={business.youtubeVideoId}
            title="Canon × Fine Art Printing"
          />
        </div>
      </div>
    </div>
  </section>

  <ReviewSection />
  <DarkCTA />
</BaseLayout>
