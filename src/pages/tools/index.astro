---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import DisplayHeading from "../../components/DisplayHeading.astro";
import DarkCTA from "../../components/DarkCTA.astro";

const description =
  "Free browser tools for preparing image files for printing. Check resolution against your target print size, see recommendations, and get clear advice on what to do if your file isn't sharp enough.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Print prep tools",
  url: "https://fineartprinting.com.sg/tools",
};

interface Tool {
  title: string;
  description: string;
  href: string;
  status: "live" | "coming-soon";
  badge?: string;
}

const tools: Tool[] = [
  {
    title: "Image analyser",
    description:
      "Drop in your image to see its pixel dimensions, file size, and how sharp it'll print at the size you want.",
    href: "/tools/image-analyser",
    status: "live",
    badge: "Most used",
  },
];
---
<BaseLayout
  title="Free print prep tools · Fine Art Printing"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-14 pb-12 md:pt-20 md:pb-16">
      <div class="max-w-[820px]">
        <Eyebrow>Tools</Eyebrow>
        <h1 class="mt-4 font-serif text-[clamp(2.2rem,5vw,3rem)] font-medium leading-[1.08] text-ink">
          Free tools<br />for prepping your file.
        </h1>
        <p class="mt-6 max-w-[640px] text-[16px] leading-relaxed text-subtle">
          Hand-built browser tools for the questions we hear most. Everything
          runs in your browser, your files don't leave the page.
        </p>
      </div>
    </div>
  </section>

  <!-- Tools grid -->
  <section class="border-t border-border-soft bg-[#FAF7F1]">
    <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
      <div class="max-w-[640px]">
        <Eyebrow>Available now</Eyebrow>
        <DisplayHeading level={2} class="mt-3">Pick a tool.</DisplayHeading>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t) => (
          <a
            href={t.status === "live" ? t.href : "#"}
            aria-disabled={t.status !== "live"}
            class:list={[
              "group flex h-full flex-col rounded-card border border-border-soft bg-white p-6 transition-shadow",
              t.status === "live" && "hover:shadow-[0_12px_32px_-12px_rgba(0,0,0,0.18)]",
              t.status !== "live" && "pointer-events-none opacity-70",
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <p class="font-serif text-[19px] font-medium text-ink">{t.title}</p>
              {t.badge && (
                <span class="inline-flex shrink-0 items-center rounded-pill bg-petrol/[0.08] px-2.5 py-1 text-[11px] font-semibold text-petrol">
                  {t.badge}
                </span>
              )}
              {t.status === "coming-soon" && (
                <span class="inline-flex shrink-0 items-center rounded-pill bg-black/[0.06] px-2.5 py-1 text-[11px] font-semibold text-muted">
                  Coming soon
                </span>
              )}
            </div>
            <p class="mt-3 text-[14px] leading-relaxed text-subtle">{t.description}</p>
            {t.status === "live" && (
              <span class="mt-6 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-petrol">
                Open the tool
                <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </span>
            )}
          </a>
        ))}
      </div>

      <p class="mt-10 max-w-[640px] text-[14px] leading-relaxed text-subtle">
        More tools on the way. If there's a calculation or check you wish
        existed, <a href="/contact" class="underline-offset-2 hover:text-ink hover:underline">tell us</a> and we'll see if we can build it.
      </p>
    </div>
  </section>

  <DarkCTA />
</BaseLayout>
