---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import DisplayHeading from "../../components/DisplayHeading.astro";
import DarkCTA from "../../components/DarkCTA.astro";
import WhatsAppIcon from "../../components/icons/WhatsAppIcon.astro";
import { business } from "../../data/business";

const description =
  "Free wall planner. Enter your wall dimensions and we'll suggest a combined size for one to four pieces that fills the space well. Includes hanging heights and a to-scale preview.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Wall planner",
  applicationCategory: "DesignApplication",
  operatingSystem: "Any (web browser)",
  url: "https://fineartprinting.com.sg/tools/wall-visualiser",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "SGD",
  },
};

const waLink = `${business.whatsappLink}?text=${encodeURIComponent("Hi Fine Art Printing, I just used the wall planner and would like to discuss prints for my wall.")}`;
---
<BaseLayout
  title="Wall planner · What size print fits my wall · Fine Art Printing"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-12 pb-8 md:pt-16 md:pb-10">
      <p class="text-[12.5px] text-muted">
        <a href="/tools" class="hover:text-ink hover:underline underline-offset-2">Tools</a>
        <span class="px-1.5 text-subtle" aria-hidden="true">›</span>
        <span class="text-ink">Wall planner</span>
      </p>
      <div class="mt-5 max-w-[820px]">
        <Eyebrow>Free tool</Eyebrow>
        <h1 class="mt-4 font-serif text-[clamp(2rem,4.5vw,2.7rem)] font-medium leading-[1.1] text-ink">
          What size fills your wall well?
        </h1>
        <p class="mt-5 max-w-[680px] text-[16px] leading-relaxed text-subtle">
          Enter your wall dimensions, optionally the height of any furniture
          against it, and choose how many pieces you want. We'll suggest a
          combined size that fills the space without overpowering it, plus
          the hanging heights to write on the wall when it's time to install.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pb-16">
      <div class="wall-vis" data-wall-vis>
        <div class="wall-vis__layout">
          <!-- Inputs -->
          <aside class="wall-vis__inputs">
            <p class="wall-vis__group-title">Your wall</p>
            <div class="wall-vis__row">
              <label class="wall-vis__field">
                <span>Height</span>
                <div class="wall-vis__field-input">
                  <input type="number" inputmode="numeric" min="100" max="600" step="1" value="270" data-wall-h />
                  <em>cm</em>
                </div>
              </label>
              <label class="wall-vis__field">
                <span>Width</span>
                <div class="wall-vis__field-input">
                  <input type="number" inputmode="numeric" min="50" max="1500" step="1" value="350" data-wall-w />
                  <em>cm</em>
                </div>
              </label>
            </div>

            <p class="wall-vis__group-title wall-vis__group-title--space">Furniture against the wall <span class="wall-vis__optional">optional</span></p>
            <label class="wall-vis__toggle">
              <input type="checkbox" data-furn-toggle />
              <span>There's something below where the art will go</span>
            </label>
            <div class="wall-vis__row" data-furn-fields hidden>
              <label class="wall-vis__field">
                <span>Furniture height</span>
                <div class="wall-vis__field-input">
                  <input type="number" inputmode="numeric" min="20" max="300" step="1" value="80" data-furn-h />
                  <em>cm</em>
                </div>
              </label>
              <p class="wall-vis__field-hint">
                Sofa back ≈ 75-90 cm · console ≈ 75-95 cm · sideboard ≈ 80-95 cm · headboard varies.
              </p>
            </div>

            <p class="wall-vis__group-title wall-vis__group-title--space">Number of pieces</p>
            <div class="wall-vis__count" role="radiogroup" aria-label="Number of pieces">
              {[1, 2, 3, 4].map((n) => (
                <label class="wall-vis__count-opt">
                  <input type="radio" name="wv-count" value={n} checked={n === 1} data-count />
                  <span>{n}</span>
                </label>
              ))}
            </div>

            <p class="wall-vis__group-title wall-vis__group-title--space">Wall colour</p>
            <div class="wall-vis__colours" role="radiogroup" aria-label="Wall colour">
              <label class="wall-vis__colour" style="--swatch: #ffffff" title="Bright white">
                <input type="radio" name="wv-wall-color" data-bg="#ffffff" data-dark="false" checked />
                <span></span>
              </label>
              <label class="wall-vis__colour" style="--swatch: #f4eee2" title="Warm white">
                <input type="radio" name="wv-wall-color" data-bg="#f4eee2" data-dark="false" />
                <span></span>
              </label>
              <label class="wall-vis__colour" style="--swatch: #d8d4cc" title="Stone">
                <input type="radio" name="wv-wall-color" data-bg="#d8d4cc" data-dark="false" />
                <span></span>
              </label>
              <label class="wall-vis__colour" style="--swatch: #b8c0a8" title="Sage">
                <input type="radio" name="wv-wall-color" data-bg="#b8c0a8" data-dark="false" />
                <span></span>
              </label>
              <label class="wall-vis__colour" style="--swatch: #2c3e50" title="Navy">
                <input type="radio" name="wv-wall-color" data-bg="#2c3e50" data-dark="true" />
                <span></span>
              </label>
              <label class="wall-vis__colour" style="--swatch: #2a2a2a" title="Charcoal">
                <input type="radio" name="wv-wall-color" data-bg="#2a2a2a" data-dark="true" />
                <span></span>
              </label>
            </div>

            <p class="wall-vis__group-title wall-vis__group-title--space">Orientation</p>
            <div class="wall-vis__orient" role="radiogroup" aria-label="Orientation">
              <label>
                <input type="radio" name="wv-orient" value="landscape" checked data-orient />
                <span>Landscape</span>
              </label>
              <label>
                <input type="radio" name="wv-orient" value="portrait" data-orient />
                <span>Portrait</span>
              </label>
              <label>
                <input type="radio" name="wv-orient" value="square" data-orient />
                <span>Square</span>
              </label>
            </div>
            <p class="wall-vis__field-hint" data-orient-hint>
              The shape of each individual piece. The arrangement's shape
              follows from the count.
            </p>

            <details class="wall-vis__advanced">
              <summary>Fine-tune size</summary>
              <div class="wall-vis__advanced-body">
                <label class="wall-vis__field wall-vis__field--full">
                  <span>Wall coverage <em data-coverage-readout>65%</em></span>
                  <input type="range" min="40" max="80" step="1" value="65" data-coverage />
                </label>
                <p class="wall-vis__field-hint">
                  Designers tend to land between 50% and 75% of wall width.
                  Larger reads bolder, smaller leaves more breathing room.
                </p>
              </div>
            </details>
          </aside>

          <!-- Visual + readout -->
          <div class="wall-vis__output">
            <div class="wall-vis__stage" data-stage>
              <svg
                class="wall-vis__svg"
                data-svg
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="xMidYMid meet"
                aria-label="Wall preview to scale"
              ></svg>
            </div>

            <div class="wall-vis__readout">
              <div class="wall-vis__readout-cols">
                <section class="wall-vis__readout-section">
                  <h3>Sizes</h3>
                  <dl>
                    <div>
                      <dt>Each piece</dt>
                      <dd data-each>—</dd>
                    </div>
                    <div>
                      <dt>Arrangement</dt>
                      <dd data-arrangement>—</dd>
                    </div>
                  </dl>
                </section>
                <section class="wall-vis__readout-section">
                  <h3>Hanging heights <span>cm from floor</span></h3>
                  <dl>
                    <div>
                      <dt>Bottom</dt>
                      <dd data-bottom-aff>—</dd>
                    </div>
                    <div>
                      <dt>Centre</dt>
                      <dd data-centre-aff>—</dd>
                    </div>
                    <div>
                      <dt>Top</dt>
                      <dd data-top-aff>—</dd>
                    </div>
                  </dl>
                </section>
              </div>
              <p class="wall-vis__readout-note" data-readout-note></p>
            </div>

            <div class="wall-vis__actions">
              <a
                href={waLink}
                target="_blank"
                rel="noopener"
                class="wall-vis__cta"
              >
                <WhatsAppIcon size={16} />
                <span>Send these sizes to us on WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="border-t border-border-soft bg-[#FAF7F1]">
    <div class="mx-auto max-w-[1180px] px-6 py-16 md:py-20">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <Eyebrow>Rules of thumb</Eyebrow>
          <DisplayHeading level={2} class="mt-3">How designers size art to a wall.</DisplayHeading>
          <p class="mt-5 max-w-[360px] text-[15px] leading-relaxed text-subtle">
            These aren't strict laws, but they're the conventions that make a
            wall look intentional rather than accidental.
          </p>
        </div>
        <ol class="md:col-span-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <li class="rounded-card border border-border-soft bg-white p-5">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-petrol">⅔ rule</p>
            <p class="mt-2 font-serif text-[18px] font-medium text-ink">Two-thirds of the wall.</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-subtle">
              For a single feature piece, aim for about 65 to 75% of the wall
              width. For art above furniture, the same fraction of the
              furniture's width tends to read best.
            </p>
          </li>
          <li class="rounded-card border border-border-soft bg-white p-5">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-petrol">Eye level</p>
            <p class="mt-2 font-serif text-[18px] font-medium text-ink">Centre at 145–155 cm.</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-subtle">
              Galleries hang the centre of a piece at roughly 152 cm above
              the floor. It works because most people's natural sight line
              lands close to that height.
            </p>
          </li>
          <li class="rounded-card border border-border-soft bg-white p-5">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-petrol">Above the sofa</p>
            <p class="mt-2 font-serif text-[18px] font-medium text-ink">15–25 cm gap.</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-subtle">
              Leave a small breathing space between the top of furniture and
              the bottom of the art. Closer reads cramped, farther reads
              disconnected.
            </p>
          </li>
          <li class="rounded-card border border-border-soft bg-white p-5">
            <p class="text-[12px] font-semibold uppercase tracking-wide text-petrol">Multiples</p>
            <p class="mt-2 font-serif text-[18px] font-medium text-ink">5 cm between pieces.</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-subtle">
              When hanging two or more works as a set, treat the whole group
              as one composition and keep gaps around 5 cm. Tighter looks
              modern, wider feels more salon-style.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <DarkCTA />
</BaseLayout>

<style>
  .wall-vis {
    display: grid;
    gap: 24px;
  }

  .wall-vis__layout {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  /* On mobile, show the SVG above the inputs so changes are visible
     while editing. Reverts to inputs-left, output-right on desktop. */
  .wall-vis__output { order: 1; }
  .wall-vis__inputs { order: 2; }
  @media (min-width: 880px) {
    .wall-vis__layout {
      grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
      align-items: start;
    }
    .wall-vis__inputs { order: 1; }
    .wall-vis__output { order: 2; }
  }

  /* Inputs panel */
  .wall-vis__inputs {
    display: grid;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    background: #FAF7F1;
    align-self: start;
  }
  @media (max-width: 640px) {
    .wall-vis__inputs { padding: 16px; gap: 12px; }
  }
  .wall-vis__group-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink);
    margin: 0;
  }
  .wall-vis__group-title--space { margin-top: 4px; }
  .wall-vis__optional {
    margin-left: 8px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 12px;
    color: var(--color-muted);
    text-transform: lowercase;
    letter-spacing: 0;
  }
  .wall-vis__row {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
  }
  .wall-vis__field {
    display: grid;
    gap: 5px;
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .wall-vis__field--full { grid-column: 1 / -1; }
  .wall-vis__field-input {
    position: relative;
    display: flex;
    align-items: center;
  }
  .wall-vis__field-input input[type="number"] {
    width: 100%;
    padding: 10px 38px 10px 12px;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: 8px;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    background: #fff;
    color: var(--color-ink);
    -webkit-appearance: none;
    appearance: none;
  }
  .wall-vis__field-input input:focus {
    outline: 2px solid var(--color-petrol);
    outline-offset: 0;
    border-color: var(--color-petrol);
  }
  .wall-vis__field-input em {
    position: absolute;
    right: 12px;
    font-style: normal;
    font-size: 12px;
    color: var(--color-muted);
    pointer-events: none;
  }
  .wall-vis__field-hint {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--color-subtle);
    line-height: 1.5;
  }
  .wall-vis__toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    font-size: 13.5px;
    color: var(--color-ink);
    user-select: none;
  }
  .wall-vis__toggle input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-petrol);
  }

  .wall-vis__count {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .wall-vis__count-opt { cursor: pointer; }
  .wall-vis__count-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .wall-vis__count-opt span {
    display: block;
    padding: 11px 0;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    background: #fff;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    transition: background 120ms, border-color 120ms, color 120ms;
  }
  .wall-vis__count-opt:hover span { border-color: rgba(0, 0, 0, 0.3); }
  .wall-vis__count-opt input:checked + span {
    background: var(--color-selected);
    border-color: var(--color-selected);
    color: #fff;
  }

  .wall-vis__colours {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .wall-vis__colour { cursor: pointer; }
  .wall-vis__colour input { position: absolute; opacity: 0; pointer-events: none; }
  .wall-vis__colour span {
    display: block;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--swatch);
    border: 1px solid rgba(0, 0, 0, 0.18);
    transition: transform 120ms ease-out;
  }
  .wall-vis__colour:hover span { transform: scale(1.07); }
  .wall-vis__colour input:checked + span {
    outline: 2px solid var(--color-petrol);
    outline-offset: 2px;
  }

  .wall-vis__orient {
    display: inline-flex;
    justify-self: start;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: 999px;
    padding: 3px;
    background: #fff;
  }
  .wall-vis__orient label { cursor: pointer; }
  .wall-vis__orient input { position: absolute; opacity: 0; pointer-events: none; }
  .wall-vis__orient span {
    display: inline-block;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .wall-vis__orient label:has(input:checked) span {
    background: var(--color-selected);
    color: #fff;
  }

  .wall-vis__advanced {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
  }
  .wall-vis__advanced summary {
    cursor: pointer;
    list-style: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-petrol);
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .wall-vis__advanced summary::-webkit-details-marker { display: none; }
  .wall-vis__advanced summary::after {
    content: "▾";
    font-size: 10px;
    color: var(--color-muted);
    transition: transform 120ms ease-out;
  }
  .wall-vis__advanced[open] summary::after { transform: rotate(180deg); }
  .wall-vis__advanced-body { padding-top: 12px; display: grid; gap: 8px; }
  .wall-vis__advanced-body input[type="range"] {
    width: 100%;
    accent-color: var(--color-petrol);
  }
  .wall-vis__advanced-body em {
    font-style: normal;
    color: var(--color-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Output */
  .wall-vis__output {
    display: grid;
    gap: 18px;
  }
  .wall-vis__stage {
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .wall-vis__stage { padding: 14px; border-radius: 12px; }
  }
  .wall-vis__svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
  }

  .wall-vis__readout {
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 14px;
    padding: 18px 20px;
    background: #FAF7F1;
  }
  .wall-vis__readout-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .wall-vis__readout-cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 28px;
    }
  }
  .wall-vis__readout-section h3 {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .wall-vis__readout-section h3 span {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    font-size: 11px;
    color: var(--color-subtle);
  }
  .wall-vis__readout-section dl {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .wall-vis__readout-section dl > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .wall-vis__readout-section dt {
    font-size: 13px;
    color: var(--color-subtle);
  }
  .wall-vis__readout-section dd {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .wall-vis__readout-note {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    font-size: 12.5px;
    color: var(--color-subtle);
    line-height: 1.55;
  }

  .wall-vis__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .wall-vis__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    background: #25D366;
    color: #fff;
    transition: background 150ms ease-out;
  }
  .wall-vis__cta:hover { background: #1ebe5b; }
  @media (max-width: 640px) {
    .wall-vis__cta { flex: 1 1 auto; justify-content: center; }
  }
</style>

<script>
  import { attachDecimalSnap } from "../../lib/decimal-input";

  // Wall planner. Pure browser-side: take wall + furniture inputs,
  // compute a recommended combined size for N pieces, render an SVG
  // wall preview to scale.

  type Orient = "landscape" | "portrait" | "square";

  // Per-piece W/H aspect. Each piece's shape is fixed by the
  // orientation; the combined footprint emerges from the count + layout.
  // This is the natural model: "portrait" produces actual portrait
  // pieces regardless of count, and a triptych of portraits is a row of
  // three portrait pieces, not three thin strips inside a portrait box.
  const PIECE_ASPECT: Record<Orient, number> = {
    landscape: 1.5,   // 3:2
    portrait: 0.75,   // 4:5 ≈ 3:4
    square: 1,
  };

  const SPACING_CM = 5;        // gap between pieces in a row
  const FURN_GAP_CM = 20;      // gap between top of furniture and bottom of art
  const CEILING_GAP_CM = 25;   // minimum margin from top of art to ceiling
  const EYE_LEVEL_CM = 152;    // centre of art on an empty wall
  const SIDE_GAP_MIN_CM = 15;  // visual breathing space on the long edges

  const root = document.querySelector<HTMLElement>("[data-wall-vis]");
  if (root) initWallVis(root);

  function initWallVis(root: HTMLElement) {
    const wallW = root.querySelector<HTMLInputElement>("[data-wall-w]")!;
    const wallH = root.querySelector<HTMLInputElement>("[data-wall-h]")!;
    const furnToggle = root.querySelector<HTMLInputElement>("[data-furn-toggle]")!;
    const furnFields = root.querySelector<HTMLElement>("[data-furn-fields]")!;
    const furnH = root.querySelector<HTMLInputElement>("[data-furn-h]")!;
    const countInputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-count]"));
    const orientInputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-orient]"));
    const colourInputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-bg]"));
    const coverage = root.querySelector<HTMLInputElement>("[data-coverage]")!;
    const coverageReadout = root.querySelector<HTMLElement>("[data-coverage-readout]")!;
    const svg = root.querySelector<SVGSVGElement>("[data-svg]")!;
    const eachEl = root.querySelector<HTMLElement>("[data-each]")!;
    const arrangementEl = root.querySelector<HTMLElement>("[data-arrangement]")!;
    const centreEl = root.querySelector<HTMLElement>("[data-centre-aff]")!;
    const bottomEl = root.querySelector<HTMLElement>("[data-bottom-aff]")!;
    const topEl = root.querySelector<HTMLElement>("[data-top-aff]")!;
    const noteEl = root.querySelector<HTMLElement>("[data-readout-note]")!;

    function selectedCount(): number {
      const sel = countInputs.find((i) => i.checked);
      return parseInt(sel?.value ?? "1", 10);
    }
    function selectedOrient(): Orient {
      const sel = orientInputs.find((i) => i.checked);
      return (sel?.value as Orient) ?? "landscape";
    }
    function selectedWallColour(): { bg: string; dark: boolean } {
      const sel = colourInputs.find((i) => i.checked);
      return {
        bg: sel?.dataset.bg ?? "#ffffff",
        dark: (sel?.dataset.dark ?? "false") === "true",
      };
    }

    /** Round to nearest 5 cm, produces realistic "you can actually buy
     *  this print" sizes rather than 47.3 × 35.5. */
    function r5(v: number): number {
      return Math.max(5, Math.round(v / 5) * 5);
    }

    /** Pick a layout (cols × rows) per count. 4 pieces = 2×2 grid;
     *  2 or 3 pieces sit in a row regardless of orientation. */
    function layoutFor(count: number): { cols: number; rows: number } {
      if (count === 4) return { cols: 2, rows: 2 };
      return { cols: count, rows: 1 };
    }

    function compute() {
      const ww = parseFloat(wallW.value) || 0;
      const wh = parseFloat(wallH.value) || 0;
      const hasFurn = furnToggle.checked;
      const fh = hasFurn ? parseFloat(furnH.value) || 0 : 0;
      const count = selectedCount();
      const orient = selectedOrient();
      const cov = parseFloat(coverage.value) / 100;
      const aspect = PIECE_ASPECT[orient]; // W / H per piece
      const { cols, rows } = layoutFor(count);

      if (ww <= 0 || wh <= 0) return null;

      // Available envelope. The art's bottom edge can't sit below the
      // top of furniture (+ breathing gap) or below 75 cm AFF on empty
      // walls; the top edge can't go past wall_height - ceiling gap.
      const ceilingY = wh - CEILING_GAP_CM;
      const minBottomAff = hasFurn && fh > 0 ? fh + FURN_GAP_CM : 75;
      const availableH = Math.max(0, ceilingY - minBottomAff);
      const maxComboW = ww - 2 * SIDE_GAP_MIN_CM;

      // Target combo *area* (not just width). This is the fix for
      // multi-piece arrangements: dividing a width-only target into N
      // columns made each piece short, leaving most of the wall empty
      // above the art. Solving for piece dimensions from area means a
      // 3-piece arrangement scales up to fill the available wall
      // similarly to a 1-piece arrangement.
      const availArea = maxComboW * availableH;
      const targetArea = availArea * cov;

      const spacingX = SPACING_CM * (cols - 1);
      const spacingY = SPACING_CM * (rows - 1);

      // Approximate pieceH ignoring spacing (small relative to pieces).
      // combo_area ≈ (cols × aspect × pieceH) × (rows × pieceH)
      //           = cols × rows × aspect × pieceH²
      let pieceH = Math.sqrt(targetArea / (cols * rows * aspect));
      let pieceW = pieceH * aspect;
      let comboW = pieceW * cols + spacingX;
      let comboH = pieceH * rows + spacingY;

      // Cap to wall envelope. Cap whichever dimension is overshooting,
      // shrinking proportionally to keep the per-piece aspect honest.
      if (comboW > maxComboW) {
        const scale = maxComboW / comboW;
        pieceW *= scale;
        pieceH = pieceW / aspect;
        comboW = pieceW * cols + spacingX;
        comboH = pieceH * rows + spacingY;
      }
      if (comboH > availableH && availableH > 0) {
        const scale = availableH / comboH;
        pieceH *= scale;
        pieceW = pieceH * aspect;
        comboW = pieceW * cols + spacingX;
        comboH = pieceH * rows + spacingY;
      }

      // Vertical placement. With furniture, anchor ≥ furniture-top + gap;
      // if the combo is small (e.g. 3 landscape pieces in a row), lift
      // it so the centre sits at eye level rather than hugging the
      // sofa with empty wall above.
      let bottomAff: number;
      if (hasFurn && fh > 0) {
        const eyeBottom = EYE_LEVEL_CM - comboH / 2;
        bottomAff = Math.max(fh + FURN_GAP_CM, eyeBottom);
      } else {
        bottomAff = EYE_LEVEL_CM - comboH / 2;
        bottomAff = Math.max(bottomAff, 75);
      }
      // Don't punch through the ceiling.
      if (bottomAff + comboH > ceilingY) bottomAff = ceilingY - comboH;

      // Round per-piece to nearest 5 cm; combo follows.
      const pieceWR = r5(pieceW);
      const pieceHR = r5(pieceH);
      const comboWR = pieceWR * cols + spacingX;
      const comboHR = pieceHR * rows + spacingY;
      const bottomAffR = Math.round(bottomAff);
      const centreAffR = Math.round(bottomAffR + comboHR / 2);

      return {
        ww,
        wh,
        fh,
        hasFurn,
        count,
        orient,
        cols,
        rows,
        pieceW: pieceWR,
        pieceH: pieceHR,
        comboW: comboWR,
        comboH: comboHR,
        bottomAff: bottomAffR,
        centreAff: centreAffR,
        topAff: bottomAffR + comboHR,
        spacing: SPACING_CM,
      };
    }

    function renderSVG(r: ReturnType<typeof compute>) {
      if (!r) return;
      const { ww, wh, fh, hasFurn, cols, rows, pieceW, pieceH, comboW, comboH, bottomAff, spacing } = r;
      // Pad the viewBox a bit so labels at the edges don't get clipped.
      const padX = ww * 0.04;
      const padY = wh * 0.04;
      const vbW = ww + padX * 2;
      const vbH = wh + padY * 2 + 14; // extra room for floor label
      svg.setAttribute("viewBox", `0 0 ${vbW} ${vbH}`);

      const wallX = padX;
      const wallY = padY;

      // Convert AFF (above floor) to SVG Y (top-down).
      const yFromAff = (aff: number) => wallY + (wh - aff);

      const wall = selectedWallColour();
      const onDark = wall.dark;

      const pieces: string[] = [];
      const startX = wallX + (ww - comboW) / 2;
      const topY = yFromAff(bottomAff + comboH);
      const pieceStroke = onDark ? "#fff" : "#1a1a1a";
      const pieceStrokeWidth = onDark ? 0.6 : 1;
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const x = startX + col * (pieceW + spacing);
          const y = topY + row * (pieceH + spacing);
          pieces.push(
            `<rect x="${x}" y="${y}" width="${pieceW}" height="${pieceH}" fill="#fff" stroke="${pieceStroke}" stroke-width="${pieceStrokeWidth}" rx="0.6" />`
          );
        }
      }

      const furniture = hasFurn && fh > 0
        ? `<rect x="${wallX}" y="${yFromAff(fh)}" width="${ww}" height="${fh}" fill="${onDark ? "#5a4a38" : "#cdb89a"}" opacity="${onDark ? 0.85 : 0.6}" />`
        : "";

      // Floor line.
      const floorY = yFromAff(0);

      // Wall background. Outer stroke is a touch darker so a white wall
      // remains distinguishable from the white stage card.
      const bg = `<rect x="${wallX}" y="${wallY}" width="${ww}" height="${wh}" fill="${wall.bg}" stroke="rgba(0,0,0,0.28)" stroke-width="0.6" />`;
      const floorLine = `<line x1="${wallX - padX * 0.4}" y1="${floorY}" x2="${wallX + ww + padX * 0.4}" y2="${floorY}" stroke="#1a1a1a" stroke-width="1" />`;
      const floorHatch = `<line x1="${wallX - padX * 0.4}" y1="${floorY + 4}" x2="${wallX + ww + padX * 0.4}" y2="${floorY + 4}" stroke="rgba(0,0,0,0.4)" stroke-width="0.4" stroke-dasharray="3 3" />`;

      // Reference person silhouette (1.7 m tall) on the right side of
      // the wall to give a sense of human scale. Skip if the wall is
      // very narrow (<200 cm) since it eats space.
      const personHeight = 170;
      const showPerson = ww >= 200;
      const person = showPerson
        ? (() => {
            const px = wallX + ww + padX * 0.05;
            const py = floorY - personHeight;
            const headR = 11;
            const bodyW = 22;
            const bodyH = personHeight - headR * 2 - 2;
            return (
              `<g opacity="0.35">
                <circle cx="${px + bodyW / 2}" cy="${py + headR}" r="${headR}" fill="#1a1a1a" />
                <rect x="${px}" y="${py + headR * 2}" width="${bodyW}" height="${bodyH}" rx="6" fill="#1a1a1a" />
              </g>`
            );
          })()
        : "";

      // Hanging line at centre of art (subtle, light on dark walls).
      const centreLineStroke = onDark
        ? "rgba(255,255,255,0.35)"
        : "rgba(26,53,80,0.25)";
      const centreLine = `<line x1="${wallX}" y1="${yFromAff(r.centreAff)}" x2="${wallX + ww}" y2="${yFromAff(r.centreAff)}" stroke="${centreLineStroke}" stroke-width="0.6" stroke-dasharray="6 6" />`;

      // Labels, keep these minimal so the visual stays calm.
      const labelStyle = `font-family: var(--font-sans, sans-serif); font-size: 12px; fill: rgba(0,0,0,0.55);`;
      const floorLabel = `<text x="${wallX + ww / 2}" y="${floorY + 13}" text-anchor="middle" style="${labelStyle}">Floor</text>`;

      svg.innerHTML = `${bg}${furniture}${centreLine}${pieces.join("")}${floorLine}${floorHatch}${person}${floorLabel}`;
    }

    function renderReadout(r: ReturnType<typeof compute>) {
      if (!r) {
        eachEl.textContent = "—";
        arrangementEl.textContent = "—";
        centreEl.textContent = "—";
        bottomEl.textContent = "—";
        topEl.textContent = "—";
        noteEl.textContent = "Enter your wall width and height to see a recommendation.";
        return;
      }
      eachEl.textContent = `${r.pieceW} × ${r.pieceH} cm`;
      const layoutLabel = r.count === 1
        ? "single piece"
        : r.rows > 1
          ? `${r.cols}×${r.rows} grid`
          : `${r.count} in a row`;
      arrangementEl.innerHTML = r.count === 1
        ? `${r.comboW} × ${r.comboH} cm`
        : `${r.comboW} × ${r.comboH} cm <small style="display:block;font-size:12px;color:var(--color-subtle);font-family:var(--font-sans);font-weight:400;margin-top:2px;">${layoutLabel} · ${r.spacing} cm gaps</small>`;
      bottomEl.textContent = `${r.bottomAff} cm`;
      centreEl.textContent = `${r.centreAff} cm`;
      topEl.textContent = `${r.topAff} cm`;

      const cov = Math.round((r.comboW / r.ww) * 100);
      const noteParts: string[] = [`Covers ${cov}% of the wall width.`];
      if (r.hasFurn && r.fh > 0 && r.bottomAff === r.fh + FURN_GAP_CM) {
        noteParts.push(`Bottom sits ${FURN_GAP_CM} cm above the furniture.`);
      } else if (!r.hasFurn) {
        noteParts.push(`Centred near ${EYE_LEVEL_CM} cm, gallery eye-level.`);
      } else {
        noteParts.push(`Lifted to centre near eye level.`);
      }
      noteEl.textContent = noteParts.join(" ");
    }

    function update() {
      coverageReadout.textContent = `${coverage.value}%`;
      const r = compute();
      renderSVG(r);
      renderReadout(r);
    }

    // Wire up.
    [wallW, wallH, furnH].forEach((el) =>
      attachDecimalSnap(el, { step: 1, onChange: update }),
    );
    [wallW, wallH, furnH, coverage].forEach((el) =>
      el.addEventListener("input", update),
    );
    [...countInputs, ...orientInputs, ...colourInputs].forEach((el) =>
      el.addEventListener("change", update),
    );
    furnToggle.addEventListener("change", () => {
      furnFields.hidden = !furnToggle.checked;
      update();
    });

    update();
  }
</script>
