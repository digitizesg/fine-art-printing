---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import DarkCTA from "../../components/DarkCTA.astro";
import FrameLightbox from "../../components/FrameLightbox.astro";
import { listArtworks, getArtworkBySlug } from "../../lib/artworks";
import "../../styles/canvas-quote.css";
import { PAPERS } from "../../data/pricing/paper";
import { CANVASES, FLOAT_FRAME_COLOURS } from "../../data/pricing/canvas";

export async function getStaticPaths() {
  const artworks = await listArtworks({ onlyPublished: true });
  return artworks.map((art) => ({
    params: { slug: art.slug },
    props: { artwork: art },
  }));
}

const { artwork } = Astro.props;

const featuredPapers = PAPERS.filter((p) => p.featured);
const featuredCanvases = CANVASES.filter((c) => c.featured);

const description =
  artwork.description ?? `${artwork.title}${artwork.artistName ? ` by ${artwork.artistName}` : ""} — printed to order on archival paper or canvas at Fine Art Printing.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: artwork.title,
  image: artwork.heroImageUrl,
  description,
  brand: { "@type": "Brand", name: "Fine Art Printing" },
};

---
<BaseLayout
  title={`${artwork.title} · Fine Art Printing`}
  description={description}
  jsonLd={jsonLd}
  type="article"
>
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-10 pb-16 md:pt-14 md:pb-20">
      <p class="text-[13px] text-muted">
        <a href="/shop" class="hover:text-ink hover:underline underline-offset-2">Shop</a>
        <span class="px-1.5 text-subtle" aria-hidden="true">›</span>
        <span class="text-ink">{artwork.title}</span>
      </p>

      <div class="mt-6 grid gap-12 md:grid-cols-2 md:gap-16">
        <!-- Image + gallery -->
        <div class="md:sticky md:top-6 self-start">
          <figure>
            <img
              src={artwork.heroImageUrl}
              alt={artwork.title}
              data-frame-zoom
              data-frame-image={artwork.heroImageUrl}
              data-frame-name={artwork.title}
              class="w-full rounded-card object-contain bg-[#f4efe7] shadow-[0_24px_60px_-24px_rgba(0,0,0,0.30)] cursor-zoom-in"
            />
          </figure>
          {artwork.galleryImages.length > 0 && (
            <div class="mt-4 grid grid-cols-4 gap-2">
              {artwork.galleryImages.map((img, i) => (
                <button
                  type="button"
                  class="aspect-square overflow-hidden rounded-md bg-[#f4efe7] border border-border-soft cursor-zoom-in transition-shadow hover:shadow-md focus:outline focus:outline-2 focus:outline-petrol focus:outline-offset-2"
                  data-frame-zoom
                  data-frame-image={img.url}
                  data-frame-name={`${artwork.title} — view ${i + 2}`}
                  aria-label={`Open larger view ${i + 2}`}
                >
                  <img src={img.url} alt="" loading="lazy" class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Detail + configurator -->
        <div>
          <Eyebrow>Original artwork</Eyebrow>
          <h1 class="mt-3 font-serif text-[clamp(1.85rem,3.5vw,2.4rem)] font-medium leading-[1.1] text-ink">
            {artwork.title}
          </h1>
          {artwork.artistName && (
            <p class="mt-2 text-[14px] text-muted">by {artwork.artistName}</p>
          )}

          {artwork.description && (
            <p class="mt-6 text-[15.5px] leading-relaxed text-subtle">
              {artwork.description}
            </p>
          )}

          <!-- Configurator -->
          <div class="artwork-config" data-artwork-config data-artwork-id={artwork.id}>
            <fieldset class="artwork-config__group">
              <legend>Substrate</legend>
              <div class="artwork-config__chips" role="radiogroup" aria-label="Substrate">
                {artwork.allowPaper && (
                  <label class="artwork-config__chip">
                    <input type="radio" name="substrate" value="paper" checked />
                    <span>Paper</span>
                  </label>
                )}
                {artwork.allowCanvas && (
                  <label class="artwork-config__chip">
                    <input type="radio" name="substrate" value="canvas" checked={!artwork.allowPaper} />
                    <span>Canvas</span>
                  </label>
                )}
              </div>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="paper">
              <legend>Paper</legend>
              <select name="paper_id" class="artwork-config__select">
                {featuredPapers.map((p) => (
                  <option value={p.id}>{p.brand} {p.shortName}</option>
                ))}
              </select>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="paper">
              <legend>White border</legend>
              <div class="artwork-config__border">
                <input
                  type="number"
                  name="border_cm"
                  min="0"
                  max="10"
                  step="0.5"
                  value="0"
                  class="artwork-config__border-input"
                />
                <span class="artwork-config__border-suffix">cm on all sides</span>
              </div>
              <p class="artwork-config__hint">
                Optional white margin around the image. The image size stays the same; the paper printed gets larger by twice the border on each axis, and the price reflects that.
              </p>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="canvas">
              <legend>Canvas</legend>
              <select name="canvas_id" class="artwork-config__select">
                {featuredCanvases.map((c) => (
                  <option value={c.id}>{c.brand} {c.shortName}</option>
                ))}
              </select>
            </fieldset>

            <fieldset class="artwork-config__group">
              <legend>Size</legend>
              {artwork.availableSizes.length === 0 ? (
                <p class="artwork-config__hint">No sizes configured for this artwork yet — message us for a custom size.</p>
              ) : (
                <div class="artwork-config__chips" role="radiogroup" aria-label="Size">
                  {artwork.availableSizes.map((size, i) => (
                    <label class="artwork-config__chip">
                      <input type="radio" name="size" value={`${size.width_cm}x${size.height_cm}`} checked={i === 0} />
                      <span>
                        {size.label && <strong>{size.label}</strong>}
                        {size.width_cm} × {size.height_cm} cm
                      </span>
                    </label>
                  ))}
                </div>
              )}
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="canvas">
              <legend>Finishing</legend>
              <div class="finishing-grid" role="radiogroup" aria-label="Finishing">
                <label class="finishing-card">
                  <input type="radio" name="finishing" value="none" checked />
                  <span class="finishing-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 40 28" width="40" height="28" fill="none">
                      <rect x="2.5" y="6" width="35" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </span>
                  <span class="finishing-card__body">
                    <span class="finishing-card__title">No stretching</span>
                    <span class="finishing-card__desc">Rolled, ready for your own framer.</span>
                  </span>
                </label>
                <label class="finishing-card">
                  <input type="radio" name="finishing" value="1in" />
                  <span class="finishing-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 40 28" width="40" height="28" fill="none">
                      <rect x="3" y="4" width="34" height="14" rx="1" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="3" y="18" width="34" height="4" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </span>
                  <span class="finishing-card__body">
                    <span class="finishing-card__title">Standard 1"</span>
                    <span class="finishing-card__desc">Solid wood, gallery-wrapped.</span>
                  </span>
                </label>
                <label class="finishing-card">
                  <input type="radio" name="finishing" value="1.5in" />
                  <span class="finishing-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 40 28" width="40" height="28" fill="none">
                      <rect x="3" y="3" width="34" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="3" y="16" width="34" height="7" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </span>
                  <span class="finishing-card__body">
                    <span class="finishing-card__title">Deep 1.5"</span>
                    <span class="finishing-card__desc">Deeper bars, more substantial profile.</span>
                  </span>
                </label>
                <label class="finishing-card">
                  <input type="radio" name="finishing" value="float" />
                  <span class="finishing-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 40 28" width="40" height="28" fill="none">
                      <rect x="1.5" y="3" width="37" height="22" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="6" y="6.5" width="28" height="15" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </span>
                  <span class="finishing-card__body">
                    <span class="finishing-card__title">Float frame</span>
                    <span class="finishing-card__desc">Stretched on 1" bars, then mounted in a wooden frame.</span>
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="canvas" data-only-when-float>
              <legend>Float frame colour</legend>
              <select name="float_frame" class="artwork-config__select">
                {FLOAT_FRAME_COLOURS.map((f, i) => (
                  <option value={f.id} selected={i === 0}>{f.label}</option>
                ))}
              </select>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="canvas" data-only-when-rolled>
              <legend>Add extra margin for future stretching?</legend>
              <div class="artwork-config__chips" role="radiogroup" aria-label="Future stretching margin">
                <label class="artwork-config__chip">
                  <input type="radio" name="future_margin" value="no" checked />
                  <span>No, ship rolled as-is</span>
                </label>
                <label class="artwork-config__chip">
                  <input type="radio" name="future_margin" value="yes" />
                  <span>Yes, add 1.5" all around</span>
                </label>
              </div>
              <p class="artwork-config__hint">
                Adds 1.5" of extra canvas around your image so a framer can stretch it later. Adjusts the printed canvas size and the price.
              </p>
            </fieldset>

            <fieldset class="artwork-config__group" data-substrate="canvas" data-only-when-margin>
              <legend>Wrap style</legend>
              <div class="artwork-config__chips" role="radiogroup" aria-label="Wrap style">
                <label class="artwork-config__chip">
                  <input type="radio" name="wrap_type" value="mirror" checked />
                  <span>Mirror</span>
                </label>
                <label class="artwork-config__chip">
                  <input type="radio" name="wrap_type" value="gallery" />
                  <span>Gallery</span>
                </label>
                <label class="artwork-config__chip">
                  <input type="radio" name="wrap_type" value="colour" />
                  <span>Solid colour</span>
                </label>
              </div>
              <details class="artwork-config__help">
                <summary>What's the difference?</summary>
                <div class="artwork-config__help-body">
                  <p><strong>Mirror</strong> — the edges of the image are mirrored onto the wrap, so the design continues smoothly around the sides.</p>
                  <p><strong>Gallery</strong> — the image itself wraps around the sides, so part of the picture is visible on the side faces.</p>
                  <p><strong>Solid colour</strong> — the wrap is filled with a flat colour you choose (typically black or white). We'll confirm the colour with you before printing.</p>
                </div>
              </details>
            </fieldset>

            <div class="artwork-config__price" data-artwork-price>
              <span class="artwork-config__price-label">Estimated price</span>
              <span class="artwork-config__price-amount" data-artwork-price-amount>—</span>
              <p class="artwork-config__hint" data-artwork-price-note></p>
            </div>

            <button type="button" class="artwork-config__cta" data-artwork-add-to-cart disabled>
              Add to cart (coming soon)
            </button>

            <p class="artwork-config__small">
              Pricing excludes delivery. Self-collection from our studio is free; local Singapore delivery is S$30. The cart and payment flow ship in the next phase.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <DarkCTA />
  <FrameLightbox />
</BaseLayout>

<style is:global>
  .artwork-config {
    margin-top: 32px;
    display: grid;
    gap: 22px;
  }
  .artwork-config__group {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .artwork-config__group legend {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink);
    margin: 0 0 4px;
  }
  .artwork-config__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .artwork-config__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.10));
    border-radius: 999px;
    cursor: pointer;
    font-size: 13.5px;
    color: var(--color-ink);
    transition: border-color 150ms ease-out, background 150ms ease-out;
    background: #fff;
  }
  .artwork-config__chip:hover {
    border-color: rgba(0, 0, 0, 0.22);
  }
  .artwork-config__chip:has(input:checked) {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.04);
  }
  .artwork-config__chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .artwork-config__chip strong {
    font-weight: 600;
    margin-right: 4px;
  }
  .artwork-config__select {
    padding: 11px 40px 11px 14px;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: 8px;
    font-size: 15px;
    background-color: #fff;
    color: var(--color-ink);
    width: 100%;
    max-width: 380px;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 14 14' fill='none'%3E%3Cpath d='M3 5l4 4 4-4' stroke='%231a3550' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 14px;
  }
  .artwork-config__select:focus {
    outline: 2px solid var(--color-petrol);
    outline-offset: 0;
    border-color: var(--color-petrol);
  }
  .artwork-config__hint {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-subtle);
  }
  .artwork-config__border {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .artwork-config__border-input {
    padding: 10px 12px;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: 8px;
    font-size: 15px;
    background: #fff;
    color: var(--color-ink);
    width: 110px;
    font-variant-numeric: tabular-nums;
    -webkit-appearance: none;
    appearance: none;
  }
  .artwork-config__border-input:focus {
    outline: 2px solid var(--color-petrol);
    outline-offset: 0;
    border-color: var(--color-petrol);
  }
  .artwork-config__border-suffix {
    font-size: 13px;
    color: var(--color-subtle);
  }
  .artwork-config__help {
    margin-top: 4px;
  }
  .artwork-config__help summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-petrol);
    background: #fff;
    user-select: none;
  }
  .artwork-config__help summary::-webkit-details-marker {
    display: none;
  }
  .artwork-config__help summary::before {
    content: "?";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-petrol);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .artwork-config__help summary:hover {
    background: rgba(26, 53, 80, 0.04);
  }
  .artwork-config__help[open] summary::before {
    content: "✕";
    font-size: 10px;
  }
  .artwork-config__help-body {
    margin-top: 10px;
    padding: 14px 16px;
    background: #FAF7F1;
    border-radius: 10px;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
  }
  .artwork-config__help-body p {
    margin: 0 0 8px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-subtle);
  }
  .artwork-config__help-body p:last-child {
    margin-bottom: 0;
  }
  .artwork-config__help-body strong {
    color: var(--color-ink);
  }
  .artwork-config__price {
    border-top: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    padding-top: 18px;
    display: grid;
    gap: 4px;
  }
  .artwork-config__price-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .artwork-config__price-amount {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 500;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .artwork-config__cta {
    appearance: none;
    border: 0;
    background: var(--color-petrol);
    color: #fff;
    border-radius: 999px;
    padding: 14px 22px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 6px;
    transition: background 150ms ease-out;
  }
  .artwork-config__cta:hover:not(:disabled) {
    background: #142a40;
  }
  .artwork-config__cta:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .artwork-config__small {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--color-subtle);
    line-height: 1.5;
  }
</style>

<script>
  import { quotePaperPrint } from "../../data/pricing/paper";
  import { quoteCanvasPrint, type StretchingChoice } from "../../data/pricing/canvas";

  const root = document.querySelector<HTMLElement>("[data-artwork-config]");
  if (root) initConfigurator(root);

  function initConfigurator(root: HTMLElement) {
    const priceEl = root.querySelector<HTMLElement>("[data-artwork-price-amount]")!;
    const noteEl = root.querySelector<HTMLElement>("[data-artwork-price-note]")!;
    const groups = root.querySelectorAll<HTMLElement>("[data-substrate]");

    function getRadio(name: string): string | null {
      const el = root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      return el ? el.value : null;
    }
    function getValue(name: string): string {
      const el = root.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
      if (!el) return "";
      if ((el as HTMLInputElement).type === "radio") return getRadio(name) ?? "";
      return (el as HTMLSelectElement).value;
    }

    function syncSubstrate() {
      const substrate = getRadio("substrate") ?? "paper";
      const finishing = getRadio("finishing") ?? "none";
      const futureMargin = getRadio("future_margin") ?? "no";
      groups.forEach((g) => {
        const onlySubstrate = g.dataset.substrate;
        const rolledOnly = g.hasAttribute("data-only-when-rolled");
        const marginOnly = g.hasAttribute("data-only-when-margin");
        const floatOnly = g.hasAttribute("data-only-when-float");
        let visible = onlySubstrate ? onlySubstrate === substrate : true;
        if (visible && rolledOnly) visible = finishing === "none";
        if (visible && marginOnly) visible = finishing === "none" && futureMargin === "yes";
        if (visible && floatOnly) visible = finishing === "float";
        g.style.display = visible ? "" : "none";
      });
    }

    function update() {
      syncSubstrate();
      const substrate = getRadio("substrate") ?? "paper";
      const sizeStr = getRadio("size");
      if (!sizeStr) {
        priceEl.textContent = "—";
        noteEl.textContent = "Pick a size to see the price.";
        return;
      }
      const [wStr, hStr] = sizeStr.split("x");
      const w = parseFloat(wStr ?? "");
      const h = parseFloat(hStr ?? "");
      if (!Number.isFinite(w) || !Number.isFinite(h)) {
        priceEl.textContent = "—";
        noteEl.textContent = "";
        return;
      }

      if (substrate === "paper") {
        const paperId = getValue("paper_id");
        const border = Math.max(0, parseFloat(getValue("border_cm") || "0") || 0);
        const result = quotePaperPrint({
          paperId,
          widthCm: w + border * 2,
          heightCm: h + border * 2,
          quantity: 1,
        });
        if (!result.ok) {
          priceEl.textContent = "—";
          noteEl.textContent = result.message;
          return;
        }
        priceEl.textContent = `S$${result.grandTotal.toLocaleString("en-SG")}`;
        noteEl.textContent = border > 0
          ? `Includes ${border} cm border — paper printed at ${w + border * 2} × ${h + border * 2} cm.`
          : "";
      } else {
        const canvasId = getValue("canvas_id");
        const finishing = getRadio("finishing") ?? "none";
        const futureMargin = (getRadio("future_margin") ?? "no") === "yes";

        let stretching: StretchingChoice = "none";
        let floatFrameColourId: string | null = null;
        if (finishing === "1in") stretching = "1in";
        else if (finishing === "1.5in") stretching = "1.5in";
        else if (finishing === "float") {
          stretching = "1in";
          floatFrameColourId = getValue("float_frame") || null;
        }

        // 1.5" = 3.81cm. Only relevant when finishing is "none" and the
        // customer asks for future-stretching margin. The engine doesn't
        // know about this, so we add it to the input dimensions.
        const marginCm = finishing === "none" && futureMargin ? 3.81 : 0;

        const result = quoteCanvasPrint({
          canvasId,
          widthCm: w + marginCm * 2,
          heightCm: h + marginCm * 2,
          stretching,
          floatFrameColourId,
          delivery: "self",
        });
        if (!result.ok) {
          priceEl.textContent = "—";
          noteEl.textContent = result.message;
          return;
        }
        priceEl.textContent = `S$${result.grandTotal.toLocaleString("en-SG")}`;
        if (marginCm > 0) {
          const effW = (w + marginCm * 2).toFixed(1);
          const effH = (h + marginCm * 2).toFixed(1);
          noteEl.textContent = `Includes 1.5" stretching margin — canvas printed at ${effW} × ${effH} cm.`;
        } else {
          noteEl.textContent = "";
        }
      }
    }

    root.addEventListener("change", update);
    root.addEventListener("input", update);
    update();
  }
</script>
