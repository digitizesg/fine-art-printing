---
export const prerender = false;
import { createSupabaseServerClient } from "../../lib/supabase-server";

const url = Astro.url;
const next = url.searchParams.get("next") ?? "/admin";

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  const password = String(form.get("password") ?? "");
  if (!email || !password) {
    error = "Enter both email and password.";
  } else {
    const supabase = createSupabaseServerClient(Astro);
    const { error: signInErr } = await supabase.auth.signInWithPassword({
      email,
      password,
    });
    if (signInErr) {
      error = signInErr.message;
    } else {
      return Astro.redirect(next);
    }
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Fine Art Printing admin</title>
    <link rel="stylesheet" href="/admin/admin.css" />
  </head>
  <body class="admin-shell admin-shell--auth">
    <main class="admin-card">
      <h1>Fine Art Printing</h1>
      <p class="admin-card__sub">Admin sign-in</p>

      <form method="POST" class="admin-form">
        <label>
          <span>Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            autofocus
          />
        </label>
        <label>
          <span>Password</span>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
          />
        </label>
        <button type="submit">Sign in</button>
      </form>

      {error && <p class="admin-note admin-note--err">{error}</p>}

      <p class="admin-card__hint">
        Sign-up is disabled. Only allowlisted accounts can sign in.
      </p>
    </main>
  </body>
</html>
