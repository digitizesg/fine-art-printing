---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import { canvasImageUrl } from "../../../lib/canvases";

const supabase = createSupabaseServerClient(Astro);

const { data: rows, error } = await supabase
  .from("canvases")
  .select("*")
  .order("display_order", { ascending: true })
  .order("created_at", { ascending: true });
---
<AdminLayout title="Canvases">
  <div class="admin-page-head">
    <div>
      <h1>Canvases</h1>
      <p>{rows?.length ?? 0} canvases · these populate the canvas picker on the public calculator and product pages.</p>
    </div>
    <a href="/admin/canvases/new" class="admin-btn">+ New canvas</a>
  </div>

  {error && <p class="admin-note admin-note--err">{error.message}</p>}
  {rows && rows.length === 0 && (
    <p class="admin-note">No canvases yet. Click <strong>New canvas</strong> to add one.</p>
  )}

  <div class="admin-grid">
    {rows?.map((row) => {
      const firstImage = Array.isArray(row.images) && row.images[0] ? row.images[0] : null;
      return (
        <a class="admin-example" href={`/admin/canvases/${row.id}`}>
          {firstImage ? (
            <img class="admin-example__photo" src={canvasImageUrl(firstImage)} alt={row.name} loading="lazy" />
          ) : (
            <div class="admin-example__photo" style="aspect-ratio:3/2;background:repeating-linear-gradient(135deg,#f4efe7,#f4efe7 6px,#ece6db 6px,#ece6db 12px);display:flex;align-items:center;justify-content:center;color:#888;font-size:12px;">
              No photo yet
            </div>
          )}
          <div class="admin-example__meta">
            <span class="admin-example__service">
              {row.published ? "Published" : "Draft"}
              {row.featured && <span class="admin-example__featured" style="margin-left:8px">Featured</span>}
            </span>
            <span class="admin-example__caption">{row.brand} {row.short_name}</span>
            <span class="admin-example__row" style="font-family:monospace;font-size:11.5px;">{row.slug}</span>
            <span class="admin-example__row">
              {row.gsm}gsm · ${Number(row.sell_price_per_sqm).toFixed(2)}/sqm
            </span>
          </div>
        </a>
      );
    })}
  </div>
</AdminLayout>
