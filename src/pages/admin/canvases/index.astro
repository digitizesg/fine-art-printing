---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ViewToggle from "../../../components/admin/ViewToggle.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import { canvasImageUrl } from "../../../lib/canvases";

const supabase = createSupabaseServerClient(Astro);
const view = (Astro.url.searchParams.get("view") === "list" ? "list" : "grid") as "grid" | "list";

const { data: rows, error } = await supabase
  .from("canvases")
  .select("*")
  .order("display_order", { ascending: true })
  .order("created_at", { ascending: true });
---
<AdminLayout title="Canvases">
  <div class="admin-page-head">
    <div>
      <h1>Canvases</h1>
      <p>{rows?.length ?? 0} canvases · these populate the canvas picker on the public calculator and product pages.</p>
    </div>
    <ViewToggle url={Astro.url} view={view} />
    <a href="/admin/canvases/new" class="admin-btn">+ New canvas</a>
  </div>

  {error && <p class="admin-note admin-note--err">{error.message}</p>}
  {rows && rows.length === 0 && (
    <p class="admin-note">No canvases yet. Click <strong>New canvas</strong> to add one.</p>
  )}

  {view === "grid" && (
    <div class="admin-grid">
      {rows?.map((row) => {
        const firstImage = Array.isArray(row.images) && row.images[0] ? row.images[0] : null;
        return (
          <a class="admin-example" href={`/admin/canvases/${row.id}`}>
            {firstImage ? (
              <img class="admin-example__photo" src={canvasImageUrl(firstImage)} alt={row.name} loading="lazy" />
            ) : (
              <div class="admin-example__photo" style="aspect-ratio:3/2;background:repeating-linear-gradient(135deg,#f4efe7,#f4efe7 6px,#ece6db 6px,#ece6db 12px);display:flex;align-items:center;justify-content:center;color:#888;font-size:12px;">
                No photo yet
              </div>
            )}
            <div class="admin-example__meta">
              <span class="admin-example__service">
                {row.published ? "Published" : "Draft"}
                {row.featured && <span class="admin-example__featured" style="margin-left:8px">Featured</span>}
              </span>
              <span class="admin-example__caption">{row.brand} {row.short_name}</span>
              <span class="admin-example__row" style="font-family:monospace;font-size:11.5px;">{row.slug}</span>
              <span class="admin-example__row">{row.gsm}gsm · ${Number(row.sell_price_per_sqm).toFixed(2)}/sqm</span>
            </div>
          </a>
        );
      })}
    </div>
  )}

  {view === "list" && rows && rows.length > 0 && (
    <div class="admin-list">
      <div class="admin-list__row admin-list__row--head" style="grid-template-columns:60px 1.2fr 1.6fr 1.4fr 80px 1fr 1fr;">
        <span></span>
        <span>Brand</span>
        <span>Name</span>
        <span>Slug</span>
        <span>GSM</span>
        <span>$ / sqm</span>
        <span>Status</span>
      </div>
      {rows.map((row) => {
        const firstImage = Array.isArray(row.images) && row.images[0] ? row.images[0] : null;
        return (
          <a class="admin-list__row" href={`/admin/canvases/${row.id}`} style="grid-template-columns:60px 1.2fr 1.6fr 1.4fr 80px 1fr 1fr;">
            {firstImage ? (
              <img class="admin-list__thumb" src={canvasImageUrl(firstImage)} alt="" loading="lazy" />
            ) : (
              <span class="admin-list__thumb admin-list__thumb--placeholder"></span>
            )}
            <span class="admin-list__cell admin-list__cell--muted">{row.brand}</span>
            <span class="admin-list__cell"><strong>{row.short_name}</strong></span>
            <span class="admin-list__cell admin-list__cell--mono">{row.slug}</span>
            <span class="admin-list__cell">{row.gsm}</span>
            <span class="admin-list__cell">${Number(row.sell_price_per_sqm).toFixed(2)}</span>
            <span class="admin-list__cell">
              <span class:list={["admin-list__pill", row.published ? "admin-list__pill--published" : "admin-list__pill--draft"]}>
                {row.published ? "Published" : "Draft"}
              </span>
              {row.featured && <span class="admin-list__pill admin-list__pill--featured" style="margin-left:4px;">★</span>}
            </span>
          </a>
        );
      })}
    </div>
  )}
</AdminLayout>
