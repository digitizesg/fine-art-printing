---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import ViewToggle from "../../components/admin/ViewToggle.astro";
import { createSupabaseServerClient } from "../../lib/supabase-server";
import {
  detailLabelFor,
  SERVICE_LABELS,
  SUBJECT_LABELS,
  type Service,
  type Subject,
} from "../../lib/frame-examples";
import { listFloatFrames } from "../../lib/float-frames";
import { listCanvases } from "../../lib/canvases";
import { listPapers } from "../../lib/papers";
import { frameExampleUrl } from "../../lib/supabase";

const supabase = createSupabaseServerClient(Astro);
const url = Astro.url;
const view = (url.searchParams.get("view") === "list" ? "list" : "grid") as "grid" | "list";
const filterService = url.searchParams.get("service") as Service | "" | null;
const filterFeatured = url.searchParams.get("featured") === "1";

let query = supabase
  .from("frame_examples")
  .select("*")
  .order("display_order", { ascending: true });
if (filterService) query = query.eq("service", filterService);
if (filterFeatured) query = query.eq("featured", true);

// Run all five reads in parallel — sum-of-latencies → max-of-latencies.
// Pending-changes counter is bumped by triggers on frame_examples /
// artworks / etc. and reset to 0 on publish.
const [
  examplesRes,
  floatFrames,
  canvases,
  papers,
  stateRes,
] = await Promise.all([
  query,
  listFloatFrames({ onlyPublished: false }),
  listCanvases({ onlyPublished: false }),
  listPapers({ onlyPublished: false }),
  supabase
    .from("publish_state")
    .select("pending_count")
    .eq("id", 1)
    .single(),
]);
const rows = examplesRes.data;
const error = examplesRes.error;
const pendingCount = stateRes.data?.pending_count ?? 0;

const publishStatus = url.searchParams.get("publish");

// Resolve a DB row to its detail label using the same logic the marketing
// site uses (so admin sees what customers see).
function detailFor(row: any): string {
  return detailLabelFor({
    id: row.id,
    imagePath: row.image_path,
    imageUrl: "",
    service: row.service,
    subject: row.subject,
    caption: row.caption,
    featured: row.featured,
    pictureFrameId: row.picture_frame_id,
    floatFrameId: row.float_frame_id,
    stretchingDepth: row.stretching_depth,
    canvasId: row.canvas_id,
    paperId: row.paper_id ?? null,
    frameStyle: row.frame_style ?? null,
    displayOrder: row.display_order,
  }, floatFrames, canvases, papers);
}

function buildLink(params: Record<string, string | null>) {
  const u = new URL(url);
  for (const [k, v] of Object.entries(params)) {
    if (v === null) u.searchParams.delete(k);
    else u.searchParams.set(k, v);
  }
  return u.pathname + (u.search ? u.search : "");
}
---
<AdminLayout title="Frame examples">
  <div class="admin-page-head">
    <div>
      <h1>Frame examples</h1>
      <p>{rows?.length ?? 0} examples shown · drag-and-drop ordering coming later</p>
    </div>
    <ViewToggle url={url} view={view} />
    <a href="/admin/examples/new" class="admin-btn">+ New example</a>
  </div>

  {publishStatus === "ok" && (
    <p class="admin-note admin-note--ok">
      Publish queued. The marketing site will rebuild within ~60 seconds.
    </p>
  )}
  {publishStatus === "error" && (
    <p class="admin-note admin-note--err">
      Couldn't trigger the publish. {url.searchParams.get("reason") ?? ""}
    </p>
  )}

  <div class="admin-publish">
    <div class="admin-publish__copy">
      {pendingCount && pendingCount > 0 ? (
        <>
          <strong>{pendingCount} change{pendingCount === 1 ? "" : "s"}</strong>{" "}
          pending publish — click to push to the live site.
        </>
      ) : (
        <span>No changes pending. Live site is up to date.</span>
      )}
    </div>
    <form method="POST" action="/admin/publish">
      <button
        type="submit"
        class:list={["admin-btn", !pendingCount && "admin-btn--ghost"]}
        disabled={!pendingCount || pendingCount === 0}
      >
        Publish to live site
      </button>
    </form>
  </div>

  <div class="admin-filters">
    <a class:list={["admin-filter", !filterService && !filterFeatured && "is-active"]} href={buildLink({ service: null, featured: null })}>All</a>
    {(Object.keys(SERVICE_LABELS) as Service[]).map((s) => (
      <a class:list={["admin-filter", filterService === s && "is-active"]} href={buildLink({ service: s })}>{SERVICE_LABELS[s]}</a>
    ))}
    <a class:list={["admin-filter", filterFeatured && "is-active"]} href={buildLink({ featured: filterFeatured ? null : "1" })}>★ Featured</a>
  </div>

  {error && <p class="admin-note admin-note--err">Couldn't load examples: {error.message}</p>}

  {rows && rows.length === 0 && (
    <p class="admin-note">No examples match the current filter.</p>
  )}

  {view === "grid" && (
    <div class="admin-grid">
      {rows?.map((row) => {
        const detail = detailFor(row);
        return (
          <a class="admin-example" href={`/admin/examples/${row.id}`}>
            <img class="admin-example__photo" src={frameExampleUrl(row.image_path)} alt={row.caption ?? ""} loading="lazy" />
            <div class="admin-example__meta">
              <span class="admin-example__service">{SERVICE_LABELS[row.service as Service]}</span>
              {row.caption && <span class="admin-example__caption">{row.caption}</span>}
              {!row.caption && detail && <span class="admin-example__caption">{detail}</span>}
              <span class="admin-example__row">
                {SUBJECT_LABELS[row.subject as Subject]}
                {row.featured && <span class="admin-example__featured" style="margin-left:8px">Featured</span>}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  )}

  {view === "list" && rows && rows.length > 0 && (
    <div class="admin-list">
      <div class="admin-list__row admin-list__row--head" style="grid-template-columns:60px 1.4fr 1.2fr 2fr 80px;">
        <span></span>
        <span>Service</span>
        <span>Subject</span>
        <span>Caption / detail</span>
        <span></span>
      </div>
      {rows.map((row) => {
        const detail = detailFor(row);
        return (
          <a class="admin-list__row" href={`/admin/examples/${row.id}`} style="grid-template-columns:60px 1.4fr 1.2fr 2fr 80px;">
            <img class="admin-list__thumb" src={frameExampleUrl(row.image_path)} alt="" loading="lazy" />
            <span class="admin-list__cell">{SERVICE_LABELS[row.service as Service]}</span>
            <span class="admin-list__cell admin-list__cell--muted">{SUBJECT_LABELS[row.subject as Subject]}</span>
            <span class="admin-list__cell"><strong>{row.caption ?? detail ?? "—"}</strong></span>
            <span class="admin-list__cell">
              {row.featured && <span class="admin-list__pill admin-list__pill--featured">★</span>}
            </span>
          </a>
        );
      })}
    </div>
  )}
</AdminLayout>
