---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase-server";
import {
  SERVICE_LABELS,
  SUBJECT_LABELS,
  type Service,
  type Subject,
} from "../../lib/frame-examples";
import { frameExampleUrl } from "../../lib/supabase";

const supabase = createSupabaseServerClient(Astro);
const url = Astro.url;
const filterService = url.searchParams.get("service") as Service | "" | null;
const filterFeatured = url.searchParams.get("featured") === "1";

let query = supabase
  .from("frame_examples")
  .select("*")
  .order("display_order", { ascending: true });
if (filterService) query = query.eq("service", filterService);
if (filterFeatured) query = query.eq("featured", true);

const { data: rows, error } = await query;

// Pending-changes counter — bumped by a trigger on frame_examples for any
// insert/update/delete. Reset to 0 on publish.
const { data: stateRow } = await supabase
  .from("publish_state")
  .select("pending_count")
  .eq("id", 1)
  .single();
const pendingCount = stateRow?.pending_count ?? 0;

const publishStatus = url.searchParams.get("publish");

const labelFor = (id: string | null) =>
  id ? id.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";

function buildLink(params: Record<string, string | null>) {
  const u = new URL(url);
  for (const [k, v] of Object.entries(params)) {
    if (v === null) u.searchParams.delete(k);
    else u.searchParams.set(k, v);
  }
  return u.pathname + (u.search ? u.search : "");
}
---
<AdminLayout title="Frame examples">
  <div class="admin-page-head">
    <div>
      <h1>Frame examples</h1>
      <p>{rows?.length ?? 0} examples shown · drag-and-drop ordering coming later</p>
    </div>
    <a href="/admin/examples/new" class="admin-btn">+ New example</a>
  </div>

  {publishStatus === "ok" && (
    <p class="admin-note admin-note--ok">
      Publish queued. The marketing site will rebuild within ~60 seconds.
    </p>
  )}
  {publishStatus === "error" && (
    <p class="admin-note admin-note--err">
      Couldn't trigger the publish. {url.searchParams.get("reason") ?? ""}
    </p>
  )}

  <div class="admin-publish">
    <div class="admin-publish__copy">
      {pendingCount && pendingCount > 0 ? (
        <>
          <strong>{pendingCount} change{pendingCount === 1 ? "" : "s"}</strong>{" "}
          pending publish — click to push to the live site.
        </>
      ) : (
        <span>No changes pending. Live site is up to date.</span>
      )}
    </div>
    <form method="POST" action="/admin/publish">
      <button
        type="submit"
        class:list={["admin-btn", !pendingCount && "admin-btn--ghost"]}
        disabled={!pendingCount || pendingCount === 0}
      >
        Publish to live site
      </button>
    </form>
  </div>

  <div class="admin-filters">
    <a class:list={["admin-filter", !filterService && !filterFeatured && "is-active"]} href={buildLink({ service: null, featured: null })}>All</a>
    {(Object.keys(SERVICE_LABELS) as Service[]).map((s) => (
      <a class:list={["admin-filter", filterService === s && "is-active"]} href={buildLink({ service: s })}>{SERVICE_LABELS[s]}</a>
    ))}
    <a class:list={["admin-filter", filterFeatured && "is-active"]} href={buildLink({ featured: filterFeatured ? null : "1" })}>★ Featured</a>
  </div>

  {error && <p class="admin-note admin-note--err">Couldn't load examples: {error.message}</p>}

  {rows && rows.length === 0 && (
    <p class="admin-note">No examples match the current filter.</p>
  )}

  <div class="admin-grid">
    {rows?.map((row) => {
      const detail = labelFor(row.picture_frame_id ?? row.canvas_id);
      return (
        <a class="admin-example" href={`/admin/examples/${row.id}`}>
          <img class="admin-example__photo" src={frameExampleUrl(row.image_path)} alt={row.caption ?? ""} loading="lazy" />
          <div class="admin-example__meta">
            <span class="admin-example__service">{SERVICE_LABELS[row.service as Service]}</span>
            {row.caption && <span class="admin-example__caption">{row.caption}</span>}
            {!row.caption && detail && <span class="admin-example__caption">{detail}</span>}
            <span class="admin-example__row">
              {SUBJECT_LABELS[row.subject as Subject]}
              {row.featured && <span class="admin-example__featured" style="margin-left:8px">Featured</span>}
            </span>
          </div>
        </a>
      );
    })}
  </div>
</AdminLayout>
