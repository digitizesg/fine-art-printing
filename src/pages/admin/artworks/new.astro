---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArtworkForm from "../../../components/admin/ArtworkForm.astro";
const error = Astro.url.searchParams.get("error") ?? undefined;
---
<AdminLayout title="New artwork">
  <div class="admin-page-head">
    <div>
      <h1>New artwork</h1>
      <p>Upload the hero image, set sizes, decide which substrates apply.</p>
    </div>
  </div>
  <ArtworkForm mode="new" error={error} />
</AdminLayout>
