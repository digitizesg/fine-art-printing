---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArtworkForm from "../../../components/admin/ArtworkForm.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import { extname } from "node:path";
import { randomUUID } from "node:crypto";

const ALLOWED_TYPES = new Set(["image/jpeg", "image/png"]);
const MAX_BYTES = 25 * 1024 * 1024;

function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80);
}

function parseSizes(raw: string) {
  try {
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed
      .map((s: any) => ({
        width_cm: Number(s.width_cm),
        height_cm: Number(s.height_cm),
        label: typeof s.label === "string" && s.label.trim() ? s.label.trim() : undefined,
      }))
      .filter((s) => Number.isFinite(s.width_cm) && s.width_cm > 0 && Number.isFinite(s.height_cm) && s.height_cm > 0);
  } catch {
    return [];
  }
}

let error: string | undefined = Astro.url.searchParams.get("error") ?? undefined;

if (Astro.request.method === "POST") {
  const supabase = createSupabaseServerClient(Astro);
  const form = await Astro.request.formData();

  const title = String(form.get("title") ?? "").trim();
  let slug = String(form.get("slug") ?? "").trim().toLowerCase();
  const file = form.get("image");

  if (!title) {
    error = "Title is required.";
  } else {
    if (!slug) slug = slugify(title);
    if (!/^[a-z0-9-]+$/.test(slug)) {
      error = "Slug must be letters, numbers, and hyphens only.";
    } else if (!(file instanceof File) || file.size === 0) {
      error = "An image is required.";
    } else if (!ALLOWED_TYPES.has(file.type)) {
      error = "Image must be JPG or PNG.";
    } else if (file.size > MAX_BYTES) {
      error = "Image is over the 25 MB limit.";
    }
  }

  if (!error && file instanceof File) {
    const ext = file.type === "image/png" ? ".png" : extname(file.name) || ".jpg";
    const imagePath = `${randomUUID()}${ext}`;
    const buffer = Buffer.from(await file.arrayBuffer());
    const { error: upErr } = await supabase.storage
      .from("artworks")
      .upload(imagePath, buffer, { contentType: file.type, upsert: false });
    if (upErr) {
      error = `Upload failed: ${upErr.message}`;
    } else {
      // Gallery uploads (optional, multiple).
      const galleryFiles = form.getAll("gallery_files").filter(
        (f): f is File => f instanceof File && f.size > 0,
      );
      const uploadedGallery: string[] = [];
      let galleryError: string | undefined;
      for (const gf of galleryFiles) {
        if (!ALLOWED_TYPES.has(gf.type)) {
          galleryError = "Gallery images must be JPG or PNG.";
          break;
        }
        if (gf.size > MAX_BYTES) {
          galleryError = "One of the gallery images is over 25 MB.";
          break;
        }
        const gext = gf.type === "image/png" ? ".png" : extname(gf.name) || ".jpg";
        const gpath = `${randomUUID()}${gext}`;
        const gbuf = Buffer.from(await gf.arrayBuffer());
        const { error: gErr } = await supabase.storage
          .from("artworks")
          .upload(gpath, gbuf, { contentType: gf.type, upsert: false });
        if (gErr) {
          galleryError = `Gallery upload failed: ${gErr.message}`;
          break;
        }
        uploadedGallery.push(gpath);
      }

      if (galleryError) {
        // Clean up anything we managed to upload before failing.
        await supabase.storage.from("artworks").remove([imagePath, ...uploadedGallery]);
        error = galleryError;
      } else {
        const sizes = parseSizes(String(form.get("available_sizes") ?? "[]"));
        const row = {
          slug,
          title,
          artist_name: (form.get("artist_name") as string)?.trim() || null,
          description: (form.get("description") as string)?.trim() || null,
          hero_image_path: imagePath,
          gallery_images: uploadedGallery,
          available_sizes: sizes,
          allow_paper: form.get("allow_paper") === "1",
          allow_canvas: form.get("allow_canvas") === "1",
          published: form.get("published") === "1",
          featured: form.get("featured") === "1",
        };
        const { data, error: insErr } = await supabase
          .from("artworks")
          .insert(row)
          .select("id")
          .single();
        if (insErr) {
          await supabase.storage.from("artworks").remove([imagePath, ...uploadedGallery]);
          error = insErr.message;
        } else {
          return Astro.redirect(`/admin/artworks/${data.id}?created=1`);
        }
      }
    }
  }
}
---
<AdminLayout title="New artwork">
  <div class="admin-page-head">
    <div>
      <h1>New artwork</h1>
      <p>Upload the hero image, set sizes, decide which substrates apply.</p>
    </div>
  </div>
  <ArtworkForm mode="new" error={error} />
</AdminLayout>
