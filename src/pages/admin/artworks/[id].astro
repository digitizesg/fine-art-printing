---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArtworkForm from "../../../components/admin/ArtworkForm.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";
import { artworkImageUrl } from "../../../lib/artworks";

const id = Astro.params.id;
const supabase = createSupabaseServerClient(Astro);

let error: string | undefined;
let message: string | undefined;

function parseSizes(raw: string) {
  try {
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed
      .map((s: any) => ({
        width_cm: Number(s.width_cm),
        height_cm: Number(s.height_cm),
        label: typeof s.label === "string" && s.label.trim() ? s.label.trim() : undefined,
      }))
      .filter((s) => Number.isFinite(s.width_cm) && s.width_cm > 0 && Number.isFinite(s.height_cm) && s.height_cm > 0);
  } catch {
    return [];
  }
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const title = String(form.get("title") ?? "").trim();
  let slug = String(form.get("slug") ?? "").trim().toLowerCase();
  if (!title) error = "Title is required.";
  else if (!slug || !/^[a-z0-9-]+$/.test(slug)) error = "Slug must be letters, numbers, and hyphens only.";

  const update: Record<string, unknown> = {
    title,
    slug,
    artist_name: (form.get("artist_name") as string)?.trim() || null,
    description: (form.get("description") as string)?.trim() || null,
    available_sizes: parseSizes(String(form.get("available_sizes") ?? "[]")),
    allow_paper: form.get("allow_paper") === "1",
    allow_canvas: form.get("allow_canvas") === "1",
    published: form.get("published") === "1",
    featured: form.get("featured") === "1",
  };

  const allowed = new Set(["image/jpeg", "image/png"]);
  const MAX = 25 * 1024 * 1024;
  const { randomUUID } = await import("node:crypto");
  const { extname } = await import("node:path");

  // Optional hero image replacement.
  const file = form.get("image");
  let oldHero: string | null = null;
  if (!error && file instanceof File && file.size > 0) {
    if (!allowed.has(file.type)) {
      error = "Replacement image must be JPG or PNG.";
    } else if (file.size > MAX) {
      error = "Replacement image is over the 25 MB limit.";
    } else {
      const ext = file.type === "image/png" ? ".png" : extname(file.name) || ".jpg";
      const newPath = `${randomUUID()}${ext}`;
      const buffer = Buffer.from(await file.arrayBuffer());
      const { error: upErr } = await supabase.storage
        .from("artworks")
        .upload(newPath, buffer, { contentType: file.type, upsert: false });
      if (upErr) error = `Image upload failed: ${upErr.message}`;
      else {
        update.hero_image_path = newPath;
        // Capture dimensions of the replacement so the public shop
        // page can keep skipping <Image inferSize>.
        try {
          const sharp = (await import("sharp")).default;
          const meta = await sharp(buffer).metadata();
          if (meta.width && meta.height) {
            update.image_width = meta.width;
            update.image_height = meta.height;
          }
        } catch {
          // Fall back to leaving columns null; backfill script can
          // populate later.
        }
        // Record old path for deletion after a successful row update.
        const { data: existing } = await supabase
          .from("artworks")
          .select("hero_image_path")
          .eq("id", id)
          .single();
        oldHero = existing?.hero_image_path ?? null;
      }
    }
  }

  // Gallery: which existing paths to keep + any new uploads to add.
  let kept: string[] = [];
  try {
    const raw = JSON.parse(String(form.get("kept_gallery") ?? "[]"));
    if (Array.isArray(raw)) kept = raw.filter((s) => typeof s === "string");
  } catch {
    kept = [];
  }
  const galleryFiles = form.getAll("gallery_files").filter(
    (f): f is File => f instanceof File && f.size > 0,
  );
  const uploadedGallery: string[] = [];
  if (!error) {
    for (const gf of galleryFiles) {
      if (!allowed.has(gf.type)) { error = "Gallery images must be JPG or PNG."; break; }
      if (gf.size > MAX) { error = "A gallery image is over 25 MB."; break; }
      const gext = gf.type === "image/png" ? ".png" : extname(gf.name) || ".jpg";
      const gpath = `${randomUUID()}${gext}`;
      const gbuf = Buffer.from(await gf.arrayBuffer());
      const { error: gErr } = await supabase.storage
        .from("artworks")
        .upload(gpath, gbuf, { contentType: gf.type, upsert: false });
      if (gErr) { error = `Gallery upload failed: ${gErr.message}`; break; }
      uploadedGallery.push(gpath);
    }
  }
  if (error) {
    // Clean up partial uploads if anything went wrong above.
    if (uploadedGallery.length) {
      await supabase.storage.from("artworks").remove(uploadedGallery);
    }
  }

  if (!error) {
    update.gallery_images = [...kept, ...uploadedGallery];

    // Look up the previous gallery so we can delete the storage objects the
    // admin removed.
    const { data: existing } = await supabase
      .from("artworks")
      .select("gallery_images")
      .eq("id", id)
      .single();
    const prevGallery: string[] = Array.isArray(existing?.gallery_images)
      ? (existing!.gallery_images as string[])
      : [];
    const removed = prevGallery.filter((p) => !kept.includes(p));

    const { error: updErr } = await supabase
      .from("artworks")
      .update(update)
      .eq("id", id);
    if (updErr) {
      // Roll back any newly uploaded gallery files since the update failed.
      if (uploadedGallery.length) {
        await supabase.storage.from("artworks").remove(uploadedGallery);
      }
      if (oldHero && update.hero_image_path) {
        await supabase.storage.from("artworks").remove([update.hero_image_path as string]);
      }
      error = updErr.message;
    } else {
      const toDelete = [...removed];
      if (oldHero) toDelete.push(oldHero);
      if (toDelete.length) {
        await supabase.storage.from("artworks").remove(toDelete);
      }
      message = "Saved.";
    }
  }
}

const { data: row, error: loadErr } = await supabase
  .from("artworks")
  .select("*")
  .eq("id", id)
  .single();

if (loadErr || !row) {
  return Astro.redirect("/admin/artworks?error=not_found");
}

const galleryPaths: string[] = Array.isArray(row.gallery_images)
  ? (row.gallery_images as string[])
  : [];
const artwork = {
  ...row,
  hero_image_url: artworkImageUrl(row.hero_image_path),
  available_sizes: Array.isArray(row.available_sizes) ? row.available_sizes : [],
  gallery_images: galleryPaths.map((path) => ({ path, url: artworkImageUrl(path) })),
};

if (Astro.url.searchParams.get("created") === "1" && !message) {
  message = "Created.";
}
---
<AdminLayout title="Edit artwork">
  <div class="admin-page-head">
    <div>
      <h1>{artwork.title}</h1>
      <p style="font-family:monospace;font-size:11.5px;color:#888;">/shop/{artwork.slug}</p>
    </div>
    <a href="/admin/artworks" class="admin-btn admin-btn--ghost">← Back to list</a>
  </div>
  <ArtworkForm mode="edit" artwork={artwork} error={error} message={message} />
</AdminLayout>
