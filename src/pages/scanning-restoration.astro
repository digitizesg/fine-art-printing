---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import DarkCTA from "../components/DarkCTA.astro";
import GoogleReviewsBadge from "../components/GoogleReviewsBadge.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
import PhotoServiceCalculator from "../components/PhotoServiceCalculator.astro";
import { business } from "../data/business";

const description =
  "Photo restoration, scanning, enlargement, and image enhancement in Singapore. Old family photos brought back to print quality. Pricing starts from S$200 depending on condition.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Photo restoration and scanning",
  provider: {
    "@type": "LocalBusiness",
    name: "Fine Art Printing",
    url: "https://fineartprinting.com.sg",
  },
  areaServed: { "@type": "Country", name: "Singapore" },
};

const ctaText = encodeURIComponent(
  "Hi Fine Art Printing, I'd like a quote for photo restoration / scanning. I've attached images of the photo and a short description of what I'd like done.",
);
const waLink = `${business.whatsappLink}?text=${ctaText}`;
const contactLink = `/contact?message=${ctaText}`;

const services = [
  {
    title: "Photo restoration",
    body:
      "Old family photographs brought back. Our team can scan, repair, and reprint just about anything once we've seen the original. Send images and we'll come back with what's possible and a quote.",
  },
  {
    title: "Scanning and digitisation",
    body:
      "Soft copies of paintings, prints, and old photographs. We always favour flatbed scanning where possible since the quality is hard to beat. After years of doing this we have reliable solutions for items that don't fit a flatbed too. Send us a photo and we'll pick the right approach.",
  },
  {
    title: "Enlargement",
    body:
      "Common request before printing on paper or canvas. We combine traditional sharpening with AI upscaling to push small originals to large-print sizes without the usual softening.",
  },
  {
    title: "Enhancement and editing",
    body:
      "In-house designers for retouching, colour correction, background work, and any pre-print prep your image needs. Tell us the look you want and we'll quote it.",
  },
];

const faqs = [
  {
    q: "My photo is very damaged. Can you help?",
    a: `Probably. Restoration is a balance between the state of the original and what you want the end result to look like. Send us a photo of the photo and we'll be honest about what's achievable, what it'll cost, and whether it's worth the spend.`,
  },
  {
    q: "I'd like a digital copy of my artwork. Can you help?",
    a: `Yes. When we digitally restore your image we will provide the digital high resolution copy for your records. We typically may keep it in our records for around 2 years unless you ask us to remove it for you. It is safe and secure.\n\nMany clients will ask us to print and frame their restored image. We also offer the option to print and re-frame in your existing frame in situations where the frame is still in reasonable condition. Some labour fees may apply.`,
  },
  {
    q: "My photo is really faded. Can it be restored?",
    a: `Often, yes. Faded colour can usually be brought back. Send the photo so we can review and tell you what's likely.`,
  },
  {
    q: "I want to blow up a small photo to print large. Can it be done?",
    a: `Very common request, especially for customers who plan to print with us afterwards. We use a mix of traditional sharpening, AI upscaling, and the enlargement software bundled with the Epson scanner. Results from small originals can be surprising.`,
  },
  {
    q: "Do you offer design and editing services?",
    a: `Yes. We have designers on staff who handle retouching, layout, and pre-print preparation. Tell us what you need.`,
  },
  {
    q: "How much do your services cost?",
    a: `Pricing starts from S$200 and varies with the condition of the original and how far you want us to take the work. Send images and we'll come back with a no-obligation quote.`,
  },
];
---
<BaseLayout
  title="Photo restoration and scanning · Fine Art Printing"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-14 pb-12 md:pt-20 md:pb-20">
      <div class="grid gap-10 md:grid-cols-12 md:items-center md:gap-14">
        <div class="md:col-span-6">
          <Eyebrow>Photo restoration and scanning</Eyebrow>
          <h1 class="mt-4 font-serif text-[clamp(2.2rem,5vw,3rem)] font-medium leading-[1.08] text-ink text-balance">
            Old photos, brought back.
          </h1>
          <p class="mt-6 max-w-[640px] text-[16px] leading-relaxed text-subtle">
            Scanning, digitisation, enlargement, and full restoration of old
            photographs and other paper-based works. Send us images of what
            you have and we'll tell you what's possible.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#quote"
              class="inline-flex items-center gap-2 rounded-pill bg-petrol px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-[#142a40]"
            >
              Get a price now <span aria-hidden="true">↓</span>
            </a>
            <a
              href={waLink}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-pill border border-[#1ebe5b] bg-[#25D366] px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-[#1ebe5b]"
            >
              <WhatsAppIcon size={16} />
              <span>WhatsApp us</span>
            </a>
          </div>

          <GoogleReviewsBadge class="mt-6" />
        </div>

        <div class="md:col-span-6">
          <figure>
            <img
              src="/photos/photo-rag-1.jpg"
              alt="Restored archival photograph printed on Hahnemühle Photo Rag"
              class="aspect-[4/5] w-full rounded-card object-cover shadow-[0_24px_60px_-24px_rgba(0,0,0,0.35)]"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-t border-border-soft bg-[#FAF7F1]">
    <div class="mx-auto max-w-[1180px] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-[680px] text-center">
        <Eyebrow>What we do</Eyebrow>
        <DisplayHeading level={2} class="mt-3">
          Image services we offer.
        </DisplayHeading>
        <p class="mt-5 text-[16px] leading-relaxed text-subtle">
          Most jobs combine more than one of these. Send us your photo with a
          short description of what you'd like done, we'll suggest the right
          mix.
        </p>
      </div>

      <ol class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2">
        {services.map((row, i) => (
          <li class="border-t border-ink/10 pt-5">
            <span class="font-serif italic text-[14px] text-[var(--color-gold-text)]">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 font-serif text-[20px] font-medium leading-[1.3] text-ink">
              {row.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-subtle">
              {row.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Quoter -->
  <section id="quote" class="border-t border-border-soft bg-white scroll-mt-6">
    <div class="mx-auto max-w-[1180px] px-6 py-20">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <Eyebrow>Get an estimate now</Eyebrow>
          <DisplayHeading level={2} class="mt-3">
            Get a photo restoration estimate
          </DisplayHeading>
          <p class="mt-5 max-w-[380px] text-[15px] leading-relaxed text-subtle">
            Photo restoration typically involves high resolution scanning of
            the original, and where the image is larger than our scanner, we
            will stitch scans together before doing digital restoration.
          </p>
          <p class="mt-4 max-w-[380px] text-[15px] leading-relaxed text-subtle">
            This restoration uses a mixture of AI tools and manual editing in
            Photoshop. It is a time intensive job where clients often ask for
            further revisions due to the personal nature of the images.
          </p>
          <p class="mt-4 max-w-[380px] text-[14px] leading-relaxed text-subtle">
            If you are scanning artwork to make prints, please use our{" "}
            <a href="/art-scanning" class="text-petrol underline-offset-2 hover:underline">
              art scanning page
            </a>{" "}
            instead.
          </p>
        </div>
        <div class="md:col-span-8">
          <PhotoServiceCalculator fixedKind="restoration" />
        </div>
      </div>
    </div>
  </section>

  <!-- After scanning, you can print -->
  <section class="border-t border-border-soft bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-20">
      <div class="mx-auto max-w-[820px] text-center">
        <Eyebrow>What's next</Eyebrow>
        <DisplayHeading level={2} class="mt-3">
          Print the result.
        </DisplayHeading>
        <p class="mt-5 text-[16px] leading-relaxed text-subtle">
          Once a digital file has been restored, scanned, or enlarged, most
          clients reprint with us on archival paper or canvas. Same studio,
          same colour pipeline, no handover.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a
          href="/print-on-paper"
          class="group block rounded-card border border-border-soft bg-white p-6 transition-shadow hover:shadow-[0_12px_32px_-12px_rgba(0,0,0,0.18)]"
        >
          <p class="font-serif text-[20px] font-medium text-ink">Print on paper</p>
          <p class="mt-2 text-[14px] leading-relaxed text-subtle">Archival Hahnemühle papers, configured to your size.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-petrol">
            View paper options
            <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </span>
        </a>
        <a
          href="/print-on-canvas"
          class="group block rounded-card border border-border-soft bg-white p-6 transition-shadow hover:shadow-[0_12px_32px_-12px_rgba(0,0,0,0.18)]"
        >
          <p class="font-serif text-[20px] font-medium text-ink">Print on canvas</p>
          <p class="mt-2 text-[14px] leading-relaxed text-subtle">Premium canvas substrates, stretched and framed in-house.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-petrol">
            View canvas options
            <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-border-soft bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-20">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <Eyebrow>FAQ</Eyebrow>
          <DisplayHeading level={2} class="mt-3">
            Common questions.
          </DisplayHeading>
          <p class="mt-5 max-w-[360px] text-[15px] leading-relaxed text-subtle">
            If yours isn't here, WhatsApp us a photo of the original, we'll
            tell you what's possible.
          </p>
        </div>
        <ul class="md:col-span-8 grid grid-cols-1 gap-4">
          {faqs.map(({ q, a }) => (
            <li class="rounded-card border border-border-soft bg-white p-6">
              <h3 class="font-serif text-[18px] font-medium leading-[1.3] text-ink">
                {q}
              </h3>
              <p class="mt-3 text-[14.5px] leading-relaxed text-subtle whitespace-pre-line">
                {a}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <DarkCTA />
</BaseLayout>
