---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import VisitSection from "../../components/VisitSection.astro";
import FrameLightbox from "../../components/FrameLightbox.astro";
import { listPapers, getPaperBySlug, type Paper } from "../../lib/papers";
import { breadcrumbSchema } from "../../lib/schema";
import { business } from "../../data/business";

export async function getStaticPaths() {
  const papers = await listPapers();
  return papers.map((p) => ({
    params: { slug: p.slug },
    props: { paper: p },
  }));
}

const { paper } = Astro.props as { paper: Paper };

// Pull a few related papers for the bottom of the page (same brand or
// shared use cases). Cap at 3.
const allPapers = await listPapers();
const related = allPapers
  .filter((p) => p.slug !== paper.slug)
  .map((p) => {
    const sharedTags = p.bestFor.filter((t) => paper.bestFor.includes(t)).length;
    const sameBrand = p.brand === paper.brand ? 1 : 0;
    return { paper: p, score: sharedTags * 2 + sameBrand };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.paper);

const useCaseLabels: Record<string, string> = {
  "colour-photo": "Colour photography",
  "bw-photo": "Black-and-white photography",
  "original-art": "Original artwork reproduction",
  "illustration": "Illustration",
};

const finishLabel = paper.finish.replace("-", " ");

const description =
  paper.description ||
  `${paper.name}, ${paper.gsm}gsm ${finishLabel} archival paper. Print fine art on ${paper.shortName} at Fine Art Printing Singapore.`;

const heroImage = paper.imageUrls[0];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: paper.name,
    description,
    brand: { "@type": "Brand", name: paper.brand },
    image: paper.imageUrls.length > 0 ? paper.imageUrls : undefined,
    category: "Fine art paper",
    additionalProperty: [
      { "@type": "PropertyValue", name: "Weight", value: `${paper.gsm}gsm` },
      { "@type": "PropertyValue", name: "Finish", value: finishLabel },
      { "@type": "PropertyValue", name: "Tone", value: paper.tone },
      { "@type": "PropertyValue", name: "Texture", value: paper.texture },
      { "@type": "PropertyValue", name: "Durability", value: paper.durability },
      { "@type": "PropertyValue", name: "Maximum print width", value: `${paper.maxPrintWidthCm} cm` },
      { "@type": "PropertyValue", name: "Maximum print length", value: `${paper.maxPrintLengthCm} cm` },
    ],
    offers: {
      "@type": "Offer",
      price: paper.sellPricePerSqm.toFixed(2),
      priceCurrency: "SGD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: paper.sellPricePerSqm.toFixed(2),
        priceCurrency: "SGD",
        unitText: "per square metre",
      },
      availability: "https://schema.org/InStock",
      seller: {
        "@type": "LocalBusiness",
        name: business.name,
        url: `https://${business.domain}`,
      },
    },
  },
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Print on paper", url: "/print-on-paper" },
    { name: paper.name },
  ]),
];
---
<BaseLayout
  title={`${paper.name} · Fine Art Printing Singapore`}
  description={description}
  image={heroImage}
  jsonLd={jsonLd}
  type="article"
>
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-10 pb-8 md:pt-14 md:pb-10">
      <p class="text-[13px] text-muted">
        <a href="/print-on-paper" class="hover:text-ink hover:underline underline-offset-2">Papers</a>
        <span class="px-1.5 text-subtle" aria-hidden="true">›</span>
        <span class="text-ink">{paper.shortName}</span>
      </p>

      <div class="mt-6 grid gap-10 md:grid-cols-2 md:gap-14 md:items-start">
        <!-- Image gallery -->
        <div class="md:sticky md:top-6 self-start">
          {heroImage ? (
            <button
              type="button"
              class="block w-full p-0 border-0 bg-transparent cursor-zoom-in"
              data-frame-zoom
              data-frame-image={heroImage}
              data-frame-name={`${paper.name}, sample 1`}
              data-frame-gallery={`paper-${paper.slug}`}
              aria-label={`View ${paper.name} sample 1 larger`}
            >
              <img
                src={heroImage}
                alt={`Sample print on ${paper.name}`}
                class="w-full rounded-card object-contain bg-[#f4efe7] shadow-[0_24px_60px_-24px_rgba(0,0,0,0.30)]"
                loading="eager"
              />
            </button>
          ) : (
            <div class="w-full aspect-[4/3] rounded-card bg-[#f4efe7]"></div>
          )}
          {paper.imageUrls.length > 1 && (
            <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {paper.imageUrls.slice(1).map((url, i) => (
                <button
                  type="button"
                  class="aspect-square overflow-hidden rounded-md bg-[#f4efe7] border border-border-soft transition-shadow hover:shadow-md cursor-zoom-in p-0"
                  data-frame-zoom
                  data-frame-image={url}
                  data-frame-name={`${paper.name}, sample ${i + 2}`}
                  data-frame-gallery={`paper-${paper.slug}`}
                  aria-label={`View ${paper.name} sample ${i + 2} larger`}
                >
                  <img src={url} alt="" loading="lazy" class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Detail -->
        <div>
          <Eyebrow>{paper.brand}</Eyebrow>
          <h1 class="mt-3 font-serif text-[clamp(2rem,4vw,2.6rem)] font-medium leading-[1.08] text-ink">
            {paper.shortName}
          </h1>
          <p class="mt-2 text-[14px] text-muted">{paper.name}</p>

          <p class="mt-6 text-[15.5px] leading-relaxed text-subtle">
            {paper.description}
          </p>

          {paper.notice && (
            <div class="mt-6 rounded-card border border-amber-300 bg-amber-50 px-4 py-3 text-[14px] leading-relaxed text-amber-900">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700 mb-1">Heads up</p>
              <p class="whitespace-pre-line">{paper.notice}</p>
            </div>
          )}

          <!-- Specs -->
          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Weight</dt>
              <dd class="mt-1 text-[15px] text-ink tabular-nums">{paper.gsm}gsm</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Finish</dt>
              <dd class="mt-1 text-[15px] text-ink capitalize">{finishLabel}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Tone</dt>
              <dd class="mt-1 text-[15px] text-ink">{paper.tone}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Texture</dt>
              <dd class="mt-1 text-[15px] text-ink">{paper.texture}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Durability</dt>
              <dd class="mt-1 text-[15px] text-ink capitalize">{paper.durability}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Max width</dt>
              <dd class="mt-1 text-[15px] text-ink tabular-nums">{paper.maxPrintWidthCm.toFixed(0)} cm</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-muted">Max length</dt>
              <dd class="mt-1 text-[15px] text-ink tabular-nums">{(paper.maxPrintLengthCm / 100).toFixed(0)} m</dd>
            </div>
          </dl>

          {paper.bestFor.length > 0 && (
            <div class="mt-8">
              <p class="text-[11px] uppercase tracking-wider text-muted">Best for</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {paper.bestFor.map((t) => (
                  <li class="inline-flex items-center px-3 py-1.5 rounded-full border border-border-soft bg-[#FAF7F1] text-[13px] text-ink">
                    {useCaseLabels[t] ?? t}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/print-on-paper#calculator"
              class="inline-flex items-center justify-center rounded-pill bg-petrol px-6 py-3 text-[14px] font-semibold text-white transition-colors hover:bg-[#142a40]"
            >
              Get a price for {paper.shortName} <span aria-hidden="true">→</span>
            </a>
            <a
              href={`${business.whatsappLink}?text=${encodeURIComponent(`Hi Fine Art Printing, I'd like to ask about printing on ${paper.name}.`)}`}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-pill border border-[#1ebe5b] bg-[#25D366] px-5 py-3 text-[14px] font-semibold text-white"
            >
              WhatsApp us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Long description -->
  {paper.longDescription && paper.longDescription !== paper.description && (
    <section class="border-t border-border-soft bg-[#FAF7F1]">
      <div class="mx-auto max-w-[820px] px-6 py-16 md:py-20">
        <Eyebrow>About this paper</Eyebrow>
        <p class="mt-6 text-[16px] leading-relaxed text-subtle whitespace-pre-line">
          {paper.longDescription}
        </p>
      </div>
    </section>
  )}

  <!-- Related papers -->
  {related.length > 0 && (
    <section class="border-t border-border-soft bg-white">
      <div class="mx-auto max-w-[1180px] px-6 py-16 md:py-20">
        <Eyebrow>You might also like</Eyebrow>
        <h2 class="mt-3 font-serif text-[clamp(1.6rem,3vw,2rem)] font-medium leading-[1.1] text-ink">
          Other papers worth a look.
        </h2>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={`/papers/${r.slug}`} class="group block rounded-card border border-border-soft bg-white overflow-hidden transition-shadow hover:shadow-[0_12px_32px_-12px_rgba(0,0,0,0.18)]">
                {r.imageUrls[0] && (
                  <div class="aspect-[4/3] w-full bg-[#f4efe7] overflow-hidden">
                    <img src={r.imageUrls[0]} alt={r.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
                  </div>
                )}
                <div class="p-5">
                  <p class="text-[12px] text-muted">{r.brand}</p>
                  <h3 class="mt-1 font-serif text-[18px] font-medium text-ink">{r.shortName}</h3>
                  <p class="mt-2 text-[13.5px] text-subtle">{r.blurb}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <VisitSection />
  <FrameLightbox />
</BaseLayout>
