---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import LocationCard from "../components/LocationCard.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
import { business } from "../data/business";

const description =
  "Send us a message with reference photos for a quote, or visit our studio. Hours, address, and directions for Fine Art Printing in Singapore.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Fine Art Printing",
  url: `https://${business.domain}/contact`,
  about: {
    "@type": "LocalBusiness",
    name: business.name,
    email: business.contactEmail,
    telephone: business.phone,
    url: `https://${business.domain}`,
  },
};

const waHref = `${business.whatsappLink}?text=${encodeURIComponent("Hi Fine Art Printing, I'd like to ask about a print.")}`;

const channels = [
  {
    title: "WhatsApp",
    desc: "Quick questions and on-the-fly photos. Often the fastest channel.",
    cta: "Open WhatsApp",
    href: waHref,
    external: true,
    accent: "wa",
  },
  {
    title: "Phone",
    desc: "If you'd rather speak to someone, we're at the studio during opening hours.",
    cta: business.phone,
    href: `tel:${business.phone.replace(/\s+/g, "")}`,
    external: false,
    accent: "default",
  },
];

const mapsDirectionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${business.address.line1}, ${business.address.line2} ${business.address.line3}, ${business.address.postcode}`,
)}&destination_place_id=${business.placeId}`;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<BaseLayout
  title="Contact · Fine Art Printing"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pt-14 pb-10 md:pt-20 md:pb-14">
      <div class="max-w-[820px]">
        <Eyebrow>Contact</Eyebrow>
        <h1 class="mt-4 font-serif text-[clamp(2.2rem,5vw,3rem)] font-medium leading-[1.08] text-ink">
          Send us your reference. We'll quote it.
        </h1>
        <p class="mt-6 max-w-[640px] text-[16px] leading-relaxed text-subtle">
          Tell us what you're trying to print, stretch, or frame, attach a
          photo or two if you can, and we'll come back with a quote and a
          recommendation, usually the same day.
        </p>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 pb-20 md:pb-24">
      <div class="max-w-[820px]">
        <form class="contact-form" data-contact-form novalidate>
          <label class="contact-form__field">
            <span>Your name</span>
            <input type="text" name="name" required maxlength="120" autocomplete="name" />
          </label>

          <fieldset class="contact-form__field contact-form__pref">
            <legend>How would you prefer us to contact you?</legend>
            <div class="contact-form__pref-row" role="radiogroup">
              <label class="contact-form__pref-opt">
                <input type="radio" name="preferred_contact" value="whatsapp" required />
                <span>WhatsApp</span>
              </label>
              <label class="contact-form__pref-opt">
                <input type="radio" name="preferred_contact" value="phone" required />
                <span>Phone call</span>
              </label>
              <label class="contact-form__pref-opt">
                <input type="radio" name="preferred_contact" value="email" required />
                <span>Email</span>
              </label>
            </div>
          </fieldset>

          <label class="contact-form__field" data-show-when="phone-or-whatsapp" hidden>
            <span data-contact-phone-label>Phone number</span>
            <input type="tel" name="phone" maxlength="40" autocomplete="tel" data-contact-phone />
          </label>

          <label class="contact-form__field" data-show-when="email" hidden>
            <span>Email</span>
            <input type="email" name="email" maxlength="254" autocomplete="email" data-contact-email />
          </label>

          <label class="contact-form__field">
            <span>What can we help with?</span>
            <textarea name="message" required rows="6" maxlength="3000" placeholder="Size, finishing preferences, deadline — anything that helps us quote accurately."></textarea>
          </label>

          <div class="contact-form__field">
            <span>Reference photos <em>(optional, up to 5)</em></span>
            <label class="contact-form__dropzone" data-contact-dropzone>
              <input type="file" name="files" accept="image/jpeg,image/png,image/heic,application/pdf" multiple data-contact-files hidden />
              <div class="contact-form__dropzone-prompt">
                <strong>Click to browse</strong> or drag files here
                <span>JPG, PNG, HEIC, or PDF · 10 MB each, 5 max</span>
              </div>
            </label>
            <ul class="contact-form__files" data-contact-file-list></ul>
            <p class="contact-form__small">
              <strong>Reference photos only.</strong> If you have a high-resolution print-ready file, mention it in your message and we'll send a secure upload link — please don't try to send it through this form.
            </p>
          </div>

          <!-- Honeypot. Real users never see or fill this; bots usually do. -->
          <div class="contact-form__honeypot" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          {turnstileSiteKey && (
            <div class="contact-form__turnstile cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          )}

          <div class="contact-form__actions">
            <button type="submit" class="contact-form__submit" data-contact-submit>
              Send message
            </button>
            <p class="contact-form__hint" data-contact-hint></p>
          </div>
        </form>

        <div class="contact-form__success" data-contact-success hidden>
          <h2>Message sent.</h2>
          <p>
            Thanks. We've got it and we'll come back to you as soon as we can.
            We aim to respond the same day during studio hours; weekends roll
            into Monday.
          </p>
          <p class="contact-form__success-detail" data-contact-success-detail></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternative channels -->
  <section class="border-t border-border-soft bg-[#FAF7F1]">
    <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
      <div class="max-w-[640px]">
        <Eyebrow>Other ways to reach us</Eyebrow>
        <DisplayHeading level={2} class="mt-3">Pick whichever's easiest.</DisplayHeading>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {channels.map((c) => (
          <a
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener" : undefined}
            class="group flex h-full flex-col rounded-card border border-border-soft bg-white p-6 transition-shadow hover:shadow-[0_12px_32px_-12px_rgba(0,0,0,0.18)]"
          >
            <p class="font-serif text-[18px] font-medium text-ink">{c.title}</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-subtle">{c.desc}</p>
            <span class={`mt-5 inline-flex items-center gap-1.5 text-[14px] font-semibold ${c.accent === "wa" ? "text-[#1ebe5b]" : "text-petrol"}`}>
              {c.cta === "Open WhatsApp" && <WhatsAppIcon size={14} />}
              {c.cta}
              <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Studio + map -->
  <section class="border-t border-border-soft bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5">
          <Eyebrow>Visit the studio</Eyebrow>
          <DisplayHeading level={2} class="mt-3">Where to find us.</DisplayHeading>
          <p class="mt-5 text-[15.5px] leading-relaxed text-subtle">
            We're at Cendex Centre on Lower Delta Road, ten minutes' walk from
            Tiong Bahru MRT, with parking on-site. Drop in during opening
            hours, or message ahead so we can have your job ready when you
            arrive.
          </p>

          <a
            href={mapsDirectionsHref}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-pill border border-ink/15 bg-white px-5 py-2.5 text-[14px] font-semibold text-ink transition-colors hover:border-petrol hover:bg-petrol hover:text-white"
          >
            Get directions <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="md:col-span-7">
          <LocationCard />
        </div>
      </div>
    </div>
  </section>

  {turnstileSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )}
</BaseLayout>

<style is:global>
  .contact-form {
    display: grid;
    gap: 20px;
  }
  .contact-form__field {
    display: grid;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .contact-form__field > span,
  .contact-form__field > legend {
    font-size: 15px;
    color: var(--color-ink);
    font-weight: 600;
    padding: 0;
  }
  .contact-form__field > span em,
  .contact-form__field > legend em {
    font-style: normal;
    color: var(--color-muted);
    font-weight: 400;
  }
  .contact-form input[type="text"],
  .contact-form input[type="email"],
  .contact-form input[type="tel"],
  .contact-form textarea {
    padding: 14px 16px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 10px;
    font: inherit;
    font-size: 16.5px;
    background: #fff;
    color: var(--color-ink);
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-petrol);
    outline-offset: 0;
    border-color: var(--color-petrol);
  }
  .contact-form textarea { resize: vertical; min-height: 140px; }

  .contact-form__pref-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .contact-form__pref-opt {
    position: relative;
    flex: 1 1 0;
    min-width: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 16px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    cursor: pointer;
    background: #fff;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-align: center;
    transition: border-color 150ms, background 150ms, box-shadow 150ms;
    user-select: none;
  }
  .contact-form__pref-opt:hover {
    border-color: rgba(0, 0, 0, 0.25);
  }
  /* Hide the native radio circle — the card itself communicates state. */
  .contact-form__pref-opt input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .contact-form__pref-opt:has(input:checked) {
    border-color: var(--color-selected);
    background: var(--color-selected-bg-strong);
    box-shadow: inset 0 0 0 1px var(--color-selected);
  }
  .contact-form__pref-opt:has(input:focus-visible) {
    outline: 2px solid var(--color-petrol);
    outline-offset: 2px;
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__dropzone {
    display: block;
    padding: 32px 20px;
    border: 1.5px dashed rgba(0, 0, 0, 0.20);
    border-radius: 12px;
    background: #FAF7F1;
    text-align: center;
    cursor: pointer;
    transition: border-color 150ms, background 150ms;
  }
  .contact-form__dropzone:hover {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.04);
  }
  .contact-form__dropzone.is-dragover {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.06);
  }
  .contact-form__dropzone-prompt {
    display: grid;
    gap: 6px;
    font-size: 15px;
    color: var(--color-subtle);
  }
  .contact-form__dropzone-prompt strong {
    color: var(--color-petrol);
    font-weight: 600;
  }
  .contact-form__dropzone-prompt span {
    font-size: 13px;
    color: var(--color-muted);
  }
  .contact-form__files {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .contact-form__files li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    font-size: 14px;
    color: var(--color-ink);
  }
  .contact-form__files li button {
    background: none;
    border: 0;
    color: var(--color-muted);
    font-size: 13px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .contact-form__files li button:hover { color: var(--color-ink); }
  .contact-form__files li.is-error {
    border-color: rgba(180, 30, 30, 0.30);
    background: rgba(180, 30, 30, 0.04);
    color: #8a1414;
  }

  .contact-form__small {
    margin: 10px 0 0;
    font-size: 13.5px;
    color: var(--color-subtle);
    line-height: 1.55;
  }

  .contact-form__turnstile { margin-top: 4px; }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
  }
  .contact-form__submit {
    appearance: none;
    border: 0;
    background: var(--color-petrol);
    color: #fff;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background 150ms ease-out;
  }
  .contact-form__submit:hover { background: #142a40; }
  .contact-form__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .contact-form__hint { margin: 0; font-size: 14px; color: var(--color-subtle); }
  .contact-form__hint--err { color: #8a1414; }

  .contact-form__success {
    padding: 28px 32px;
    border-radius: 12px;
    background: #FAF7F1;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
  }
  .contact-form__success h2 {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    color: var(--color-ink);
  }
  .contact-form__success p {
    margin: 0 0 8px;
    font-size: 15px;
    color: var(--color-subtle);
    line-height: 1.6;
  }
  .contact-form__success p:last-child { margin-bottom: 0; }
  .contact-form__success-detail {
    font-size: 13px !important;
    color: var(--color-muted) !important;
  }
</style>

<script>
  const MAX_FILES = 5;
  const MAX_BYTES = 10 * 1024 * 1024;
  const ALLOWED = new Set(["image/jpeg", "image/png", "image/heic", "application/pdf"]);

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  // Prefill the message textarea from a ?message= query param so the
  // quote calculators can hand off "Send via contact form" with the
  // generated quote text already typed in.
  if (form) {
    const params = new URLSearchParams(window.location.search);
    const prefill = params.get("message");
    if (prefill) {
      const ta = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
      if (ta) ta.value = prefill;
    }
  }

  const fileInput = document.querySelector<HTMLInputElement>("[data-contact-files]");
  const dropzone = document.querySelector<HTMLLabelElement>("[data-contact-dropzone]");
  const fileList = document.querySelector<HTMLUListElement>("[data-contact-file-list]");
  const submitBtn = document.querySelector<HTMLButtonElement>("[data-contact-submit]");
  const hint = document.querySelector<HTMLElement>("[data-contact-hint]");
  const success = document.querySelector<HTMLElement>("[data-contact-success]");
  const successDetail = document.querySelector<HTMLElement>("[data-contact-success-detail]");
  const phoneFieldEl = document.querySelector<HTMLElement>("[data-show-when='phone-or-whatsapp']");
  const emailFieldEl = document.querySelector<HTMLElement>("[data-show-when='email']");
  const phoneInput = document.querySelector<HTMLInputElement>("[data-contact-phone]");
  const emailInput = document.querySelector<HTMLInputElement>("[data-contact-email]");
  const phoneLabelSpan = document.querySelector<HTMLElement>("[data-contact-phone-label]");

  // We accumulate selections so users can drop files in multiple goes.
  const selectedFiles: File[] = [];

  function syncPreference() {
    const pref = (
      document.querySelector<HTMLInputElement>(
        "input[name='preferred_contact']:checked",
      )?.value ?? ""
    ) as "" | "whatsapp" | "phone" | "email";
    const showPhone = pref === "whatsapp" || pref === "phone";
    const showEmail = pref === "email";
    if (phoneFieldEl) phoneFieldEl.hidden = !showPhone;
    if (emailFieldEl) emailFieldEl.hidden = !showEmail;
    if (phoneInput) phoneInput.required = showPhone;
    if (emailInput) emailInput.required = showEmail;
    if (phoneLabelSpan) {
      phoneLabelSpan.textContent =
        pref === "whatsapp" ? "WhatsApp number" : "Phone number";
    }
  }
  document
    .querySelectorAll<HTMLInputElement>("input[name='preferred_contact']")
    .forEach((r) => r.addEventListener("change", syncPreference));
  syncPreference();

  function fmtBytes(n: number): string {
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(0)} KB`;
    return `${(n / (1024 * 1024)).toFixed(1)} MB`;
  }

  function validateFile(f: File): string | null {
    if (!ALLOWED.has(f.type) && !/\.(jpe?g|png|heic|pdf)$/i.test(f.name)) {
      return "Unsupported file type";
    }
    if (f.size > MAX_BYTES) return "Over 10 MB";
    return null;
  }

  function renderFiles() {
    if (!fileList) return;
    fileList.innerHTML = "";
    selectedFiles.forEach((f, idx) => {
      const li = document.createElement("li");
      const err = validateFile(f);
      if (err) li.classList.add("is-error");
      const left = document.createElement("span");
      left.textContent = err ? `${f.name} — ${err}` : `${f.name} · ${fmtBytes(f.size)}`;
      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Remove";
      remove.addEventListener("click", () => {
        selectedFiles.splice(idx, 1);
        renderFiles();
      });
      li.append(left, remove);
      fileList.appendChild(li);
    });
  }

  function addFiles(files: FileList | File[]) {
    for (const f of Array.from(files)) {
      if (selectedFiles.length >= MAX_FILES) {
        if (hint) {
          hint.textContent = `Maximum ${MAX_FILES} files. Remove one to add more.`;
          hint.className = "contact-form__hint contact-form__hint--err";
        }
        break;
      }
      selectedFiles.push(f);
    }
    renderFiles();
  }

  fileInput?.addEventListener("change", () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = "";
  });

  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("is-dragover");
  });
  dropzone?.addEventListener("dragleave", () => dropzone.classList.remove("is-dragover"));
  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("is-dragover");
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !hint) return;

    // Pre-flight validations
    const fd = new FormData(form);
    const name = String(fd.get("name") ?? "").trim();
    const pref = String(fd.get("preferred_contact") ?? "").trim();
    const email = String(fd.get("email") ?? "").trim();
    const phone = String(fd.get("phone") ?? "").trim();
    const message = String(fd.get("message") ?? "").trim();

    if (!name) return setHint("Please tell us your name.", true);
    if (!pref) return setHint("Pick a contact preference so we know how to reach you.", true);
    if (pref === "email") {
      if (!email || !/.+@.+\..+/.test(email)) return setHint("Please enter a valid email.", true);
    } else {
      if (!phone || phone.replace(/\D/g, "").length < 6) {
        return setHint("Please enter a phone number we can reach you on.", true);
      }
    }
    if (!message) return setHint("Please add a message.", true);

    for (const f of selectedFiles) {
      const err = validateFile(f);
      if (err) return setHint(`${f.name}: ${err}`, true);
    }

    // Replace the file input contents with our accumulated list, so the
    // server receives exactly the files we've shown the user.
    const dt = new DataTransfer();
    for (const f of selectedFiles) dt.items.add(f);
    if (fileInput) fileInput.files = dt.files;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
    setHint("");

    try {
      const formData = new FormData(form);
      const res = await fetch("/api/contact", { method: "POST", body: formData });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        setHint(data?.error ?? `Could not send (${res.status}). Please try again or WhatsApp us.`, true);
        submitBtn.disabled = false;
        submitBtn.textContent = "Send message";
        // Reset Turnstile if present so they can retry.
        const ts = (window as any).turnstile;
        if (ts && typeof ts.reset === "function") ts.reset();
        return;
      }

      // Success — swap the form for the thanks panel.
      form.hidden = true;
      if (success) success.hidden = false;
      if (successDetail && data.attachmentCount > 0) {
        successDetail.textContent = `${data.attachmentCount} file${data.attachmentCount === 1 ? "" : "s"} attached.`;
      }
      window.scrollTo({ top: form.offsetTop - 80, behavior: "smooth" });
    } catch (err) {
      setHint("Network error. Please try again or WhatsApp us.", true);
      submitBtn.disabled = false;
      submitBtn.textContent = "Send message";
    }
  });

  function setHint(msg: string, isError = false) {
    if (!hint) return;
    hint.textContent = msg;
    hint.className = isError
      ? "contact-form__hint contact-form__hint--err"
      : "contact-form__hint";
  }
</script>
