---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

const options = [
  {
    id: "a",
    name: "A · Studio-mark wordmark",
    blurb: "Pure typography. Lora serif with a hairline gold rule and small caps beneath. Reads as gallery / atelier — premium, calm, traditional. No symbol, so the favicon would be a simplified \"fa\" tile or just the rule.",
  },
  {
    id: "b",
    name: 'B · "fap" letter-mark + wordmark',
    blurb: "Compact petrol tile with a serif italic \"fap\" inside and a thin gold inset stroke. The tile works as a favicon at any size; the wordmark sits beside it in headers. Modern but with a craft feel.",
  },
  {
    id: "c",
    name: "C · Frame-within-frame mark + wordmark",
    blurb: "Two nested squares — petrol outer frame, gold inner mat. Reads as both \"picture framing\" and \"a fine printed thing\" without being literal. Most flexible mark for tiny / monochrome uses (favicon, embossing, watermarks).",
  },
];
---
<BaseLayout title="Logo preview · Fine Art Printing" description="Logo direction sketches">
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-16">
      <h1 class="font-serif text-[clamp(1.8rem,3.5vw,2.4rem)] font-medium text-ink">Logo direction sketches</h1>
      <p class="mt-4 max-w-[640px] text-[15px] leading-relaxed text-subtle">
        Three rough cuts. Picked one? Tell me which letter and any tweaks
        (colour, weight, copy under the wordmark, etc.) and I'll polish it
        and wire it through the navbar, favicon, footer, and emails.
      </p>

      <div class="mt-12 grid gap-12">
        {options.map((opt) => (
          <article class="border-t border-border-soft pt-10">
            <h2 class="font-serif text-[20px] font-medium text-ink">{opt.name}</h2>
            <p class="mt-2 max-w-[720px] text-[14px] leading-relaxed text-subtle">{opt.blurb}</p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Header size (~1×)</p>
                <div class="mt-3 rounded-card border border-border-soft bg-white p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="320" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">On dark</p>
                <div class="mt-3 rounded-card border border-border-soft bg-petrol p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="320" style="filter:invert(1) hue-rotate(180deg);" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Larger (~1.5×)</p>
                <div class="mt-3 rounded-card border border-border-soft bg-white p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="480" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Tiny (~0.5×) — for favicon feel</p>
                <div class="mt-3 rounded-card border border-border-soft bg-[#FAF7F1] p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="160" />
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 border-t border-border-soft pt-10 max-w-[820px]">
        <h2 class="font-serif text-[20px] font-medium text-ink">Want a different direction?</h2>
        <ul class="mt-4 list-disc pl-5 text-[14.5px] leading-relaxed text-subtle space-y-2">
          <li>Stamp / seal style (circular badge with text wrapped around)</li>
          <li>Just initials "FAP" with no wordmark, like a fashion-house monogram</li>
          <li>A subtle paper-fold corner mark</li>
          <li>Different colourway — drop the gold, lean fully petrol/ink, or add a different accent</li>
          <li>Drop "Singapore" / "Print · Stretch · Frame" / "Studio" subtitles entirely for a cleaner mark</li>
        </ul>
        <p class="mt-6 text-[14px] text-subtle">Anything else — tell me roughly what you want and I'll iterate.</p>
      </div>
    </div>
  </section>
</BaseLayout>
