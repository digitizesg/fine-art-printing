---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

const variants = [
  {
    id: "c1",
    name: "C1 · Clean wordmark",
    blurb: "The original C with the subtitle removed and proportions tightened. Most restrained — leans into the wordmark.",
  },
  {
    id: "c2",
    name: "C2 · Asymmetric mat",
    blurb: "Inner mat offset slightly toward the bottom-right, the way real picture-framing mats sit (bottom edge wider than top). Adds personality without being literal.",
  },
  {
    id: "c3",
    name: "C3 · Stacked / centred",
    blurb: "Mark above, wordmark below, centred. Square aspect ratio works for Instagram avatars, business cards, watermarks.",
  },
  {
    id: "c4",
    name: "C4 · Solid frame",
    blurb: "Outer petrol square is solid (filled) instead of outlined, with a hollow gold mat inside. Reads heavier and holds up better at small sizes.",
  },
  {
    id: "c5",
    name: "C5 · Mono petrol (no gold)",
    blurb: "Drop the gold accent entirely; both squares in petrol with the inner one at lower opacity for hierarchy. Most minimalist; best for embossing, mono contexts.",
  },
];
---
<BaseLayout title="Logo preview · Fine Art Printing" description="Frame-mark variants">
  <section class="bg-white">
    <div class="mx-auto max-w-[1180px] px-6 py-16">
      <h1 class="font-serif text-[clamp(1.8rem,3.5vw,2.4rem)] font-medium text-ink">Frame-mark variants</h1>
      <p class="mt-4 max-w-[640px] text-[15px] leading-relaxed text-subtle">
        Iterating on the nested-square frame direction. Pick a letter
        (e.g. "C2") and any tweaks — colour shift, stroke weight, drop
        the wordmark italics, etc. — and I'll polish + wire it through
        the navbar, favicon, footer, and order emails.
      </p>

      <div class="mt-12 grid gap-12">
        {variants.map((opt) => (
          <article class="border-t border-border-soft pt-10">
            <h2 class="font-serif text-[20px] font-medium text-ink">{opt.name}</h2>
            <p class="mt-2 max-w-[720px] text-[14px] leading-relaxed text-subtle">{opt.blurb}</p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Header size</p>
                <div class="mt-3 rounded-card border border-border-soft bg-white p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="320" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">On dark</p>
                <div class="mt-3 rounded-card border border-border-soft bg-petrol p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="320" style="filter:invert(1) hue-rotate(180deg);" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Larger (~1.5×)</p>
                <div class="mt-3 rounded-card border border-border-soft bg-white p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="480" />
                </div>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted">Tiny (favicon-feel)</p>
                <div class="mt-3 rounded-card border border-border-soft bg-[#FAF7F1] p-6 flex items-center justify-center min-h-[120px]">
                  <img src={`/logos/option-${opt.id}.svg`} alt={opt.name} width="160" />
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 border-t border-border-soft pt-10 max-w-[820px]">
        <h2 class="font-serif text-[20px] font-medium text-ink">Want to push it further?</h2>
        <ul class="mt-4 list-disc pl-5 text-[14.5px] leading-relaxed text-subtle space-y-2">
          <li>Drop the wordmark — keep just the mark with no text alongside</li>
          <li>Round the corners more (softer feel) or square them off entirely (more architectural)</li>
          <li>Different accent — copper / olive / blush instead of gold</li>
          <li>Add a tiny ornament inside the inner mat — a dot, a serif "F", a tick</li>
          <li>Combine: solid C4 frame at the favicon size, outlined C1 in the navbar</li>
        </ul>
        <p class="mt-6 text-[14px] text-subtle">Tell me which variant feels closest and what tweak (if any) and I'll iterate.</p>
      </div>
    </div>
  </section>
</BaseLayout>
