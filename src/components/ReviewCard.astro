---
import Stars from "./Stars.astro";
import { getInitials } from "../lib/initials";
import { formatDistanceToNow } from "date-fns";

interface Props {
  review: {
    author_name: string;
    author_url: string;
    profile_photo_url: string | null;
    rating: number;
    relative_time_description?: string;
    text: string;
    time: number; // unix seconds
  };
}

const { review } = Astro.props;
const initials = getInitials(review.author_name);
const dateFromTime = review.time
  ? formatDistanceToNow(new Date(review.time * 1000), { addSuffix: true })
  : review.relative_time_description ?? "";
---
<article class="flex h-full flex-col rounded-card border border-border-soft p-6">
  <header class="flex items-center gap-3">
    {review.profile_photo_url ? (
      <img
        src={review.profile_photo_url}
        alt=""
        class="h-10 w-10 rounded-full object-cover"
        loading="lazy"
        referrerpolicy="no-referrer"
      />
    ) : (
      <span
        aria-hidden="true"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-black/[0.06] text-[13.5px] font-semibold text-muted"
      >
        {initials}
      </span>
    )}
    <div class="min-w-0 flex-1">
      <p class="truncate text-[15.5px] font-semibold text-ink">
        {review.author_name}
      </p>
      <p class="text-[13.5px] text-subtle">{dateFromTime}</p>
    </div>
  </header>

  <Stars rating={review.rating} size={22} class="mt-4" />

  <p class="review-text mt-3 text-[15.5px] leading-relaxed text-ink/90" data-review-text>
    {review.text}
  </p>
  <button type="button" class="review-more mt-2 self-start text-[15px] font-semibold text-petrol hover:underline" data-review-more hidden aria-expanded="false">
    Read more
  </button>

  <a
    href={review.author_url}
    target="_blank"
    rel="noopener nofollow"
    class="mt-auto pt-5 text-[13.5px] text-muted hover:text-ink"
  >
    View on Google →
  </a>
</article>

<style>
  /* Every review shows the same six lines so the grid stays even; longer
     ones get a "Read more" toggle (added by the script below only when the
     text actually overflows). */
  .review-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }
  .review-text.is-open {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }
</style>

<script>
  function setUpReviews() {
    document.querySelectorAll<HTMLElement>("[data-review-text]").forEach((text) => {
      const btn = text.nextElementSibling as HTMLButtonElement | null;
      if (!btn || btn.dataset.ready) return;
      btn.dataset.ready = "1";
      if (text.scrollHeight <= text.clientHeight + 2) return;
      btn.hidden = false;
      btn.addEventListener("click", () => {
        const open = text.classList.toggle("is-open");
        btn.textContent = open ? "Show less" : "Read more";
        btn.setAttribute("aria-expanded", String(open));
      });
    });
  }
  setUpReviews();
</script>
