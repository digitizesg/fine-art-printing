---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, description, href, image, imageAlt = "" } = Astro.props;
---
<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-card border border-border-soft bg-white transition-colors duration-200 hover:border-petrol/40"
>
  <div class="relative aspect-square w-full overflow-hidden bg-[#F4EFE7]">
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        width={828}
        widths={[384, 480, 640, 828]}
        sizes="(min-width: 1024px) 364px, (min-width: 640px) calc(50vw - 34px), calc(100vw - 48px)"
        quality={75}
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-[15px] uppercase tracking-wide text-muted/50">
        {title}
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-serif text-[20px] font-medium leading-snug text-ink">
      {title}
    </h3>
    <p class="mt-2 text-[15.5px] leading-relaxed text-muted">
      {description}
    </p>
    <span class="mt-5 text-[15px] font-semibold text-petrol">
      Learn more →
    </span>
  </div>
</a>
