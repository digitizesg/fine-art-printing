---
/**
 * Google Tag Manager (container GTM-WRHWRQV).
 *
 * All tags — Google Analytics (property G-STWP6D4WXE, configured inside the
 * container as "GA4 Main Tag"), conversion tracking, etc. — are managed in
 * the GTM container, not in this codebase. This renders the GTM <head>
 * snippet; the matching <noscript> fallback lives right after <body> in
 * BaseLayout.astro (GTM needs both parts).
 *
 * Consent Mode v2 default is set BEFORE GTM loads so its tags respect it:
 * analytics/functionality/security and the advertising categories are all
 * granted, so Google Ads conversion tracking can attribute conversions.
 * No cookie banner is shown.
 *
 * Only loads on production builds so localhost / dev traffic doesn't pollute
 * analytics. Loaded from BaseLayout only, so the admin area is untracked.
 */
const GTM_ID = "GTM-WRHWRQV";
const isProd = import.meta.env.PROD;
---
{isProd && (
  <>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
        functionality_storage: 'granted',
        security_storage: 'granted',
      });
    </script>
    <script is:inline define:vars={{ GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
  </>
)}
