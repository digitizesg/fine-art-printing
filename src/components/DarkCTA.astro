---
import Button from "./Button.astro";
import { business } from "../data/business";

const mapsHref = `https://www.google.com/maps/place/?q=place_id:${business.placeId}`;
const telHref = `tel:${business.phone.replace(/\s+/g, "")}`;
const waHref = `${business.whatsappLink}?text=${encodeURIComponent("Hi Fine Art Printing, I'd like a quick quote.")}`;
---
<section class="dark-cta">
  <div class="dark-cta__inner">
    <div class="dark-cta__grid">
      <!-- Action column -->
      <div class="dark-cta__action">
        <p class="dark-cta__eyebrow">Ready when you are</p>
        <h2 class="dark-cta__title">
          Send us your file,
          <span class="dark-cta__title-em">or come visit.</span>
        </h2>
        <p class="dark-cta__sub">
          We'll file-check, confirm the price in writing, and get back
          to you the same working day.
        </p>
        <div class="dark-cta__buttons">
          <Button href="/contact" variant="white">
            Get a quote <span aria-hidden="true">→</span>
          </Button>
          <Button href={waHref} variant="outlineLight">
            WhatsApp us
          </Button>
        </div>
        <p class="dark-cta__phone">
          Prefer to call?
          <a href={telHref}>{business.phone}</a>
        </p>
      </div>

      <!-- Visit teaser -->
      <div class="dark-cta__visit">
        <p class="dark-cta__eyebrow">Walk-ins welcome</p>
        <p class="dark-cta__visit-line">
          The studio is in <span class="dark-cta__visit-place">Lower Delta</span>,
          10 minutes from Tiong Bahru MRT, with ample parking on-site.
          Drop by during opening hours to see proofs, sample papers and
          canvases, or pick a frame.
        </p>
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener"
          class="dark-cta__maps-link"
        >
          Open in Google Maps <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .dark-cta {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(60% 80% at 100% 0%, rgba(217, 179, 108, 0.10), transparent 60%),
      radial-gradient(50% 80% at 0% 100%, rgba(217, 179, 108, 0.06), transparent 60%),
      var(--color-petrol);
  }
  .dark-cta::before,
  .dark-cta::after {
    content: "";
    position: absolute;
    background: rgba(217, 179, 108, 0.35);
    pointer-events: none;
  }
  /* Hairline at the top of the section, gold accent */
  .dark-cta::before {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(140px, 30%);
    height: 1px;
  }
  /* Small gold corner mark, bottom-right */
  .dark-cta::after {
    bottom: 28px;
    right: 28px;
    width: 28px;
    height: 1px;
  }
  .dark-cta__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) 24px;
  }
  .dark-cta__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 820px) {
    .dark-cta__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 0;
      align-items: start;
    }
    .dark-cta__visit {
      padding-left: 56px;
      margin-left: 56px;
      border-left: 1px solid rgba(255, 255, 255, 0.10);
    }
  }
  .dark-cta__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .dark-cta__title {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.5rem);
    line-height: 1.1;
  }
  .dark-cta__title-em {
    display: block;
    color: var(--color-gold, #D9B36C);
    font-style: italic;
    font-weight: 400;
  }
  .dark-cta__sub {
    margin: 18px 0 0;
    max-width: 44ch;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
  }
  .dark-cta__buttons {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .dark-cta__phone {
    margin: 22px 0 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }
  .dark-cta__phone a {
    margin-left: 6px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 1px;
    transition: border-color 150ms ease-out;
  }
  .dark-cta__phone a:hover {
    border-color: var(--color-gold, #D9B36C);
  }
  .dark-cta__visit-line {
    margin: 18px 0 0;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }
  .dark-cta__visit-place {
    color: #fff;
    font-weight: 500;
  }
  .dark-cta__maps-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    color: var(--color-gold, #D9B36C);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-bottom: 1px solid rgba(217, 179, 108, 0.30);
    padding-bottom: 2px;
    transition: border-color 150ms ease-out;
  }
  .dark-cta__maps-link:hover {
    border-color: var(--color-gold, #D9B36C);
  }
</style>
