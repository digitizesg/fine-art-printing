---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
---
<section class="bg-petrol text-white">
  <div class="mx-auto max-w-[1180px] px-6 py-20 text-center">
    <Eyebrow class="!text-white/70">Ready when you are</Eyebrow>
    <h2 class="mt-3 font-serif text-[clamp(2rem,4vw,2.5rem)] font-medium leading-tight">
      Send us your file,
      <span class="block italic text-gold">or come visit.</span>
    </h2>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href="/contact" variant="white">
        Get a quote <span aria-hidden="true">→</span>
      </Button>
      <Button href="https://wa.me/6591234567" variant="outlineLight">
        WhatsApp us
      </Button>
    </div>
  </div>
</section>
