---
import Eyebrow from "./Eyebrow.astro";
import DisplayHeading from "./DisplayHeading.astro";
import LiveFromGooglePill from "./LiveFromGooglePill.astro";
import ReviewCard from "./ReviewCard.astro";
import Stars from "./Stars.astro";
import reviewsData from "../data/reviews.json";
import featuredData from "../data/featured-reviews.json";
import { business } from "../data/business";

// Aggregate stats (rating, userRatingsTotal) reflect every review on Google
// and refresh on every deploy via scripts/refresh-reviews.mjs.
// Featured cards are curated in src/data/featured-reviews.json so we can
// surface the strongest, most recent reviews rather than whatever Google's
// relevance ranking happens to return (Places API doesn't sort by date).
const { rating, userRatingsTotal } = reviewsData;
const cardsToShow = [...featuredData.reviews]
  .map((r) => ({
    ...r,
    profile_photo_url: r.profile_photo_url ?? null,
    time: Math.floor(new Date(r.date).getTime() / 1000),
  }))
  .sort((a, b) => b.time - a.time)
  .slice(0, 5);
---
<section class="border-t border-border-soft bg-white">
  <div class="mx-auto max-w-[1180px] px-6 py-20">
    <div class="flex items-start justify-between gap-6">
      <Eyebrow>Reviews</Eyebrow>
      <LiveFromGooglePill />
    </div>

    <div class="mt-3 max-w-[680px]">
      <DisplayHeading level={2}>
        Real reviews. From real customers.
      </DisplayHeading>
      <p class="mt-4 text-[15px] leading-relaxed text-subtle">
        Featured reviews from real Singapore customers, with our live
        Google rating below. We capture reviews the slow and genuine
        way, not 50 uploaded in the same week.
      </p>
      <p class="mt-5 flex flex-wrap items-center gap-3 text-[16px] text-ink">
        <Stars rating={rating} size={22} ariaHidden />
        <span class="font-semibold">{rating.toFixed(1)} average</span>
        <span class="text-subtle">·</span>
        <a
          href={business.googleReviewsUrl}
          target="_blank"
          rel="noopener"
          class="text-muted hover:text-ink underline-offset-2 hover:underline"
        >
          view all {userRatingsTotal} on Google →
        </a>
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {cardsToShow.map((review) => (
        <ReviewCard review={review} />
      ))}

      <a
        href={business.googleReviewsUrl}
        target="_blank"
        rel="noopener"
        class="flex flex-col items-center justify-center rounded-card border border-border-soft bg-black/[0.02] p-6 text-center transition-colors hover:bg-black/[0.04]"
      >
        <Stars rating={rating} size={24} ariaHidden />
        <p class="mt-3 font-serif text-[26px] font-medium">{rating.toFixed(1)} average</p>
        <p class="text-[14px] text-subtle">from {userRatingsTotal} Google reviews</p>
        <p class="mt-4 text-[14px] font-semibold text-petrol">
          Read all on Google →
        </p>
      </a>
    </div>
  </div>
</section>
