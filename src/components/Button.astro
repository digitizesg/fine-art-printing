---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "white" | "outlineLight";
  type?: "button" | "submit";
  class?: string;
  ariaLabel?: string;
}
const {
  href,
  variant = "primary",
  type = "button",
  class: className = "",
  ariaLabel,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-pill px-5 py-2.5 text-[14px] font-sans font-semibold transition-colors duration-150";

const variants: Record<string, string> = {
  primary:
    "bg-petrol text-white hover:bg-[#142a40] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol",
  secondary:
    "border border-border text-ink hover:bg-black/[0.03] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol",
  white:
    "bg-white text-petrol hover:bg-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
  outlineLight:
    "border border-white/40 text-white hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
};

const classes = [base, variants[variant], className];
---
{href ? (
  <a href={href} class:list={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} aria-label={ariaLabel}>
    <slot />
  </button>
)}
