---
import type { Canvas } from "../../lib/canvases";

interface Props {
  mode: "new" | "edit";
  canvas?: Canvas;
  error?: string;
  message?: string;
}
const { mode, canvas, error, message } = Astro.props;

const action = mode === "new"
  ? "/admin/canvases/new"
  : `/admin/canvases/${canvas?.id}`;

const finishes: { value: Canvas["finish"]; label: string }[] = [
  { value: "matt", label: "Matt" },
  { value: "smooth-matt", label: "Smooth matt" },
  { value: "high-gloss", label: "High gloss" },
];
---
<form class="admin-form canvas-form" method="POST" enctype="multipart/form-data" action={action}>
  {error && <p class="admin-note admin-note--err">{error}</p>}
  {message && <p class="admin-note admin-note--ok">{message}</p>}

  <section class="canvas-form__panel">
    <h3 class="canvas-form__panel-title">Identity</h3>

    <div class="admin-form__row">
      <label>
        <span>Brand</span>
        <input type="text" name="brand" required maxlength="60" value={canvas?.brand ?? ""} placeholder="Hahnemühle" />
      </label>
      <label>
        <span>Slug <em style="font-weight:400;color:#888;">(blank = auto)</em></span>
        <input type="text" name="slug" maxlength="80" pattern="[a-z0-9-]+" value={canvas?.slug ?? ""} placeholder="hahnemuhle-daguerre-canvas" />
      </label>
    </div>

    <div class="admin-form__row">
      <label>
        <span>Full name</span>
        <input type="text" name="name" required maxlength="120" value={canvas?.name ?? ""} placeholder="Hahnemühle Daguerre Canvas" />
      </label>
      <label>
        <span>Short name</span>
        <input type="text" name="short_name" required maxlength="60" value={canvas?.shortName ?? ""} placeholder="Daguerre Canvas" />
      </label>
    </div>
  </section>

  <section class="canvas-form__panel">
    <h3 class="canvas-form__panel-title">Specs</h3>

    <div class="admin-form__row">
      <label>
        <span>GSM</span>
        <input type="number" name="gsm" required min="1" max="2000" step="1" value={canvas?.gsm ?? ""} />
      </label>
      <label>
        <span>Finish</span>
        <select name="finish" required>
          {finishes.map((f) => (
            <option value={f.value} selected={canvas?.finish === f.value}>{f.label}</option>
          ))}
        </select>
      </label>
    </div>

    <div class="admin-form__row">
      <label>
        <span>Texture</span>
        <input type="text" name="texture" required maxlength="60" value={canvas?.texture ?? ""} placeholder="Fine, uniform" />
      </label>
      <label>
        <span>Tone</span>
        <input type="text" name="tone" required maxlength="60" value={canvas?.tone ?? ""} placeholder="Bright white" />
      </label>
    </div>

    <div class="admin-form__row">
      <label>
        <span>Sell price per sqm (SGD, pre-GST)</span>
        <input type="number" name="sell_price_per_sqm" required min="0" step="0.01" value={canvas?.sellPricePerSqm ?? ""} />
      </label>
      <label>
        <span>Display order</span>
        <input type="number" name="display_order" min="0" step="1" value={canvas?.displayOrder ?? 100} />
      </label>
    </div>

    <div class="admin-form__row">
      <label>
        <span>Max print width (cm)</span>
        <input type="number" name="max_print_width_cm" required min="1" step="0.01" value={canvas?.maxPrintWidthCm ?? ""} />
      </label>
      <label>
        <span>Max print length (cm)</span>
        <input type="number" name="max_print_length_cm" required min="1" step="0.01" value={canvas?.maxPrintLengthCm ?? ""} />
      </label>
    </div>

    <div class="admin-form__check-row">
      <label class="admin-form__check">
        <input type="checkbox" name="published" value="1" checked={mode === "new" ? true : canvas?.published} />
        <span>Published</span>
      </label>
      <label class="admin-form__check">
        <input type="checkbox" name="featured" value="1" checked={canvas?.featured ?? false} />
        <span>Featured (shown in calculator picker)</span>
      </label>
    </div>
  </section>

  <section class="canvas-form__panel">
    <h3 class="canvas-form__panel-title">Copy</h3>

    <label>
      <span>Blurb (one line, picker card)</span>
      <input type="text" name="blurb" required maxlength="120" value={canvas?.blurb ?? ""} placeholder="Fine, even-textured matt canvas." />
    </label>

    <label>
      <span>Description (1–2 sentences)</span>
      <textarea name="description" required maxlength="500" rows="3" placeholder="Two-line description for the showcase / picker card body.">{canvas?.description ?? ""}</textarea>
    </label>

    <label>
      <span>Long description (multi-paragraph showcase copy)</span>
      <textarea name="long_description" required maxlength="3000" rows="8" placeholder="Multi-paragraph marketing copy for the showcase panel.">{canvas?.longDescription ?? ""}</textarea>
    </label>
  </section>

  <section class="canvas-form__panel">
    <h3 class="canvas-form__panel-title">Photos</h3>

    {canvas && canvas.imageUrls.length > 0 && (
      <div class="canvas-form__photos" data-photo-grid>
        {canvas.imageUrls.map((url, i) => (
          <div class="canvas-form__photo" data-photo>
            <input type="checkbox" name="kept_images" value={canvas.images[i]} checked hidden data-photo-keep />
            <div class="canvas-form__photo-img-wrap">
              <img src={url} alt={`${canvas.shortName} ${i + 1}`} loading="lazy" />
              <span class="canvas-form__photo-badge" data-photo-primary-badge>Primary</span>
              <button type="button" class="canvas-form__photo-x" data-photo-remove aria-label="Remove photo">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <button type="button" class="canvas-form__photo-set-primary" data-photo-set-primary>
              ★ Set as primary
            </button>
            <button type="button" class="canvas-form__photo-restore" data-photo-restore hidden>↻ Restore</button>
          </div>
        ))}
      </div>
    )}

    <label>
      <span>Add photos (JPG or PNG, multiple)</span>
      <input type="file" name="image_files" accept="image/jpeg,image/png" multiple />
    </label>
    <p style="font-size:12px;color:#888;margin:6px 0 0;">
      First photo is the picker thumbnail. Additional photos appear in the showcase carousel on /print-on-canvas.
    </p>
  </section>

  <div class="admin-form__actions">
    <button type="submit" class="admin-btn">
      {mode === "new" ? "Create canvas" : "Save changes"}
    </button>
    <a href="/admin/canvases" class="admin-btn admin-btn--ghost">Cancel</a>
    {mode === "edit" && canvas && (
      <button
        type="submit"
        formaction={`/admin/canvases/${canvas.id}/delete`}
        class="admin-btn admin-btn--danger"
        data-confirm="Delete this canvas? This cannot be undone."
        style="margin-left:auto;"
      >
        Delete
      </button>
    )}
  </div>
</form>

<style is:global>
  .canvas-form {
    display: grid;
    gap: 18px;
    max-width: 920px;
  }
  .canvas-form__panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 22px;
    display: grid;
    gap: 14px;
  }
  .canvas-form__panel-title {
    margin: 0;
    font-family: "Lora", Georgia, serif;
    font-weight: 500;
    font-size: 16px;
  }
  .canvas-form__photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .canvas-form__photo {
    display: grid;
    gap: 6px;
    cursor: default;
  }
  .canvas-form__photo-img-wrap {
    position: relative;
  }
  .canvas-form__photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #f4efe7;
    display: block;
    transition: opacity 150ms;
  }
  .canvas-form__photo.is-removed img { opacity: 0.35; filter: grayscale(0.4); }
  .canvas-form__photo.is-removed .canvas-form__photo-set-primary,
  .canvas-form__photo.is-removed .canvas-form__photo-x,
  .canvas-form__photo.is-removed .canvas-form__photo-badge {
    display: none;
  }
  .canvas-form__photo-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    background: var(--admin-petrol, #1a3550);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 999px;
    display: none;
  }
  .canvas-form__photo.is-primary .canvas-form__photo-badge { display: inline-flex; }
  .canvas-form__photo.is-primary .canvas-form__photo-set-primary { display: none; }
  .admin-form .canvas-form__photo-x {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 120ms;
    line-height: 0;
  }
  .admin-form .canvas-form__photo-x:hover { background: rgba(0, 0, 0, 0.82); }
  .admin-form .canvas-form__photo-x svg {
    width: 12px;
    height: 12px;
    display: block;
  }
  .admin-form .canvas-form__photo-set-primary,
  .admin-form .canvas-form__photo-restore {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    font: inherit;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--admin-ink, #1a1a1a);
    padding: 5px 8px;
    cursor: pointer;
    transition: background 120ms, border-color 120ms;
    line-height: 1.2;
  }
  .admin-form .canvas-form__photo-set-primary:hover,
  .admin-form .canvas-form__photo-restore:hover {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.22);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-confirm]").forEach((btn) => {
    btn.addEventListener("click", (ev) => {
      const msg = btn.getAttribute("data-confirm");
      if (msg && !window.confirm(msg)) {
        ev.preventDefault();
      }
    });
  });

  // Photo grid: same promote/remove/restore UX as PaperForm.
  const grid = document.querySelector<HTMLElement>("[data-photo-grid]");
  if (grid) {
    function sync() {
      const tiles = grid!.querySelectorAll<HTMLElement>("[data-photo]");
      let primaryAssigned = false;
      tiles.forEach((tile) => {
        const removed = tile.classList.contains("is-removed");
        const isPrimary = !removed && !primaryAssigned;
        tile.classList.toggle("is-primary", isPrimary);
        if (isPrimary) primaryAssigned = true;
      });
    }
    grid.addEventListener("click", (ev) => {
      const target = ev.target as HTMLElement;
      const tile = target.closest<HTMLElement>("[data-photo]");
      if (!tile) return;

      if (target.closest("[data-photo-set-primary]")) {
        grid.prepend(tile);
        sync();
      } else if (target.closest("[data-photo-remove]")) {
        const keep = tile.querySelector<HTMLInputElement>("[data-photo-keep]");
        if (keep) keep.checked = false;
        tile.classList.add("is-removed");
        const restore = tile.querySelector<HTMLElement>("[data-photo-restore]");
        if (restore) restore.hidden = false;
        sync();
      } else if (target.closest("[data-photo-restore]")) {
        const keep = tile.querySelector<HTMLInputElement>("[data-photo-keep]");
        if (keep) keep.checked = true;
        tile.classList.remove("is-removed");
        const restore = tile.querySelector<HTMLElement>("[data-photo-restore]");
        if (restore) restore.hidden = true;
        sync();
      }
    });
    sync();
  }
</script>
