---
import {
  SERVICE_LABELS,
  SUBJECT_LABELS,
  type Service,
  type Subject,
} from "../../lib/frame-examples";
import { PICTURE_FRAME_GROUPS } from "../../data/picture-frames";
import { listFloatFrames } from "../../lib/float-frames";
import { listCanvases } from "../../lib/canvases";
import { listPapers } from "../../lib/papers";

const floatFrames = await listFloatFrames({ onlyPublished: false });
const canvases = await listCanvases({ onlyPublished: false });
const papers = await listPapers({ onlyPublished: false });

interface Props {
  mode: "new" | "edit";
  example?: {
    id: string;
    image_path: string;
    image_url: string;
    service: Service;
    subject: Subject;
    caption: string | null;
    featured: boolean;
    picture_frame_id: string | null;
    float_frame_id: string | null;
    stretching_depth: "1in" | "1.5in" | null;
    canvas_id: string | null;
    paper_id: string | null;
  };
  error?: string;
  message?: string;
}
const { mode, example, error, message } = Astro.props;

const action = mode === "new" ? "/admin/examples" : `/admin/examples/${example?.id}`;
---
<form class="admin-form admin-form--wide" method="POST" enctype="multipart/form-data" action={action}>
  <div class="admin-form__photo">
    {example?.image_url ? (
      <img src={example.image_url} alt={example.caption ?? ""} />
    ) : (
      <div style="aspect-ratio:3/2;background:#f4efe7;border:1px dashed rgba(0,0,0,0.18);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#888;font-size:13px;">
        No image yet
      </div>
    )}
    <label>
      <span>{mode === "new" ? "Image (JPG or PNG)" : "Replace image (optional)"}</span>
      <input type="file" name="image" accept="image/jpeg,image/png" required={mode === "new"} />
    </label>
  </div>

  <div class="admin-form__row">
    <label>
      <span>Service</span>
      <select name="service" required>
        {(Object.keys(SERVICE_LABELS) as Service[]).map((s) => (
          <option value={s} selected={example?.service === s}>{SERVICE_LABELS[s]}</option>
        ))}
      </select>
    </label>
    <label>
      <span>Subject</span>
      <select name="subject" required>
        {(Object.keys(SUBJECT_LABELS) as Subject[]).map((s) => (
          <option value={s} selected={example?.subject === s}>{SUBJECT_LABELS[s]}</option>
        ))}
      </select>
    </label>
  </div>

  <label>
    <span>Caption (optional, shows in lightbox)</span>
    <input type="text" name="caption" value={example?.caption ?? ""} maxlength="140" />
  </label>

  <div class="admin-form__row" data-only="custom-framing">
    <label>
      <span>Picture frame</span>
      <select name="picture_frame_id">
        <option value="" selected={!example?.picture_frame_id}>—</option>
        {PICTURE_FRAME_GROUPS.map((group) => (
          <optgroup label={group.heading}>
            {group.profiles.map((p) => (
              <option value={p.id} selected={example?.picture_frame_id === p.id}>{p.label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </label>
    <label>
      <span>Paper (if a paper print)</span>
      <select name="paper_id">
        <option value="" selected={!example?.paper_id}>—</option>
        {papers.map((p) => (
          <option value={p.slug} selected={example?.paper_id === p.slug}>{p.brand} {p.shortName}</option>
        ))}
      </select>
    </label>
  </div>

  <div data-only="canvas-printing">
    <label>
      <span>Canvas substrate</span>
      <select name="canvas_id">
        <option value="" selected={!example?.canvas_id}>—</option>
        {canvases.map((c) => (
          <option value={c.slug} selected={example?.canvas_id === c.slug}>{c.brand} {c.shortName}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="admin-form__row" data-only="canvas-printing canvas-stretching">
    <label>
      <span>Float frame</span>
      <select name="float_frame_id">
        <option value="" selected={!example?.float_frame_id}>—</option>
        {floatFrames.map((f) => (
          <option value={f.slug} selected={example?.float_frame_id === f.slug}>{f.label}</option>
        ))}
      </select>
    </label>
    <label>
      <span>Stretching depth</span>
      <select name="stretching_depth">
        <option value="" selected={!example?.stretching_depth}>—</option>
        <option value="1in" selected={example?.stretching_depth === "1in"}>1"</option>
        <option value="1.5in" selected={example?.stretching_depth === "1.5in"}>1.5"</option>
      </select>
    </label>
  </div>

  <label class="admin-form__check">
    <input type="checkbox" name="featured" value="1" checked={example?.featured} />
    <span>Featured (shows in the per-service strip on the marketing site)</span>
  </label>

  {error && <p class="admin-note admin-note--err">{error}</p>}
  {message && <p class="admin-note admin-note--ok">{message}</p>}

  <div class="admin-form__actions">
    <button type="submit" class="admin-btn">
      {mode === "new" ? "Create" : "Save changes"}
    </button>
    <a href="/admin" class="admin-btn admin-btn--ghost">Cancel</a>
    <span class="spacer"></span>
    {mode === "edit" && (
      <button type="submit" formaction={`/admin/examples/${example?.id}/delete`} class="admin-btn admin-btn--danger" data-confirm="Delete this example permanently?">
        Delete
      </button>
    )}
  </div>
</form>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-confirm]").forEach((b) => {
    b.addEventListener("click", (e) => {
      if (!confirm(b.dataset.confirm ?? "Are you sure?")) e.preventDefault();
    });
  });

  // Show/hide fields based on the selected service.
  const serviceSelect = document.querySelector<HTMLSelectElement>('select[name="service"]');
  const conditional = document.querySelectorAll<HTMLElement>("[data-only]");

  function syncServiceFields() {
    const current = serviceSelect?.value ?? "";
    conditional.forEach((el) => {
      const services = (el.dataset.only ?? "").split(/\s+/).filter(Boolean);
      el.style.display = services.includes(current) ? "" : "none";
    });
  }

  serviceSelect?.addEventListener("change", syncServiceFields);
  syncServiceFields();
</script>
