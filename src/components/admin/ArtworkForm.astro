---
interface Props {
  mode: "new" | "edit";
  artwork?: {
    id: string;
    slug: string;
    title: string;
    artist_name: string | null;
    description: string | null;
    hero_image_path: string;
    hero_image_url: string;
    gallery_images: { path: string; url: string }[];
    available_sizes: { width_cm: number; height_cm: number; label?: string }[];
    allow_paper: boolean;
    allow_canvas: boolean;
    published: boolean;
    featured: boolean;
    display_order: number;
  };
  error?: string;
  message?: string;
}
const { mode, artwork, error, message } = Astro.props;

const action = mode === "new" ? "/admin/artworks/new" : `/admin/artworks/${artwork?.id}`;
const sizesJson = JSON.stringify(artwork?.available_sizes ?? []);
const galleryJson = JSON.stringify(
  (artwork?.gallery_images ?? []).map((g) => g.path),
);
---
<form class="artwork-form" method="POST" enctype="multipart/form-data" action={action}>
  <!-- Image card -->
  <section class="artwork-form__panel">
    <h2 class="artwork-form__panel-title">Hero image</h2>
    <div class="artwork-form__image-row">
      <div class="artwork-form__preview">
        {artwork?.hero_image_url ? (
          <img src={artwork.hero_image_url} alt={artwork.title} data-hero-current-img />
        ) : (
          <div class="artwork-form__preview-empty" data-hero-empty>No image yet</div>
        )}
      </div>
      <div class="artwork-form__upload">
        <label class="dropzone" data-dropzone data-dropzone-mode="single">
          <input
            type="file"
            name="image"
            accept="image/jpeg,image/png"
            required={mode === "new"}
            data-dropzone-input
          />
          <span class="dropzone__hint" data-dropzone-hint>
            <strong>{mode === "new" ? "Drop or click to upload" : "Drop or click to replace"}</strong>
            <small>JPG or PNG, up to 25 MB</small>
          </span>
        </label>
        <p class="artwork-form__hint">
          This is the preview shown on /shop. The high-res print master lives separately on Dropbox — not uploaded here.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery card -->
  <section class="artwork-form__panel">
    <h2 class="artwork-form__panel-title">Gallery images (optional)</h2>
    <p class="artwork-form__hint" style="margin-top:-4px;">
      Additional photos shown alongside the hero on the artwork page. Customers can click any to open a lightbox.
    </p>
    <div class="artwork-gallery" data-artwork-gallery>
      <div class="artwork-gallery__list" data-artwork-gallery-list>
        {(artwork?.gallery_images ?? []).map((g) => (
          <div class="artwork-gallery__tile" data-gallery-path={g.path}>
            <img src={g.url} alt="" loading="lazy" />
            <button type="button" class="artwork-gallery__remove" data-gallery-remove aria-label="Remove">×</button>
          </div>
        ))}
      </div>
      <input type="hidden" name="kept_gallery" data-artwork-gallery-json value={galleryJson} />
    </div>
    <label class="dropzone" data-dropzone data-dropzone-mode="multi">
      <input
        type="file"
        name="gallery_files"
        accept="image/jpeg,image/png"
        multiple
        data-dropzone-input
      />
      <span class="dropzone__hint">
        <strong>Drop images here, or click to browse</strong>
        <small>You can drop multiple at once · JPG or PNG, up to 25 MB each</small>
      </span>
    </label>
    <div class="dropzone__staged" data-dropzone-staged></div>
  </section>

  <!-- Detail card -->
  <section class="artwork-form__panel">
    <h2 class="artwork-form__panel-title">Details</h2>
    <label class="artwork-form__field">
      <span>Title</span>
      <input type="text" name="title" value={artwork?.title ?? ""} required maxlength="160" />
    </label>
    <div class="artwork-form__row">
      <label class="artwork-form__field">
        <span>Slug (URL — letters, numbers, hyphens)</span>
        <input type="text" name="slug" value={artwork?.slug ?? ""} pattern="[a-z0-9-]+" placeholder="auto-generated from title if blank" />
      </label>
      <label class="artwork-form__field">
        <span>Artist name</span>
        <input type="text" name="artist_name" value={artwork?.artist_name ?? ""} maxlength="120" />
      </label>
    </div>
    <label class="artwork-form__field">
      <span>Description</span>
      <textarea name="description" maxlength="1200" rows="4">{artwork?.description ?? ""}</textarea>
    </label>
  </section>

  <!-- Sizes card -->
  <section class="artwork-form__panel">
    <h2 class="artwork-form__panel-title">Available sizes</h2>
    <p class="artwork-form__hint" style="margin-top:-4px;margin-bottom:10px;">
      Sizes are in centimetres. Add the dimensions you want to offer for this artwork.
    </p>
    <div class="artwork-sizes" data-artwork-sizes>
      <div class="artwork-sizes__list" data-artwork-sizes-list></div>
      <button type="button" class="artwork-form__add-size" data-artwork-add-size>+ Add size</button>
      <input type="hidden" name="available_sizes" data-artwork-sizes-json value={sizesJson} />
    </div>
  </section>

  <!-- Substrate + visibility card -->
  <section class="artwork-form__panel">
    <h2 class="artwork-form__panel-title">Substrate &amp; visibility</h2>
    <div class="artwork-form__checks">
      <label class="artwork-form__check">
        <input type="checkbox" name="allow_paper" value="1" checked={artwork?.allow_paper ?? true} />
        <span>Available on paper</span>
      </label>
      <label class="artwork-form__check">
        <input type="checkbox" name="allow_canvas" value="1" checked={artwork?.allow_canvas ?? false} />
        <span>Available on canvas</span>
      </label>
      <label class="artwork-form__check">
        <input type="checkbox" name="published" value="1" checked={artwork?.published ?? false} />
        <span>Published (visible in /shop)</span>
      </label>
      <label class="artwork-form__check">
        <input type="checkbox" name="featured" value="1" checked={artwork?.featured ?? false} />
        <span>Featured</span>
      </label>
    </div>
  </section>

  {error && <p class="admin-note admin-note--err">{error}</p>}
  {message && <p class="admin-note admin-note--ok">{message}</p>}

  <div class="artwork-form__actions">
    <button type="submit" class="admin-btn">{mode === "new" ? "Create" : "Save changes"}</button>
    <a href="/admin/artworks" class="admin-btn admin-btn--ghost">Cancel</a>
    {mode === "edit" && (
      <button type="submit" formaction={`/admin/artworks/${artwork?.id}/delete`} class="admin-btn admin-btn--danger" data-confirm="Delete this artwork permanently?" style="margin-left:auto;">
        Delete
      </button>
    )}
  </div>
</form>

<style is:global>
  .artwork-form {
    display: grid;
    gap: 18px;
    max-width: 920px;
  }
  .artwork-form__panel {
    background: var(--admin-panel);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    padding: 22px;
    display: grid;
    gap: 14px;
  }
  .artwork-form__panel-title {
    margin: 0;
    font-family: "Lora", Georgia, serif;
    font-weight: 500;
    font-size: 16px;
    color: var(--admin-ink);
  }
  .artwork-form__field {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: var(--admin-muted);
  }
  .artwork-form__field input,
  .artwork-form__field textarea {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--admin-border-strong);
    border-radius: 8px;
    background: #fff;
    color: var(--admin-ink);
    width: 100%;
  }
  .artwork-form__field input:focus,
  .artwork-form__field textarea:focus {
    outline: 2px solid var(--admin-petrol);
    outline-offset: 0;
    border-color: var(--admin-petrol);
  }
  .artwork-form__field textarea {
    resize: vertical;
    min-height: 90px;
  }
  .artwork-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 600px) {
    .artwork-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .artwork-form__image-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .artwork-form__image-row {
      grid-template-columns: 240px 1fr;
      align-items: start;
    }
  }
  .artwork-form__preview {
    aspect-ratio: 4 / 5;
    background: #f4efe7;
    border: 1px solid var(--admin-border);
    border-radius: 10px;
    overflow: hidden;
  }
  .artwork-form__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .artwork-form__preview-empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 13px;
  }
  .artwork-form__upload {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .artwork-form__upload label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: var(--admin-muted);
  }
  .artwork-form__upload input[type="file"] {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--admin-border-strong);
    border-radius: 8px;
    background: #fff;
    width: 100%;
  }
  .artwork-form__hint {
    margin: 0;
    font-size: 12.5px;
    color: var(--admin-subtle);
    line-height: 1.5;
  }

  /* Dropzone — used for both hero (single) and gallery (multi). */
  .dropzone {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px 18px;
    border: 2px dashed rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    transition: border-color 150ms ease-out, background 150ms ease-out;
  }
  .dropzone:hover,
  .dropzone:focus-within {
    border-color: var(--admin-petrol);
    background: rgba(26, 53, 80, 0.02);
  }
  .dropzone.is-dragover {
    border-color: var(--admin-petrol);
    background: rgba(26, 53, 80, 0.06);
  }
  .dropzone input[type="file"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .dropzone__hint {
    display: grid;
    gap: 4px;
    pointer-events: none;
  }
  .dropzone__hint strong {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--admin-ink);
  }
  .dropzone__hint small {
    font-size: 12px;
    color: var(--admin-subtle);
  }

  .dropzone__staged {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }
  .dropzone__staged:empty {
    display: none;
  }
  .dropzone__staged-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    background: #f4efe7;
    border: 1px solid var(--admin-border);
  }
  .dropzone__staged-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dropzone__staged-tile button {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 0;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dropzone__staged-tile button:hover {
    background: rgba(0, 0, 0, 0.85);
  }
  .dropzone__staged-tile small {
    position: absolute;
    inset: auto 0 0 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
    color: #fff;
    padding: 14px 8px 6px;
    font-size: 10.5px;
    line-height: 1.2;
    text-align: center;
    word-break: break-all;
  }

  .artwork-sizes__list {
    display: grid;
    gap: 8px;
  }
  .artwork-sizes__empty {
    margin: 0;
    padding: 14px;
    border: 1px dashed rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    color: #888;
    font-size: 13px;
  }
  .artwork-size-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr auto;
    gap: 8px;
    align-items: end;
  }
  .artwork-size-row label {
    display: grid;
    gap: 4px;
    font-size: 12px;
    color: var(--admin-muted);
    margin: 0;
  }
  .artwork-size-row input {
    font: inherit;
    padding: 9px 12px;
    border: 1px solid var(--admin-border-strong);
    border-radius: 8px;
    background: #fff;
    color: var(--admin-ink);
    width: 100%;
  }
  @media (max-width: 540px) {
    .artwork-size-row { grid-template-columns: 1fr 1fr; }
    .artwork-size-row .artwork-size-row__label { grid-column: span 2; }
    .artwork-size-row .artwork-size-row__remove { grid-column: span 2; }
  }
  .artwork-size-row__remove {
    appearance: none;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: #fff;
    color: var(--admin-danger);
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 13px;
    cursor: pointer;
    height: 38px;
    align-self: end;
  }
  .artwork-size-row__remove:hover {
    background: rgba(177, 39, 31, 0.05);
  }
  .artwork-form__add-size {
    appearance: none;
    border: 1px solid var(--admin-border-strong);
    background: #fff;
    color: var(--admin-ink);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    align-self: start;
    justify-self: start;
  }
  .artwork-form__add-size:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  .artwork-gallery__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: 12px;
  }
  .artwork-gallery__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    background: #f4efe7;
    border: 1px solid var(--admin-border);
  }
  .artwork-gallery__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .artwork-gallery__tile.is-removed {
    opacity: 0.35;
    filter: grayscale(0.7);
  }
  .artwork-gallery__remove {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 0;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .artwork-gallery__remove:hover {
    background: rgba(0, 0, 0, 0.85);
  }
  .artwork-gallery__tile.is-removed .artwork-gallery__remove::before {
    content: "↺ ";
    font-size: 12px;
  }

  .artwork-form__checks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 600px) {
    .artwork-form__checks {
      grid-template-columns: 1fr 1fr;
    }
  }
  .artwork-form__check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--admin-ink);
    margin: 0;
  }
  .artwork-form__check input {
    width: auto;
    margin: 0;
    accent-color: var(--admin-petrol);
  }

  .artwork-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
</style>

<script is:inline define:vars={{ initialSizesJson: sizesJson }}>
  (function () {
    const list = document.querySelector("[data-artwork-sizes-list]");
    const addBtn = document.querySelector("[data-artwork-add-size]");
    const hidden = document.querySelector("[data-artwork-sizes-json]");
    if (!list || !addBtn || !hidden) return;

    let sizes = [];
    try {
      sizes = JSON.parse(initialSizesJson || "[]");
    } catch {
      sizes = [];
    }
    if (!Array.isArray(sizes)) sizes = [];

    function render() {
      list.innerHTML = "";
      if (sizes.length === 0) {
        const empty = document.createElement("p");
        empty.className = "artwork-sizes__empty";
        empty.textContent = "No sizes yet. Click + Add size below.";
        list.appendChild(empty);
        return;
      }
      sizes.forEach((size, idx) => {
        const row = document.createElement("div");
        row.className = "artwork-size-row";
        row.innerHTML = `
          <label>
            <span>Width (cm)</span>
            <input type="number" min="1" step="0.1" required value="${size.width_cm ?? ""}" data-size-w />
          </label>
          <label>
            <span>Height (cm)</span>
            <input type="number" min="1" step="0.1" required value="${size.height_cm ?? ""}" data-size-h />
          </label>
          <label class="artwork-size-row__label">
            <span>Label (optional)</span>
            <input type="text" maxlength="40" value="${(size.label ?? "").replace(/"/g, "&quot;")}" data-size-label placeholder="e.g. Medium" />
          </label>
          <button type="button" class="artwork-size-row__remove" data-size-remove>Remove</button>
        `;
        const w = row.querySelector("[data-size-w]");
        const h = row.querySelector("[data-size-h]");
        const lbl = row.querySelector("[data-size-label]");
        const rm = row.querySelector("[data-size-remove]");
        const onChange = () => {
          sizes[idx] = {
            width_cm: parseFloat(w.value || "0"),
            height_cm: parseFloat(h.value || "0"),
            label: lbl.value.trim() || undefined,
          };
          syncHidden();
        };
        w.addEventListener("input", onChange);
        h.addEventListener("input", onChange);
        lbl.addEventListener("input", onChange);
        rm.addEventListener("click", () => {
          sizes.splice(idx, 1);
          render();
          syncHidden();
        });
        list.appendChild(row);
      });
    }

    function syncHidden() {
      hidden.value = JSON.stringify(sizes.filter((s) => s.width_cm > 0 && s.height_cm > 0));
    }

    addBtn.addEventListener("click", () => {
      sizes.push({ width_cm: 0, height_cm: 0 });
      render();
      syncHidden();
    });

    render();
    syncHidden();
  })();

  // Gallery: clicking the × on a tile toggles a "remove" mark; the hidden
  // kept_gallery field is the JSON list of paths the server should retain.
  (function () {
    const list = document.querySelector("[data-artwork-gallery-list]");
    const hidden = document.querySelector("[data-artwork-gallery-json]");
    if (!list || !hidden) return;
    function syncHidden() {
      const kept = Array.from(list.querySelectorAll("[data-gallery-path]"))
        .filter((el) => !el.classList.contains("is-removed"))
        .map((el) => el.getAttribute("data-gallery-path"));
      hidden.value = JSON.stringify(kept);
    }
    list.addEventListener("click", (e) => {
      const btn = e.target instanceof Element ? e.target.closest("[data-gallery-remove]") : null;
      if (!btn) return;
      const tile = btn.closest("[data-gallery-path]");
      if (!tile) return;
      tile.classList.toggle("is-removed");
      syncHidden();
    });
    syncHidden();
  })();

  // Dropzones — drag-and-drop + click-to-browse, with staged previews.
  // For "multi" zones we accumulate files across drops via DataTransfer
  // so the file input keeps the full set when the form is submitted.
  document.querySelectorAll("[data-dropzone]").forEach((zone) => {
    const input = zone.querySelector("[data-dropzone-input]");
    const mode = zone.getAttribute("data-dropzone-mode") || "single";
    const stagedEl = zone.parentElement?.querySelector("[data-dropzone-staged]");
    const heroEmpty = document.querySelector("[data-hero-empty]");
    const heroCurrentImg = document.querySelector("[data-hero-current-img]");

    function renderStaged() {
      if (!input) return;
      const files = Array.from(input.files || []);
      // For single-mode, show the staged file inline as the hero preview.
      if (mode === "single") {
        const previewWrap = zone.closest(".artwork-form__panel")?.querySelector(".artwork-form__preview");
        if (!previewWrap) return;
        // Remove any prior staged preview.
        previewWrap.querySelectorAll("[data-hero-staged]").forEach((n) => n.remove());
        if (files[0]) {
          if (heroEmpty) heroEmpty.style.display = "none";
          if (heroCurrentImg) heroCurrentImg.style.display = "none";
          const img = document.createElement("img");
          img.dataset.heroStaged = "true";
          img.src = URL.createObjectURL(files[0]);
          img.alt = files[0].name;
          previewWrap.appendChild(img);
        } else {
          if (heroEmpty) heroEmpty.style.display = "";
          if (heroCurrentImg) heroCurrentImg.style.display = "";
        }
        return;
      }
      // Multi-mode: show staged thumbs with × to remove.
      if (!stagedEl) return;
      stagedEl.innerHTML = "";
      files.forEach((file, idx) => {
        const tile = document.createElement("div");
        tile.className = "dropzone__staged-tile";
        const img = document.createElement("img");
        img.src = URL.createObjectURL(file);
        img.alt = file.name;
        tile.appendChild(img);
        const caption = document.createElement("small");
        caption.textContent = file.name;
        tile.appendChild(caption);
        const rm = document.createElement("button");
        rm.type = "button";
        rm.textContent = "×";
        rm.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const dt = new DataTransfer();
          Array.from(input.files || []).forEach((f, i) => {
            if (i !== idx) dt.items.add(f);
          });
          input.files = dt.files;
          renderStaged();
        });
        tile.appendChild(rm);
        stagedEl.appendChild(tile);
      });
    }

    function addFiles(newFiles) {
      if (!input || !newFiles.length) return;
      const dt = new DataTransfer();
      if (mode === "multi") {
        Array.from(input.files || []).forEach((f) => dt.items.add(f));
      }
      const allowed = new Set(["image/jpeg", "image/png"]);
      Array.from(newFiles).forEach((f) => {
        if (allowed.has(f.type)) dt.items.add(f);
      });
      input.files = dt.files;
      renderStaged();
    }

    input?.addEventListener("change", renderStaged);

    ["dragenter", "dragover"].forEach((ev) =>
      zone.addEventListener(ev, (e) => {
        e.preventDefault();
        zone.classList.add("is-dragover");
      })
    );
    ["dragleave", "dragend"].forEach((ev) =>
      zone.addEventListener(ev, () => zone.classList.remove("is-dragover"))
    );
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("is-dragover");
      const files = e.dataTransfer?.files;
      if (files && files.length) addFiles(files);
    });
  });

  document.querySelectorAll("button[data-confirm]").forEach((b) => {
    b.addEventListener("click", (e) => {
      if (!confirm(b.dataset.confirm ?? "Are you sure?")) e.preventDefault();
    });
  });
</script>
