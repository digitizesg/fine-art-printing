---
import type { Paper, PaperUseCase } from "../../lib/papers";

interface Props {
  mode: "new" | "edit";
  paper?: Paper;
  error?: string;
  message?: string;
}
const { mode, paper, error, message } = Astro.props;

const action = mode === "new"
  ? "/admin/papers/new"
  : `/admin/papers/${paper?.id}`;

const finishes: { value: Paper["finish"]; label: string }[] = [
  { value: "matt", label: "Matt" },
  { value: "gloss", label: "Gloss" },
  { value: "high-gloss", label: "High gloss" },
  { value: "pearl", label: "Pearl" },
  { value: "satin", label: "Satin" },
  { value: "silk-gloss", label: "Silk gloss" },
  { value: "metallic", label: "Metallic" },
];

const durabilities: { value: Paper["durability"]; label: string }[] = [
  { value: "delicate", label: "Delicate" },
  { value: "good", label: "Good" },
  { value: "high", label: "High" },
];

const useCases: { value: PaperUseCase; label: string }[] = [
  { value: "colour-photo", label: "Colour photo" },
  { value: "bw-photo", label: "B&W photo" },
  { value: "original-art", label: "Original artwork" },
  { value: "illustration", label: "Illustration" },
];
---
<form class="admin-form paper-form" method="POST" enctype="multipart/form-data" action={action}>
  {error && <p class="admin-note admin-note--err">{error}</p>}
  {message && <p class="admin-note admin-note--ok">{message}</p>}

  <section class="paper-form__panel">
    <h3 class="paper-form__panel-title">Identity</h3>
    <div class="admin-form__row">
      <label>
        <span>Brand</span>
        <input type="text" name="brand" required maxlength="60" value={paper?.brand ?? ""} placeholder="Hahnemühle" />
      </label>
      <label>
        <span>Slug <em style="font-weight:400;color:#888;">(blank = auto)</em></span>
        <input type="text" name="slug" maxlength="80" pattern="[a-z0-9-]+" value={paper?.slug ?? ""} placeholder="hahnemuhle-photo-rag" />
      </label>
    </div>
    <div class="admin-form__row">
      <label>
        <span>Full name</span>
        <input type="text" name="name" required maxlength="120" value={paper?.name ?? ""} placeholder="Hahnemühle Photo Rag" />
      </label>
      <label>
        <span>Short name</span>
        <input type="text" name="short_name" required maxlength="60" value={paper?.shortName ?? ""} placeholder="Photo Rag" />
      </label>
    </div>
  </section>

  <section class="paper-form__panel">
    <h3 class="paper-form__panel-title">Specs</h3>
    <div class="admin-form__row">
      <label>
        <span>GSM</span>
        <input type="number" name="gsm" required min="1" max="2000" step="1" value={paper?.gsm ?? ""} />
      </label>
      <label>
        <span>Finish</span>
        <select name="finish" required>
          {finishes.map((f) => (
            <option value={f.value} selected={paper?.finish === f.value}>{f.label}</option>
          ))}
        </select>
      </label>
    </div>
    <div class="admin-form__row">
      <label>
        <span>Tone</span>
        <input type="text" name="tone" required maxlength="60" value={paper?.tone ?? ""} placeholder="Natural white" />
      </label>
      <label>
        <span>Texture</span>
        <input type="text" name="texture" required maxlength="60" value={paper?.texture ?? ""} placeholder="Smooth" />
      </label>
    </div>
    <div class="admin-form__row">
      <label>
        <span>Durability</span>
        <select name="durability" required>
          {durabilities.map((d) => (
            <option value={d.value} selected={paper?.durability === d.value}>{d.label}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Sell price per sqm (SGD, pre-GST)</span>
        <input type="number" name="sell_price_per_sqm" required min="0" step="0.01" value={paper?.sellPricePerSqm ?? ""} />
      </label>
    </div>
    <div class="admin-form__row">
      <label>
        <span>Max print width (cm)</span>
        <input type="number" name="max_print_width_cm" required min="1" step="0.01" value={paper?.maxPrintWidthCm ?? ""} />
      </label>
      <label>
        <span>Max print length (cm)</span>
        <input type="number" name="max_print_length_cm" required min="1" step="0.01" value={paper?.maxPrintLengthCm ?? ""} />
      </label>
    </div>
    <div class="admin-form__row">
      <label>
        <span>Display order</span>
        <input type="number" name="display_order" min="0" step="1" value={paper?.displayOrder ?? 100} />
      </label>
      <div class="admin-form__check-row" style="align-items:center;">
        <label class="admin-form__check">
          <input type="checkbox" name="published" value="1" checked={mode === "new" ? true : paper?.published} />
          <span>Published</span>
        </label>
        <label class="admin-form__check">
          <input type="checkbox" name="featured" value="1" checked={paper?.featured ?? false} />
          <span>Featured (calculator picker)</span>
        </label>
      </div>
    </div>

    <div>
      <span style="font-size:13px;color:#555;">Best for</span>
      <div class="admin-form__check-row" style="margin-top:6px;">
        {useCases.map((u) => (
          <label class="admin-form__check">
            <input
              type="checkbox"
              name="best_for"
              value={u.value}
              checked={paper?.bestFor.includes(u.value) ?? false}
            />
            <span>{u.label}</span>
          </label>
        ))}
      </div>
    </div>
  </section>

  <section class="paper-form__panel">
    <h3 class="paper-form__panel-title">Copy</h3>
    <label>
      <span>Blurb (one line, picker card)</span>
      <input type="text" name="blurb" required maxlength="120" value={paper?.blurb ?? ""} placeholder="Archival 100% cotton, smooth super-matt." />
    </label>
    <label>
      <span>Description (1–2 sentences)</span>
      <textarea name="description" required maxlength="500" rows="3">{paper?.description ?? ""}</textarea>
    </label>
    <label>
      <span>Long description (multi-paragraph showcase copy)</span>
      <textarea name="long_description" required maxlength="3000" rows="8">{paper?.longDescription ?? ""}</textarea>
    </label>
  </section>

  <section class="paper-form__panel">
    <h3 class="paper-form__panel-title">Photos</h3>
    {paper && paper.imageUrls.length > 0 && (
      <div class="paper-form__photos" data-photo-grid>
        {paper.imageUrls.map((url, i) => (
          <div class="paper-form__photo" data-photo>
            <input type="checkbox" name="kept_images" value={paper.images[i]} checked hidden data-photo-keep />
            <div class="paper-form__photo-img-wrap">
              <img src={url} alt={`${paper.shortName} ${i + 1}`} loading="lazy" />
              <span class="paper-form__photo-badge" data-photo-primary-badge>Primary</span>
              <button type="button" class="paper-form__photo-x" data-photo-remove aria-label="Remove photo">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <button type="button" class="paper-form__photo-set-primary" data-photo-set-primary>
              ★ Set as primary
            </button>
            <button type="button" class="paper-form__photo-restore" data-photo-restore hidden>↻ Restore</button>
          </div>
        ))}
      </div>
    )}
    <label>
      <span>Add photos (JPG or PNG, multiple)</span>
      <input type="file" name="image_files" accept="image/jpeg,image/png" multiple />
    </label>
    <p style="font-size:12px;color:#888;margin:6px 0 0;">
      The <strong>primary</strong> photo (first tile) is the picker swatch and showcase hero on /print-on-paper. Click <em>★ Set as primary</em> on any other photo to swap it in.
    </p>
  </section>

  <div class="admin-form__actions">
    <button type="submit" class="admin-btn">
      {mode === "new" ? "Create paper" : "Save changes"}
    </button>
    <a href="/admin/papers" class="admin-btn admin-btn--ghost">Cancel</a>
    {mode === "edit" && paper && (
      <button
        type="submit"
        formaction={`/admin/papers/${paper.id}/delete`}
        class="admin-btn admin-btn--danger"
        data-confirm="Delete this paper? This cannot be undone."
        style="margin-left:auto;"
      >
        Delete
      </button>
    )}
  </div>
</form>

<style is:global>
  .paper-form {
    display: grid;
    gap: 18px;
    max-width: 920px;
  }
  .paper-form__panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 22px;
    display: grid;
    gap: 14px;
  }
  .paper-form__panel-title {
    margin: 0;
    font-family: "Lora", Georgia, serif;
    font-weight: 500;
    font-size: 16px;
  }
  .paper-form__photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .paper-form__photo {
    display: grid;
    gap: 6px;
    cursor: default;
  }
  .paper-form__photo-img-wrap {
    position: relative;
  }
  .paper-form__photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #f4efe7;
    display: block;
    transition: opacity 150ms;
  }
  .paper-form__photo.is-removed img { opacity: 0.35; filter: grayscale(0.4); }
  .paper-form__photo.is-removed .paper-form__photo-set-primary,
  .paper-form__photo.is-removed .paper-form__photo-x,
  .paper-form__photo.is-removed .paper-form__photo-badge {
    display: none;
  }
  .paper-form__photo-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    background: var(--admin-petrol, #1a3550);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 999px;
    display: none;
  }
  .paper-form__photo.is-primary .paper-form__photo-badge { display: inline-flex; }
  .paper-form__photo.is-primary .paper-form__photo-set-primary { display: none; }
  .paper-form__photo-x {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 120ms;
  }
  .paper-form__photo-x:hover { background: rgba(0, 0, 0, 0.78); }
  .paper-form__photo-set-primary,
  .paper-form__photo-restore {
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 6px;
    font: inherit;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--admin-ink, #1a1a1a);
    padding: 4px 8px;
    cursor: pointer;
    transition: background 120ms, border-color 120ms;
  }
  .paper-form__photo-set-primary:hover,
  .paper-form__photo-restore:hover {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.20);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-confirm]").forEach((btn) => {
    btn.addEventListener("click", (ev) => {
      const msg = btn.getAttribute("data-confirm");
      if (msg && !window.confirm(msg)) {
        ev.preventDefault();
      }
    });
  });

  // Photo grid: drag-to-front primary swap + soft-delete with restore.
  // Browser sends checkbox values in DOM order, so reordering tiles here
  // saves the new order on submit. Soft-deleted tiles uncheck their
  // hidden kept_images checkbox so they're dropped server-side.
  const grid = document.querySelector<HTMLElement>("[data-photo-grid]");
  if (grid) {
    function sync() {
      const tiles = grid!.querySelectorAll<HTMLElement>("[data-photo]");
      let primaryAssigned = false;
      tiles.forEach((tile) => {
        const removed = tile.classList.contains("is-removed");
        const isPrimary = !removed && !primaryAssigned;
        tile.classList.toggle("is-primary", isPrimary);
        if (isPrimary) primaryAssigned = true;
      });
    }
    grid.addEventListener("click", (ev) => {
      const target = ev.target as HTMLElement;
      const tile = target.closest<HTMLElement>("[data-photo]");
      if (!tile) return;

      if (target.closest("[data-photo-set-primary]")) {
        // Move to the start of the grid.
        grid.prepend(tile);
        sync();
      } else if (target.closest("[data-photo-remove]")) {
        const keep = tile.querySelector<HTMLInputElement>("[data-photo-keep]");
        if (keep) keep.checked = false;
        tile.classList.add("is-removed");
        const restore = tile.querySelector<HTMLElement>("[data-photo-restore]");
        if (restore) restore.hidden = false;
        sync();
      } else if (target.closest("[data-photo-restore]")) {
        const keep = tile.querySelector<HTMLInputElement>("[data-photo-keep]");
        if (keep) keep.checked = true;
        tile.classList.remove("is-removed");
        const restore = tile.querySelector<HTMLElement>("[data-photo-restore]");
        if (restore) restore.hidden = true;
        sync();
      }
    });
    sync();
  }
</script>
