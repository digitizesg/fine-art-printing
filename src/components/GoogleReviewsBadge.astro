---
import Stars from "./Stars.astro";
import GoogleG from "./icons/GoogleG.astro";
import { business } from "../data/business";
import reviewsData from "../data/reviews.json";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const { rating, userRatingsTotal } = reviewsData;
---
<!-- Google rating as an outlined card: G mark, big score, stars, and the
     review count underneath, so it reads at a glance under each hero. -->
<a
  href={business.googleReviewsUrl}
  target="_blank"
  rel="noopener"
  aria-label={`Rated ${rating.toFixed(1)} out of 5 from ${userRatingsTotal} Google reviews`}
  class:list={[
    "group inline-flex items-center gap-4 rounded-[14px] border border-ink/20 bg-white py-3 pl-4 pr-5 transition-colors hover:border-ink",
    className,
  ]}
>
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-border-soft">
    <GoogleG size={26} />
  </span>
  <span class="flex flex-col gap-1">
    <span class="flex items-center gap-2.5">
      <span class="font-serif text-[26px] font-medium leading-none text-ink">{rating.toFixed(1)}</span>
      <Stars rating={rating} size={28} ariaHidden />
    </span>
    <span class="text-[15.5px] font-semibold text-ink group-hover:underline">
      {userRatingsTotal} Google reviews
    </span>
  </span>
</a>
