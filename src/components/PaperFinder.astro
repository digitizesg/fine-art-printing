---
import { PAPERS } from "../data/pricing/paper";
const featured = PAPERS.filter((p) => p.featured);

const questions = [
  {
    id: "q1",
    label: "What are you printing?",
    options: [
      { value: "A", label: "A photo (colour)" },
      { value: "B", label: "A photo (black & white)" },
      { value: "C", label: "A painting, drawing, or piece of original art" },
      { value: "D", label: "An illustration, graphic, or piece of digital art" },
    ],
  },
  {
    id: "q2",
    label: "How would you describe the colours in your image?",
    options: [
      { value: "A", label: "Bright and vibrant — saturated, eye-catching" },
      { value: "B", label: "Natural-looking — balanced, true-to-life" },
      { value: "C", label: "Soft or muted — subtle, low-contrast" },
      { value: "D", label: "Mostly tones or black-and-white — little to no colour" },
    ],
  },
  {
    id: "q3",
    label: "What kind of finish do you like?",
    options: [
      { value: "A", label: "Matt and smooth — no glare, calm, contemporary" },
      { value: "B", label: "Matt with hand-made texture — feels like art paper" },
      { value: "C", label: "Subtle satin or pearl sheen — gentle gallery feel" },
      { value: "D", label: "Glossy or shimmery — bright, cinematic, pops under light" },
    ],
  },
];
---
<section
  id="paper-finder"
  class="paper-finder border-t border-border-soft bg-white scroll-mt-6"
>
  <div class="mx-auto max-w-[1180px] px-6 py-20 md:py-24">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <span class="inline-flex items-center rounded-pill bg-petrol/[0.08] px-3 py-1 text-[12px] font-semibold text-petrol">
          Help me choose
        </span>
        <h2 class="mt-4 font-serif text-[clamp(1.75rem,3vw,2rem)] font-medium leading-[1.15] text-ink">
          Not sure which paper?
        </h2>
        <p class="mt-5 max-w-[380px] text-[15.5px] leading-relaxed text-subtle">
          Three quick questions and we'll point you to the paper that fits
          your image best, with a runner-up if it's close. No upload, no
          login, just a starting point.
        </p>
      </div>

      <div class="md:col-span-8">
        <form class="paper-finder__form" data-paper-finder novalidate>
          {questions.map((q) => (
            <fieldset class="paper-finder__group">
              <legend class="paper-finder__legend">{q.label}</legend>
              <div class="paper-finder__options" role="radiogroup">
                {q.options.map((opt) => (
                  <label class="paper-finder__option">
                    <input
                      type="radio"
                      name={q.id}
                      value={opt.value}
                      class="sr-only"
                    />
                    <span class="paper-finder__pip" aria-hidden="true"></span>
                    <span class="paper-finder__opt-label">{opt.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="paper-finder__output" data-pf-output>
            <p class="paper-finder__placeholder" data-pf-placeholder>
              Pick one answer in each row. Your match will appear here.
            </p>
            <div class="paper-finder__result" data-pf-result hidden>
              <div class="paper-finder__primary">
                <div class="paper-finder__primary-head">
                  <p class="paper-finder__primary-eyebrow">Best match</p>
                  <p class="paper-finder__primary-brand" data-pf-primary-brand></p>
                  <p class="paper-finder__primary-name" data-pf-primary-name></p>
                </div>
                <img class="paper-finder__primary-thumb" data-pf-primary-thumb alt="" loading="lazy" hidden />
              </div>
              <p class="paper-finder__primary-pitch" data-pf-primary-pitch></p>
              <button
                type="button"
                class="paper-finder__cta"
                data-pf-primary-link
              >
                See this paper in detail <span aria-hidden="true">→</span>
              </button>

              <div class="paper-finder__alt" data-pf-alt hidden>
                <p class="paper-finder__alt-eyebrow">Also worth a look</p>
                <p class="paper-finder__alt-name" data-pf-alt-name></p>
                <p class="paper-finder__alt-pitch" data-pf-alt-pitch></p>
                <button
                  type="button"
                  class="paper-finder__alt-link"
                  data-pf-alt-link
                >
                  See this one too <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .paper-finder__form {
    display: grid;
    gap: 22px;
  }
  .paper-finder__group {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .paper-finder__legend {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink);
    margin: 0;
  }
  .paper-finder__options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  @media (min-width: 700px) {
    .paper-finder__options {
      grid-template-columns: 1fr 1fr;
    }
  }
  .paper-finder__option {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 150ms ease-out, background 150ms ease-out;
    background: #fff;
  }
  .paper-finder__option:hover {
    border-color: rgba(0, 0, 0, 0.18);
    background: rgba(0, 0, 0, 0.015);
  }
  .paper-finder__option:has(input:checked) {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.04);
  }
  .paper-finder__pip {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    border: 1.5px solid rgba(0, 0, 0, 0.25);
    background: #fff;
    margin-top: 2px;
    transition: border-color 150ms ease-out, background 150ms ease-out;
    position: relative;
  }
  .paper-finder__option:has(input:checked) .paper-finder__pip {
    border-color: var(--color-petrol);
    background: var(--color-petrol);
    box-shadow: inset 0 0 0 3px #fff;
  }
  .paper-finder__opt-label {
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--color-ink);
  }

  /* Output */
  .paper-finder__output {
    margin-top: 6px;
  }
  .paper-finder__placeholder {
    margin: 0;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px dashed rgba(0, 0, 0, 0.18);
    color: var(--color-subtle);
    font-size: 13.5px;
    line-height: 1.5;
    background: #FAF7F1;
  }

  .paper-finder__result {
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 14px;
    padding: 22px;
    background: #FAF7F1;
    display: grid;
    gap: 14px;
  }
  .paper-finder__primary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .paper-finder__primary-eyebrow {
    margin: 0 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-petrol);
  }
  .paper-finder__primary-brand {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .paper-finder__primary-name {
    margin: 2px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.15;
  }
  .paper-finder__primary-thumb {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
    background: #f4efe7;
    border: 1px solid rgba(0, 0, 0, 0.06);
    flex: 0 0 auto;
  }
  .paper-finder__primary-pitch {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.85);
    max-width: 60ch;
  }

  .paper-finder__cta {
    appearance: none;
    border: 0;
    background: var(--color-petrol);
    color: #fff;
    border-radius: 999px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    align-self: start;
    transition: background 150ms ease-out;
  }
  .paper-finder__cta:hover {
    background: #142a40;
  }

  .paper-finder__alt {
    border-top: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    padding-top: 14px;
    display: grid;
    gap: 6px;
  }
  .paper-finder__alt-eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-muted);
  }
  .paper-finder__alt-name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .paper-finder__alt-pitch {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-subtle);
  }
  .paper-finder__alt-link {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin-top: 4px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-petrol);
    cursor: pointer;
    text-align: left;
    align-self: start;
  }
  .paper-finder__alt-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script>
  import { PAPERS } from "../data/pricing/paper";

  type AnswerKey = "A" | "B" | "C" | "D";
  type QuestionId = "q1" | "q2" | "q3";

  // Score each paper against each (question, answer) pair. Higher = better match.
  // Scores are tuned so every plausible combination has a clear or near-clear winner.
  const SCORES: Record<string, Record<QuestionId, Record<AnswerKey, number>>> = {
    "hahnemuhle-photo-rag": {
      q1: { A: 0, B: 3, C: 2, D: 2 },
      q2: { A: 0, B: 1, C: 3, D: 3 },
      q3: { A: 3, B: 0, C: 0, D: 0 },
    },
    "hahnemuhle-photo-rag-matt-baryta": {
      q1: { A: 3, B: 2, C: 0, D: 0 },
      q2: { A: 2, B: 3, C: 0, D: 0 },
      q3: { A: 3, B: 0, C: 0, D: 0 },
    },
    "hahnemuhle-bamboo": {
      q1: { A: 1, B: 2, C: 2, D: 0 },
      q2: { A: 0, B: 2, C: 2, D: 1 },
      q3: { A: 3, B: 0, C: 0, D: 0 },
    },
    "hahnemuhle-bamboo-gloss": {
      q1: { A: 3, B: 1, C: 0, D: 0 },
      q2: { A: 3, B: 1, C: 0, D: 0 },
      q3: { A: 0, B: 0, C: 0, D: 3 },
    },
    "hahnemuhle-hemp": {
      q1: { A: 0, B: 0, C: 3, D: 0 },
      q2: { A: 1, B: 1, C: 2, D: 1 },
      q3: { A: 0, B: 2, C: 0, D: 0 },
    },
    "hahnemuhle-fineart-pearl": {
      q1: { A: 2, B: 2, C: 2, D: 2 },
      q2: { A: 2, B: 2, C: 0, D: 1 },
      q3: { A: 0, B: 1, C: 3, D: 0 },
    },
    "hahnemuhle-metallic-rag": {
      q1: { A: 2, B: 3, C: 0, D: 0 },
      q2: { A: 3, B: 0, C: 0, D: 2 },
      q3: { A: 0, B: 0, C: 0, D: 3 },
    },
    "hahnemuhle-german-etching": {
      q1: { A: 0, B: 0, C: 3, D: 1 },
      q2: { A: 1, B: 1, C: 2, D: 1 },
      q3: { A: 0, B: 3, C: 0, D: 0 },
    },
    "hahnemuhle-photo-silk-baryta": {
      q1: { A: 2, B: 1, C: 0, D: 2 },
      q2: { A: 2, B: 1, C: 0, D: 0 },
      q3: { A: 0, B: 0, C: 3, D: 0 },
    },
    "datajet-100-cotton-rag": {
      q1: { A: 1, B: 2, C: 1, D: 2 },
      q2: { A: 0, B: 1, C: 2, D: 2 },
      q3: { A: 2, B: 0, C: 0, D: 0 },
    },
  };

  // Short rationale shown next to each recommendation.
  const PITCHES: Record<string, string> = {
    "hahnemuhle-photo-rag":
      "Smooth super-matt cotton, the studio benchmark for muted blacks and clean colour gradients. Especially flattering on B&W and contemplative work.",
    "hahnemuhle-photo-rag-matt-baryta":
      "A matt baryta coating gives you deep blacks and vivid colour without any surface gloss. The default for most photographers.",
    "hahnemuhle-bamboo":
      "Warm-toned, smooth, sustainable. Especially flattering on warm-toned colour and B&W work.",
    "hahnemuhle-bamboo-gloss":
      "Vibrant tonal range with the look and feel of an analogue baryta paper, on a warm bamboo base.",
    "hahnemuhle-hemp":
      "Lightly textured hemp/cotton with a silky feel and brilliant colour. A more environmentally friendly option for original art reproduction.",
    "hahnemuhle-fineart-pearl":
      "Subtle orange-peel pearl finish — almost like an oil painting, with vibrant colour and gentle sheen. Versatile across photo, art, and illustration.",
    "hahnemuhle-metallic-rag":
      "Heavyweight cotton with a silvery-shimmer surface. Made for architecture, night scenes, and B&W photography.",
    "hahnemuhle-german-etching":
      "Heavyweight, strongly textured matt paper. Hand-crafted feel with rich colours and deep blacks.",
    "hahnemuhle-photo-silk-baryta":
      "Silky-gloss surface at a more accessible price. Great for photo and poster prints where you want a sheen but not full gloss.",
    "datajet-100-cotton-rag":
      "Photo Rag character at a more accessible price. 100% cotton, archival, smooth super-matt.",
  };

  function scoreAll(answers: Record<QuestionId, AnswerKey>) {
    const totals: { id: string; score: number }[] = [];
    for (const id of Object.keys(SCORES)) {
      const matrix = SCORES[id]!;
      const total =
        matrix.q1[answers.q1] +
        matrix.q2[answers.q2] +
        matrix.q3[answers.q3];
      totals.push({ id, score: total });
    }
    totals.sort((a, b) => b.score - a.score);
    return totals;
  }

  function init() {
    const form = document.querySelector<HTMLFormElement>("[data-paper-finder]");
    if (!form) return;

    const placeholder = form.querySelector<HTMLElement>("[data-pf-placeholder]")!;
    const result = form.querySelector<HTMLElement>("[data-pf-result]")!;
    const primaryBrand = form.querySelector<HTMLElement>("[data-pf-primary-brand]")!;
    const primaryName = form.querySelector<HTMLElement>("[data-pf-primary-name]")!;
    const primaryThumb = form.querySelector<HTMLImageElement>("[data-pf-primary-thumb]")!;
    const primaryPitch = form.querySelector<HTMLElement>("[data-pf-primary-pitch]")!;
    const primaryLink = form.querySelector<HTMLButtonElement>("[data-pf-primary-link]")!;
    const altWrap = form.querySelector<HTMLElement>("[data-pf-alt]")!;
    const altName = form.querySelector<HTMLElement>("[data-pf-alt-name]")!;
    const altPitch = form.querySelector<HTMLElement>("[data-pf-alt-pitch]")!;
    const altLink = form.querySelector<HTMLButtonElement>("[data-pf-alt-link]")!;

    function jumpToPaper(paperId: string) {
      const showcase = document.querySelector<HTMLElement>("[data-paper-showcase]");
      if (!showcase) return;
      const tab = showcase.querySelector<HTMLButtonElement>(
        `[data-tab-target="${paperId}"]`,
      );
      tab?.click();
      // Use the tabs row as the scroll target so the picker is visible above
      // the active panel.
      const tabsRow = showcase.querySelector<HTMLElement>(".paper-showcase__tabs");
      (tabsRow ?? showcase).scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function render() {
      const data = new FormData(form);
      const q1 = data.get("q1") as AnswerKey | null;
      const q2 = data.get("q2") as AnswerKey | null;
      const q3 = data.get("q3") as AnswerKey | null;
      if (!q1 || !q2 || !q3) {
        placeholder.hidden = false;
        result.hidden = true;
        return;
      }
      const ranked = scoreAll({ q1, q2, q3 });
      const top = ranked[0]!;
      const second = ranked[1];
      const topPaper = PAPERS.find((p) => p.id === top.id)!;

      primaryBrand.textContent = topPaper.brand;
      primaryName.textContent = topPaper.shortName;
      const thumbSrc = topPaper.images[0] ? `/photos/${topPaper.images[0]}` : "";
      if (thumbSrc) {
        primaryThumb.src = thumbSrc;
        primaryThumb.alt = `Sample print on ${topPaper.name}`;
        primaryThumb.hidden = false;
      } else {
        primaryThumb.removeAttribute("src");
        primaryThumb.hidden = true;
      }
      primaryPitch.textContent = PITCHES[top.id] ?? topPaper.description;
      primaryLink.onclick = () => jumpToPaper(top.id);

      // Surface a runner-up only when it's a close call (within 1 point).
      if (second && top.score - second.score <= 1 && second.score > 0) {
        const altPaper = PAPERS.find((p) => p.id === second.id)!;
        altName.textContent = `${altPaper.brand} ${altPaper.shortName}`;
        altPitch.textContent = PITCHES[second.id] ?? altPaper.description;
        altLink.onclick = () => jumpToPaper(second.id);
        altWrap.hidden = false;
      } else {
        altWrap.hidden = true;
      }

      placeholder.hidden = true;
      result.hidden = false;
    }

    form.addEventListener("change", render);
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
