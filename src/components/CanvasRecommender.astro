    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.03);
  }
  .canvas-recommender__drop.is-dragover {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.06);
  }
  .canvas-recommender__drop-content {
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .canvas-recommender__drop-icon {
    color: var(--color-muted);
  }
  .canvas-recommender__drop-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-ink);
  }
  .canvas-recommender__drop-link {
    color: var(--color-petrol);
