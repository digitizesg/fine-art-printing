---
import { listCanvases } from "../lib/canvases";

const canvases = await listCanvases();
const lookup = canvases.reduce<Record<string, { brand: string; shortName: string; image: string }>>(
  (acc, c) => {
    acc[c.slug] = {
      brand: c.brand,
      shortName: c.shortName,
      image: c.imageUrls[0] ?? "",
    };
    return acc;
  },
  {},
);
---
<section class="canvas-recommender" data-canvas-recommender>
  <!-- Finish preference -->
  <div class="canvas-recommender__pref" data-cr-pref>
    <p class="canvas-recommender__pref-label">Finish preference</p>
    <div class="canvas-recommender__pref-row" role="radiogroup" aria-label="Finish preference">
      <button type="button" class="canvas-recommender__pref-btn is-active" data-pref="any">Either</button>
      <button type="button" class="canvas-recommender__pref-btn" data-pref="matt">Matt</button>
      <button type="button" class="canvas-recommender__pref-btn" data-pref="sheen">Glossy</button>
    </div>
  </div>

  <!-- Drop state -->
  <div data-cr-drop-state>
    <label class="canvas-recommender__drop" data-cr-drop>
      <input type="file" accept="image/jpeg,image/png" hidden data-cr-input />
      <div class="canvas-recommender__drop-content">
        <svg class="canvas-recommender__drop-icon" width="40" height="40" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path d="M14 30v6a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4v-6M24 8v22m0-22l-7 7m7-7l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="canvas-recommender__drop-title">
          Drop a reference image to get canvas suggestions
        </p>
        <p class="canvas-recommender__hint">
          or <span class="canvas-recommender__drop-link">click to browse</span> · JPG / PNG up to 100 MB · we won't print it, this is just for recommendations
        </p>
      </div>
    </label>
    <p class="canvas-recommender__error" data-cr-error hidden></p>
  </div>

  <!-- Result state -->
  <div class="canvas-recommender__result" data-cr-result hidden>
    <div class="canvas-recommender__result-head">
      <img class="canvas-recommender__thumb" data-cr-thumb alt="" />
      <div class="canvas-recommender__detected">
        <p class="canvas-recommender__detected-label">What we see</p>
        <ul class="canvas-recommender__traits" data-cr-traits></ul>
      </div>
      <button type="button" class="canvas-recommender__reset" data-cr-reset>
        Try another
      </button>
    </div>

    <div class="canvas-recommender__suggestions">
      <p class="canvas-recommender__suggestions-label">Canvases we'd suggest</p>
      <p class="canvas-recommender__warn" data-cr-warn hidden></p>
      <ul class="canvas-recommender__list" data-cr-list></ul>
      <p class="canvas-recommender__caveat">
        These are starting points based on colour and contrast only. We
        can't see your subject matter or taste, so browse all canvases below
        if none of these feel right.
      </p>
    </div>
  </div>

  <script type="application/json" data-cr-lookup set:html={JSON.stringify(lookup)}></script>
</section>

<style is:global>
