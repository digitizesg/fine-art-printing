    }
  }

  /* Finish preference */
  .canvas-recommender__pref {
    display: grid;
    gap: 8px;
  }
  .canvas-recommender__pref-label {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
