    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 10px;
    background: #f4efe7;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  @media (max-width: 540px) {
    .paper-recommender__thumb { width: 72px; height: 72px; }
  }

  .paper-recommender__detected-label {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
