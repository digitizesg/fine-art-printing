---
import { listPapers } from "../lib/papers";

const papers = await listPapers();
// Inline the paper info we need into the markup so the script doesn't have
// to re-import everything from the pricing data on the client.
const paperLookup = papers.reduce<Record<string, { brand: string; shortName: string; image: string }>>(
  (acc, p) => {
    acc[p.slug] = {
      brand: p.brand,
      shortName: p.shortName,
      image: p.imageUrls[0] ?? "",
    };
    return acc;
  },
  {},
);
---
<section class="paper-recommender" data-paper-recommender>
  <!-- Surface preference (always visible) -->
  <div class="paper-recommender__pref" data-pr-pref>
    <p class="paper-recommender__pref-label">Finish preference</p>
    <div class="paper-recommender__pref-row" role="radiogroup" aria-label="Finish preference">
      <button type="button" class="paper-recommender__pref-btn is-active" data-pref="any">Either</button>
      <button type="button" class="paper-recommender__pref-btn" data-pref="matt">Matt</button>
      <button type="button" class="paper-recommender__pref-btn" data-pref="sheen">Glossy</button>
    </div>
  </div>

  <!-- Drop state -->
  <div data-pr-drop-state>
    <label class="paper-recommender__drop" data-pr-drop>
      <input type="file" accept="image/jpeg,image/png" hidden data-pr-input />
      <div class="paper-recommender__drop-content">
        <svg class="paper-recommender__drop-icon" width="40" height="40" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path d="M14 30v6a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4v-6M24 8v22m0-22l-7 7m7-7l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="paper-recommender__drop-title">
          Drop a reference image to get paper suggestions
        </p>
        <p class="paper-recommender__hint">
          or <span class="paper-recommender__drop-link">click to browse</span> · JPG / PNG up to 100 MB · we won't print it, this is just for recommendations
        </p>
      </div>
    </label>
    <p class="paper-recommender__error" data-pr-error hidden></p>
  </div>

  <!-- Result state -->
  <div class="paper-recommender__result" data-pr-result hidden>
    <div class="paper-recommender__result-head">
      <img class="paper-recommender__thumb" data-pr-thumb alt="" />
      <div class="paper-recommender__detected">
        <p class="paper-recommender__detected-label">What we see</p>
        <ul class="paper-recommender__traits" data-pr-traits></ul>
      </div>
      <button type="button" class="paper-recommender__reset" data-pr-reset>
        Try another
      </button>
    </div>

    <div class="paper-recommender__suggestions">
      <p class="paper-recommender__suggestions-label">Papers we'd suggest</p>
      <p class="paper-recommender__warn" data-pr-warn hidden></p>
      <ul class="paper-recommender__list" data-pr-list></ul>
      <p class="paper-recommender__caveat">
        These are starting points based on colour and contrast only. We
        can't see your subject matter or taste, so browse all papers below
        if none of these feel right.
      </p>
    </div>
  </div>

  <script is:inline type="application/json" data-pr-lookup set:html={JSON.stringify(paperLookup)}></script>
</section>

<style is:global>
  .paper-recommender {
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    display: grid;
    gap: 22px;
  }
  @media (min-width: 760px) {
    .paper-recommender {
      padding: 28px;
    }
  }

  /* Surface preference */
  .paper-recommender__pref {
    display: grid;
    gap: 8px;
  }
  .paper-recommender__pref-label {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .paper-recommender__pref-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .paper-recommender__pref-btn {
    appearance: none;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: #fff;
    color: var(--color-ink);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease-out, border-color 150ms ease-out, color 150ms ease-out;
  }
  .paper-recommender__pref-btn:hover {
    border-color: rgba(0, 0, 0, 0.30);
    background: rgba(0, 0, 0, 0.02);
  }
  .paper-recommender__pref-btn.is-active {
    background: var(--color-selected);
    border-color: var(--color-selected);
    color: #fff;
  }

  /* Drop state */
  .paper-recommender__drop {
    display: block;
    border: 2px dashed rgba(0, 0, 0, 0.18);
    border-radius: 14px;
    padding: 36px 20px;
    background: #FAF7F1;
    text-align: center;
    cursor: pointer;
    transition: border-color 150ms ease-out, background 150ms ease-out;
  }
  .paper-recommender__drop:hover,
  .paper-recommender__drop:focus-within {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.03);
  }
  .paper-recommender__drop.is-dragover {
    border-color: var(--color-petrol);
    background: rgba(26, 53, 80, 0.06);
  }
