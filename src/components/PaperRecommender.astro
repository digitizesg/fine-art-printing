    gap: 2px;
    min-width: 0;
  }
  .paper-recommender__pick-brand {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.2;
  }
  .paper-recommender__pick-name {
    margin: 2px 0 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15.5px;
    color: var(--color-ink);
    line-height: 1.2;
  }
  .paper-recommender__pick-reason {
    margin: 4px 0 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-subtle);
  }
  .paper-recommender__pick-cta {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-petrol);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 4px;
    align-self: start;
    justify-self: end;
    white-space: nowrap;
  }
  .paper-recommender__pick-cta:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 540px) {
    .paper-recommender__pick {
      grid-template-columns: 56px 1fr;
      grid-template-areas:
        "thumb body"
        "reason reason"
        "cta cta";
      align-items: start;
      gap: 12px;
      padding: 12px;
    }
    .paper-recommender__pick-thumb { grid-area: thumb; }
    .paper-recommender__pick-body { grid-area: body; align-self: start; }
    .paper-recommender__pick-reason { grid-area: reason; margin-top: 4px; }
    .paper-recommender__pick-cta { grid-area: cta; justify-self: start; padding: 4px 0 0; }
  }

  .paper-recommender__caveat {
    margin: 4px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-subtle);
  }
</style>

<script>
  const MAX_BYTES = 100 * 1024 * 1024;
  const ALLOWED_TYPES = new Set(["image/jpeg", "image/png"]);
  const SAMPLE_MAX_DIM = 400;

  type PaperLookup = Record<string, { brand: string; shortName: string; image: string }>;
  type Saturation = "mono" | "low" | "medium" | "high";
  type Contrast = "low" | "medium" | "high";
  type Brightness = "dark" | "mid" | "bright";
  type Warmth = "cool" | "neutral" | "warm";
  type Traits = {
    saturation: Saturation;
    contrast: Contrast;
    brightness: Brightness;
    warmth: Warmth;
  };
  type Pick = { paperId: string; reason: string };

  type Preference = "any" | "matt" | "sheen";

  const root = document.querySelector<HTMLElement>("[data-paper-recommender]");
  if (root) initRecommender(root);

  function initRecommender(root: HTMLElement) {
    const lookupRaw = root.querySelector<HTMLElement>("[data-pr-lookup]")?.textContent ?? "{}";
    let lookup: PaperLookup = {};
    try {
      lookup = JSON.parse(lookupRaw);
    } catch {
      // empty lookup -> fall back to id strings
    }

    const dropState = root.querySelector<HTMLElement>("[data-pr-drop-state]")!;
    const drop = root.querySelector<HTMLLabelElement>("[data-pr-drop]")!;
    const input = root.querySelector<HTMLInputElement>("[data-pr-input]")!;
    const errorEl = root.querySelector<HTMLElement>("[data-pr-error]")!;
    const resultEl = root.querySelector<HTMLElement>("[data-pr-result]")!;
    const thumbEl = root.querySelector<HTMLImageElement>("[data-pr-thumb]")!;
    const traitsEl = root.querySelector<HTMLUListElement>("[data-pr-traits]")!;
    const listEl = root.querySelector<HTMLUListElement>("[data-pr-list]")!;
    const warnEl = root.querySelector<HTMLElement>("[data-pr-warn]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-pr-reset]")!;
    const prefBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".paper-recommender__pref-btn"),
    );

    let lastObjectUrl: string | null = null;
    let lastTraits: Traits | null = null;
    let preference: Preference = "any";

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      errorEl.textContent = "";
      errorEl.hidden = true;
    }

    async function analyseImage(file: File) {
      const bitmap = await createImageBitmap(file);
      const ratio = Math.min(
        SAMPLE_MAX_DIM / bitmap.width,
        SAMPLE_MAX_DIM / bitmap.height,
        1,
      );
      const w = Math.max(1, Math.round(bitmap.width * ratio));
      const h = Math.max(1, Math.round(bitmap.height * ratio));
      const canvas = document.createElement("canvas");
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas unavailable.");
      ctx.drawImage(bitmap, 0, 0, w, h);
      bitmap.close?.();

      const data = ctx.getImageData(0, 0, w, h).data;
      let sumS = 0,
        sumL = 0,
        sumL2 = 0,
        warmAcc = 0,
        satWeight = 0,
        n = 0;

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i]! / 255;
        const g = data[i + 1]! / 255;
        const b = data[i + 2]! / 255;
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        const l = (max + min) / 2;
        let s = 0;
        if (max !== min) {
          s = l < 0.5 ? (max - min) / (max + min) : (max - min) / (2 - max - min);
        }
        let hue = 0;
        if (max !== min) {
          const d = max - min;
          if (max === r) hue = ((g - b) / d) % 6;
          else if (max === g) hue = (b - r) / d + 2;
          else hue = (r - g) / d + 4;
          hue *= 60;
          if (hue < 0) hue += 360;
        }
        sumS += s;
        sumL += l;
        sumL2 += l * l;
        if (s > 0.05) {
          // Warmth: positive at red/orange/yellow, negative at cyan/blue.
          const radian = ((hue - 30) * Math.PI) / 180;
          warmAcc += Math.cos(radian) * s;
          satWeight += s;
        }
        n++;
      }
      const meanS = sumS / n;
      const meanL = sumL / n;
      const stdL = Math.sqrt(Math.max(0, sumL2 / n - meanL * meanL));
      const warmth = satWeight > 0 ? warmAcc / satWeight : 0;
      return { meanS, meanL, stdL, warmth };
    }

    function categorize(stats: {
      meanS: number;
      meanL: number;
      stdL: number;
      warmth: number;
    }): Traits {
      let saturation: Saturation;
      if (stats.meanS < 0.07) saturation = "mono";
      else if (stats.meanS < 0.2) saturation = "low";
      else if (stats.meanS < 0.38) saturation = "medium";
      else saturation = "high";

      let contrast: Contrast;
      if (stats.stdL < 0.15) contrast = "low";
      else if (stats.stdL < 0.25) contrast = "medium";
      else contrast = "high";

      let brightness: Brightness;
      if (stats.meanL < 0.35) brightness = "dark";
      else if (stats.meanL < 0.65) brightness = "mid";
      else brightness = "bright";

      let warmth: Warmth;
      if (stats.warmth > 0.18) warmth = "warm";
      else if (stats.warmth < -0.18) warmth = "cool";
      else warmth = "neutral";

      return { saturation, contrast, brightness, warmth };
    }

    function traitLabels(t: Traits): string[] {
      const labels: string[] = [];
      if (t.saturation === "mono") labels.push("Mostly tones / B&W");
      else if (t.saturation === "high") labels.push("Vibrant colour");
      else if (t.saturation === "medium") labels.push("Balanced colour");
      else labels.push("Muted colour");
      if (t.contrast === "high") labels.push("High contrast");
      else if (t.contrast === "low") labels.push("Soft contrast");
      if (t.brightness === "dark") labels.push("Dark scene");
      else if (t.brightness === "bright") labels.push("Bright scene");
      if (t.warmth === "warm") labels.push("Warm-toned");
      else if (t.warmth === "cool") labels.push("Cool-toned");
      return labels;
    }

    function mattPicks(t: Traits): Pick[] {
      const out: Pick[] = [];
      const { saturation, contrast, brightness, warmth } = t;
      if (saturation === "mono") {
        if (contrast === "high" || brightness === "dark") {
          out.push({
            paperId: "hahnemuhle-photo-rag-matt-baryta",
            reason:
              "For high-contrast or dark B&W, the baryta coating gives Photo Rag enhanced tonal range and deeper blacks.",
          });
          out.push({
            paperId: "hahnemuhle-photo-rag",
            reason:
              "Classic smooth matt cotton, quieter alternative if you prefer subtle blacks.",
          });
          out.push({
            paperId: "hahnemuhle-german-etching",
            reason:
              "Heavy texture and deeper blacks for dramatic, hand-crafted B&W.",
          });
        } else if (warmth === "warm") {
          out.push({
            paperId: "hahnemuhle-bamboo",
            reason: "Warm bamboo base flatters warm-toned monochrome work.",
          });
          out.push({
            paperId: "hahnemuhle-photo-rag-matt-baryta",
            reason:
              "Baryta-coated Photo Rag adds tonal depth, a punchier alternative for warm B&W.",
          });
          out.push({
            paperId: "hahnemuhle-photo-rag",
            reason:
              "Smooth matt cotton, neutral alternative with the cleanest tonal range.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-photo-rag",
            reason:
              "For soft or low-contrast B&W, smooth matt cotton gives the cleanest tonal range and a contemplative feel.",
          });
          out.push({
            paperId: "hahnemuhle-photo-rag-matt-baryta",
            reason:
              "Baryta-coated alternative, slightly deeper blacks and enhanced tonal range than plain Photo Rag.",
          });
          if (contrast === "low") {
            out.push({
              paperId: "hahnemuhle-hemp",
              reason:
                "Subtle hemp texture adds gentle character to soft monochrome work.",
            });
          } else {
            out.push({
              paperId: "datajet-100-cotton-rag",
              reason:
                "Photo Rag character at a more accessible price, same matt cotton feel.",
            });
          }
        }
      } else if (saturation === "high") {
        // Matt + vivid is a tradeoff, be honest in reasons.
        if (warmth === "warm") {
          out.push({
            paperId: "hahnemuhle-bamboo",
            reason:
              "Warm bamboo's matt cotton flatters the warm tones, though any matt paper will mute saturation somewhat.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-photo-rag",
            reason:
              "Smooth matt cotton, the calmest, no-glare choice, accepting that vivid colour will read more muted.",
          });
        }
        if (contrast === "high") {
          out.push({
            paperId: "hahnemuhle-german-etching",
            reason:
              "Strong texture and deeper blacks compensate for matt's dampening, a hand-crafted feel.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-bamboo",
            reason:
              "Warm bamboo matt, softer take that still pulls warm colour through.",
          });
        }
        out.push({
          paperId: "datajet-100-cotton-rag",
          reason:
            "Photo Rag character at a value price, same matt cotton character.",
        });
      } else if (saturation === "medium") {
        out.push({
          paperId: "hahnemuhle-photo-rag",
          reason:
            "Smooth matt cotton, clean colour and tonal range with no surface sheen.",
        });
        if (warmth === "warm") {
          out.push({
            paperId: "hahnemuhle-bamboo",
            reason:
              "Warm bamboo base reinforces warm-leaning balanced palettes.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-hemp",
            reason:
              "Lightly textured hemp, subtle character without disturbing balanced colour.",
          });
        }
        if (contrast === "high") {
          out.push({
            paperId: "hahnemuhle-german-etching",
            reason:
              "Heavy texture and deeper blacks suit high-contrast subjects.",
          });
        } else {
          out.push({
            paperId: "datajet-100-cotton-rag",
            reason: "Photo Rag character at a more accessible price.",
          });
        }
      } else {
        // low saturation
        out.push({
          paperId: "hahnemuhle-photo-rag",
          reason:
            "Soft, muted images sit beautifully on smooth matt cotton, no surface shimmer to compete.",
        });
        if (warmth === "warm") {
          out.push({
            paperId: "hahnemuhle-bamboo",
            reason: "Warm bamboo base reinforces a warm, contemplative mood.",
          });
        } else if (warmth === "cool") {
          out.push({
            paperId: "hahnemuhle-hemp",
            reason:
              "Hemp's silky light texture and natural-white tone flatters cool, muted palettes.",
          });
        } else {
          out.push({
            paperId: "datajet-100-cotton-rag",
            reason:
              "Photo Rag character at a more accessible price, smooth matt cotton, archival.",
          });
        }
        if (contrast === "high") {
          out.push({
            paperId: "hahnemuhle-german-etching",
            reason:
              "High contrast benefits from German Etching's deeper blacks and strongly textured surface.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-hemp",
            reason:
              "Lightly textured hemp adds gentle character to muted palettes.",
          });
        }
      }
      return dedupe(out);
    }

    function sheenPicks(t: Traits): Pick[] {
      const out: Pick[] = [];
      const { saturation, contrast, brightness, warmth } = t;
      if (saturation === "mono") {
        if (contrast === "high" || brightness === "dark") {
          out.push({
            paperId: "hahnemuhle-metallic-rag",
            reason:
              "Architectural and night-scene B&W picks up dramatic depth on the silvery metallic surface.",
          });
          out.push({
            paperId: "hahnemuhle-fineart-pearl",
            reason:
              "Pearl satin, gentle sheen that adds depth without distracting from B&W tonal range.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-fineart-pearl",
            reason:
              "Pearl satin, subtle sheen suits B&W with mid-range tones.",
          });
          out.push({
            paperId: "hahnemuhle-metallic-rag",
            reason:
              "Silvery shimmer adds drama to monochrome work where you want a more cinematic feel.",
          });
        }
      } else if (saturation === "high") {
        out.push({
          paperId: "hahnemuhle-bamboo-gloss",
          reason:
            warmth === "warm"
              ? "Vivid warm-toned colour comes alive on glossy bamboo baryta, the warm-white base reinforces it."
              : "Gloss baryta keeps saturated colour cinematic, the natural choice for vivid work.",
        });
        if (contrast === "high" || brightness === "dark") {
          out.push({
            paperId: "hahnemuhle-metallic-rag",
            reason:
              "Bright colour against dark or high-contrast backdrops shines on the metallic surface, strong on architecture, night, high-impact work.",
          });
          out.push({
            paperId: "hahnemuhle-fineart-pearl",
            reason:
              "Pearl satin, softer-sheen alternative that still carries saturated colour.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-fineart-pearl",
            reason:
              "Pearl satin carries saturation with a softer surface than full gloss, more contemplative.",
          });
          out.push({
            paperId: "hahnemuhle-photo-silk-baryta",
            reason:
              "Silky-gloss alpha-cellulose at a more accessible price, strong on photo and poster work.",
          });
        }
      } else if (saturation === "medium") {
        out.push({
          paperId: "hahnemuhle-fineart-pearl",
          reason:
            "Pearl satin handles balanced colour beautifully, with subtle sheen and excellent detail.",
        });
        if (brightness === "dark") {
          out.push({
            paperId: "hahnemuhle-metallic-rag",
            reason:
              "Dark, balanced palettes pick up depth on the metallic surface.",
          });
        } else {
          out.push({
            paperId: "hahnemuhle-photo-silk-baryta",
            reason:
              "Silky-gloss alpha-cellulose, value alternative with a smoother sheen.",
          });
        }
        out.push({
          paperId: "hahnemuhle-bamboo-gloss",
          reason:
            warmth === "warm"
              ? "Glossy bamboo baryta, warm-toned mid-saturation pops nicely."
              : "Glossy bamboo baryta, a punchier sheen pick for balanced colour.",
        });
      } else {
        // low saturation + sheen, unusual but valid
        out.push({
          paperId: "hahnemuhle-fineart-pearl",
          reason:
            "Pearl satin adds gentle depth and refinement to muted palettes, soft sheen, not glossy.",
        });
        out.push({
          paperId: "hahnemuhle-photo-silk-baryta",
          reason:
            "Silky-gloss surface, softer than full gloss, accessible price.",
        });
      }
      return dedupe(out);
    }

    function dedupe(picks: Pick[]): Pick[] {
      const seen = new Set<string>();
      return picks.filter((p) => {
        if (seen.has(p.paperId)) return false;
        seen.add(p.paperId);
        return true;
      });
    }

    function combinedPicks(t: Traits): Pick[] {
      const matt = mattPicks(t);
      const sheen = sheenPicks(t);
      // Lean matt for B&W; lean sheen for vivid; mix for medium/low.
      let combined: Pick[];
      if (t.saturation === "mono") {
        combined = [matt[0]!, matt[1]!, sheen[0]!];
      } else if (t.saturation === "high") {
        combined = [sheen[0]!, sheen[1]!, sheen[2] ?? matt[0]!];
      } else {
        combined = [matt[0]!, sheen[0]!, matt[1] ?? sheen[1]!];
      }
      return dedupe(combined.filter(Boolean));
    }

    function pickWarning(t: Traits, pref: Preference): string | null {
      if (pref === "matt" && t.saturation === "high") {
        return "Heads up: matt papers will mute vivid colour. If colour punch matters more than no-glare, switch to Glossy.";
      }
      if (pref === "sheen" && t.saturation === "low") {
        return "Note: sheen finishes are less common for muted, soft images, most studios reach for matt instead.";
      }
      return null;
    }

    function recommendFor(t: Traits, pref: Preference): Pick[] {
      if (pref === "matt") return mattPicks(t).slice(0, 3);
      if (pref === "sheen") return sheenPicks(t).slice(0, 3);
      return combinedPicks(t).slice(0, 3);
    }

    function jumpToPaper(paperId: string) {
      const showcase = document.querySelector<HTMLElement>("[data-paper-showcase]");
      if (!showcase) return;
      const tab = showcase.querySelector<HTMLButtonElement>(
        `[data-tab-target="${paperId}"]`,
      );
      tab?.click();
      const tabsRow = showcase.querySelector<HTMLElement>(".paper-showcase__tabs");
      (tabsRow ?? showcase).scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function renderPicks(picks: Pick[]) {
      listEl.innerHTML = "";
      picks.forEach((pick) => {
        const meta = lookup[pick.paperId];
        const li = document.createElement("li");
        li.className = "paper-recommender__pick";
        const thumb = meta?.image
          ? `<img class="paper-recommender__pick-thumb" src="${meta.image}" alt="" loading="lazy" />`
          : `<span class="paper-recommender__pick-thumb"></span>`;
        li.innerHTML = `
          ${thumb}
          <div class="paper-recommender__pick-body">
            <p class="paper-recommender__pick-brand">${meta?.brand ?? ""}</p>
            <p class="paper-recommender__pick-name">${meta?.shortName ?? pick.paperId}</p>
            <p class="paper-recommender__pick-reason">${pick.reason}</p>
          </div>
          <button type="button" class="paper-recommender__pick-cta">See in detail →</button>
        `;
        const cta = li.querySelector<HTMLButtonElement>(".paper-recommender__pick-cta")!;
        cta.addEventListener("click", () => jumpToPaper(pick.paperId));
        listEl.appendChild(li);
      });
    }

    function renderTraits(labels: string[]) {
      traitsEl.innerHTML = "";
      labels.forEach((l) => {
        const li = document.createElement("li");
        li.textContent = l;
        traitsEl.appendChild(li);
      });
    }

    function renderForCurrentTraits() {
      if (!lastTraits) return;
      const picks = recommendFor(lastTraits, preference);
      const labels = traitLabels(lastTraits);
      const warn = pickWarning(lastTraits, preference);
      renderTraits(labels);
      renderPicks(picks);
      if (warn) {
        warnEl.textContent = warn;
        warnEl.hidden = false;
      } else {
        warnEl.textContent = "";
        warnEl.hidden = true;
      }
    }

    async function handleFile(file: File) {
      clearError();
      if (!ALLOWED_TYPES.has(file.type)) {
        showError("That file isn't a JPG or PNG. Try one of those formats.");
        return;
      }
      if (file.size > MAX_BYTES) {
        showError("That file is over the 100 MB limit. Try a smaller version.");
        return;
      }
      try {
        const stats = await analyseImage(file);
        lastTraits = categorize(stats);

        if (lastObjectUrl) URL.revokeObjectURL(lastObjectUrl);
        lastObjectUrl = URL.createObjectURL(file);
        thumbEl.src = lastObjectUrl;
        thumbEl.alt = file.name;

        renderForCurrentTraits();

        dropState.hidden = true;
        resultEl.hidden = false;
      } catch (err) {
        showError(
          err instanceof Error
            ? err.message
            : "Could not analyse this image. Try a different file.",
        );
      }
    }

    prefBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = (btn.dataset.pref ?? "any") as Preference;
        if (next === preference) return;
        preference = next;
        prefBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        renderForCurrentTraits();
      });
    });

    input.addEventListener("change", () => {
      const f = input.files?.[0];
      if (f) handleFile(f);
    });

    ["dragenter", "dragover"].forEach((ev) =>
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.classList.add("is-dragover");
      }),
    );
    ["dragleave", "dragend"].forEach((ev) =>
      drop.addEventListener(ev, () => drop.classList.remove("is-dragover")),
    );
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      drop.classList.remove("is-dragover");
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) handleFile(f);
    });

    resetBtn.addEventListener("click", () => {
      if (lastObjectUrl) URL.revokeObjectURL(lastObjectUrl);
      lastObjectUrl = null;
      lastTraits = null;
      thumbEl.removeAttribute("src");
      input.value = "";
      listEl.innerHTML = "";
      traitsEl.innerHTML = "";
      warnEl.textContent = "";
      warnEl.hidden = true;
      resultEl.hidden = true;
      dropState.hidden = false;
      clearError();
    });
  }
</script>
