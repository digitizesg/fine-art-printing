    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .paper-recommender__drop-icon {
    color: var(--color-muted);
  }
  .paper-recommender__drop-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-ink);
  }
  .paper-recommender__drop-link {
    color: var(--color-petrol);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .paper-recommender__hint {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-subtle);
  }

  .paper-recommender__error {
    margin: 12px 0 0;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(220, 38, 38, 0.06);
    color: #b1271f;
    font-size: 13.5px;
  }

  /* Result state */
  .paper-recommender__result-head {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 16px;
    align-items: center;
  }
  @media (max-width: 540px) {
    .paper-recommender__result-head {
      grid-template-columns: 72px 1fr;
      grid-template-areas:
        "thumb detected"
        "reset reset";
    }
    .paper-recommender__thumb { grid-area: thumb; }
    .paper-recommender__detected { grid-area: detected; }
    .paper-recommender__reset { grid-area: reset; justify-self: start; }
