---
import { business } from "../data/business";
const year = new Date().getFullYear();
---
<footer class="border-t border-border-soft bg-white">
  <div class="mx-auto grid max-w-[1180px] grid-cols-1 gap-8 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="font-serif text-[18px] font-medium text-ink leading-tight">Fine Art Printing</p>
      <p class="mt-1 text-[10.5px] font-semibold uppercase tracking-[0.22em] text-petrol/85">
        Print · Stretch · Frame
      </p>
      <p class="mt-4 text-[13px] text-subtle">
        Singapore's print and framing studio.
      </p>
      <p class="mt-4 text-[12px] text-subtle">
        © {year} {business.legalName}
      </p>
    </div>

    <div>
      <p class="text-[12px] text-muted">Site</p>
      <ul class="mt-3 space-y-2 text-[13px]">
        <li><a href="/" class="hover:text-ink text-subtle">Home</a></li>
        <li><a href="/about" class="hover:text-ink text-subtle">About</a></li>
        <li><a href="/contact" class="hover:text-ink text-subtle">Contact</a></li>
        <li><a href="/articles" class="hover:text-ink text-subtle">Articles</a></li>
        <li><a href="/tools/image-analyser" class="hover:text-ink text-subtle">Image analyser</a></li>
        <li><a href="/make-payment" class="hover:text-ink text-subtle">Make a payment</a></li>
      </ul>
    </div>

    <div>
      <p class="text-[12px] text-muted">Services</p>
      <ul class="mt-3 space-y-2 text-[13px]">
        <li><a href="/print-on-paper" class="hover:text-ink text-subtle">Print on paper</a></li>
        <li><a href="/print-on-canvas" class="hover:text-ink text-subtle">Print on canvas</a></li>
        <li><a href="/canvas-stretching" class="hover:text-ink text-subtle">Canvas stretching & framing</a></li>
        <li><a href="/custom-framing" class="hover:text-ink text-subtle">Custom framing</a></li>
      </ul>
    </div>
  </div>
</footer>
