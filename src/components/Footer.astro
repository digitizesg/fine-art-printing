---
import { business } from "../data/business";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__row">
      <a href="/" class="footer__brand-link" aria-label="Fine Art Printing home">
        <span class="footer__brand-name">Fine Art Printing</span>
        <span class="footer__brand-sub">Print · Stretch · Frame</span>
      </a>

      <nav class="footer__nav" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/gallery">Our work</a>
        <a href="/articles">Articles</a>
        <a href="/tools">Tools</a>
        <a href="/careers">Careers</a>
        <a href="/contact">Contact</a>
        <a href={business.googleReviewsUrl} target="_blank" rel="noopener">Reviews</a>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} {business.legalName}</p>
      <p class="footer__credentials">
        Hahnemühle Gold-certified · Canon Pro-566
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    background: #FBFAF7;
    color: var(--color-ink);
  }
  .footer__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 22px;
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .footer__brand-link {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    line-height: 1.05;
  }
  .footer__brand-name {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .footer__brand-sub {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    color: rgba(26, 53, 80, 0.88);
    letter-spacing: 0.22em;
    margin-top: 3px;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-size: 13px;
  }
  .footer__nav a {
    color: var(--color-subtle);
    text-decoration: none;
    transition: color 120ms ease-out;
  }
  .footer__nav a:hover {
    color: var(--color-ink);
  }
  .footer__bottom {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 24px;
    font-size: 11.5px;
    color: var(--color-muted);
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__credentials {
    letter-spacing: 0.01em;
  }
</style>
