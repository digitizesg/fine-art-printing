---
import Button from "./Button.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
import { business } from "../data/business";

const services = [
  { href: "/print-on-paper", label: "Print on paper" },
  { href: "/print-on-canvas", label: "Print on canvas" },
  { href: "/canvas-stretching", label: "Stretch existing canvas" },
  { href: "/custom-framing", label: "Custom framing" },
];

const navLinks = [
  { href: "/shop", label: "Shop" },
  { href: "/gallery", label: "Gallery" },
  { href: "/articles", label: "Articles" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const waHref = `${business.whatsappLink}?text=${encodeURIComponent("Hi Fine Art Printing, I'd like a quick quote.")}`;
---
<header class="relative border-b border-border-soft bg-white">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-serif text-[20px] font-medium tracking-tight text-ink">
      Fine Art Printing
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7">
      <details class="services-menu">
        <summary class="services-menu__trigger text-[14px] text-muted hover:text-ink transition-colors">
          Services
          <svg class="services-menu__chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="services-menu__panel">
          {services.map((s) => (
            <a href={s.href} class="services-menu__link">{s.label}</a>
          ))}
        </div>
      </details>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[14px] text-muted hover:text-ink transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/cart"
        aria-label="View cart"
        class="nav-cart relative inline-flex h-9 items-center gap-1.5 rounded-full px-3 text-[13.5px] text-ink hover:bg-black/[0.04] transition-colors"
        data-nav-cart
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 4h2l1.5 9.5a1.5 1.5 0 0 0 1.48 1.25h7.04a1.5 1.5 0 0 0 1.48-1.25L18 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="17" r="1.1" fill="currentColor"/>
          <circle cx="15" cy="17" r="1.1" fill="currentColor"/>
        </svg>
        <span class="nav-cart__count" data-nav-cart-count hidden>0</span>
      </a>
      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        aria-label="Chat with us on WhatsApp"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#25D366] text-white transition-colors hover:bg-[#1ebe5b]"
      >
        <WhatsAppIcon size={16} />
      </a>
      <Button href="/contact" variant="secondary" class="!py-2 !px-4">
        Get in touch <span aria-hidden="true">→</span>
      </Button>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-controls="mobile-menu-panel"
      aria-expanded="false"
      aria-label="Toggle menu"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-md text-ink hover:bg-black/5 transition-colors"
    >
      <svg class="mobile-menu__icon-open" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <svg class="mobile-menu__icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" hidden>
        <path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu-panel"
    class="md:hidden border-t border-border-soft bg-white"
    hidden
  >
    <nav class="mx-auto flex max-w-[1180px] flex-col px-6 pt-4 pb-6">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-muted">Services</p>
      <div class="mt-1 flex flex-col">
        {services.map((s) => (
          <a
            href={s.href}
            class="block py-2.5 text-[15px] text-ink hover:text-petrol transition-colors"
          >
            {s.label}
          </a>
        ))}
      </div>

      <hr class="my-4 border-border-soft" />

      <div class="flex flex-col">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block py-2.5 text-[15px] text-ink hover:text-petrol transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="mt-5 flex flex-col gap-2.5">
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-pill border border-[#1ebe5b] bg-[#25D366] px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-[#1ebe5b]"
        >
          <WhatsAppIcon size={16} />
          <span>WhatsApp us</span>
        </a>
        <Button href="/contact" variant="secondary" class="w-full">
          Get in touch <span aria-hidden="true">→</span>
        </Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .services-menu {
    position: relative;
  }
  .services-menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .services-menu__trigger::-webkit-details-marker {
    display: none;
  }
  .services-menu__chevron {
    transition: transform 150ms ease-out;
  }
  .services-menu[open] .services-menu__chevron {
    transform: rotate(180deg);
  }
  .services-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    background: #fff;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 12px;
    box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.18);
    padding: 6px;
    display: grid;
    gap: 1px;
    z-index: 50;
  }
  .services-menu__link {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    transition: background 120ms ease-out;
    white-space: nowrap;
  }
  .services-menu__link:hover {
    background: rgba(0, 0, 0, 0.04);
  }
  .nav-cart__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-petrol);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
</style>

<script>
  import { cart } from "../lib/cart";

  function init() {
    // Cart count badge — show only when cart is non-empty.
    const countEl = document.querySelector<HTMLElement>("[data-nav-cart-count]");
    if (countEl) {
      const sync = (n: number) => {
        countEl.textContent = String(n);
        countEl.hidden = n === 0;
      };
      sync(cart.count());
      cart.onChange(sync);
    }

    // Services dropdown — close on outside click or Escape.
    const menus = document.querySelectorAll<HTMLDetailsElement>(".services-menu");
    menus.forEach((menu) => {
      document.addEventListener("click", (e) => {
        if (menu.open && !menu.contains(e.target as Node)) {
          menu.open = false;
        }
      });
      menu.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector<HTMLElement>("summary")?.focus();
        }
      });
    });

    // Mobile hamburger menu.
    const toggle = document.getElementById("mobile-menu-toggle");
    const panel = document.getElementById("mobile-menu-panel");
    if (!toggle || !panel) return;
    const iconOpen = toggle.querySelector<HTMLElement>(".mobile-menu__icon-open");
    const iconClose = toggle.querySelector<HTMLElement>(".mobile-menu__icon-close");

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      panel.hidden = !expanded;
      if (iconOpen) iconOpen.hidden = expanded;
      if (iconClose) iconClose.hidden = !expanded;
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setExpanded(!expanded);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setExpanded(false);
        toggle.focus();
      }
    });

    // Close when navigating away to a hash on the same page.
    panel.querySelectorAll<HTMLAnchorElement>("a[href^='#']").forEach((a) => {
      a.addEventListener("click", () => setExpanded(false));
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
