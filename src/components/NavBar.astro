---
import Button from "./Button.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
import { Image } from "astro:assets";
import { business } from "../data/business";

const services = [
  {
    href: "/print-on-paper",
    label: "Print on paper",
    image: "/photos/print-on-paper.jpg",
  },
  {
    href: "/print-on-canvas",
    label: "Print on canvas",
    image: "/photos/hahnemuhle-daguerre-canvas-1.jpg",
  },
  {
    href: "/canvas-stretching",
    label: "Stretch existing canvas",
    image: "/photos/canvas-stretching-framing.jpg",
  },
  {
    href: "/custom-framing",
    label: "Custom framing",
    image: "https://uemacvqwjqbxaedfwhll.supabase.co/storage/v1/object/public/frame-examples/2.5cm-classic-champagne-1.jpg",
  },
  {
    href: "/art-restoration",
    label: "Art restoration",
    image: "/photos/hahnemuhle-canvas-artist-1.jpg",
  },
  {
    href: "/scanning-restoration",
    label: "Photo restoration",
    image: "/photos/photo-rag-matt-baryta-4.jpg",
  },
  {
    href: "/art-scanning",
    label: "Art scanning",
    image: "/photos/german-etching-1.jpg",
  },
  {
    href: "/art-valuation",
    label: "Art valuation",
    image: "/photos/hahnemuhle-canvas-metallic-3.jpg",
  },
];

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Our work" },
  { href: "/tools", label: "Tools" },
  { href: "/shop", label: "Shop" },
];

const waHref = `${business.whatsappLink}?text=${encodeURIComponent("Hi Fine Art Printing, I'd like a quick quote.")}`;
---
<header class="relative border-b border-border-soft bg-white">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="brand">
      <span class="brand__name">Fine Art Printing</span>
      <span class="brand__sub">PRINT · STRETCH · FRAME</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7">
      <details class="services-menu">
        <summary class="services-menu__trigger text-[15.5px] text-muted hover:text-ink transition-colors">
          Services
          <svg class="services-menu__chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="services-menu__panel">
          <div class="services-menu__grid">
            {services.map((s) => (
              <a href={s.href} class="services-menu__card">
                <div class="services-menu__card-image">
                  <Image
                    src={s.image}
                    alt=""
                    width={320}
                    height={240}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="services-menu__card-title">{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[15.5px] text-muted hover:text-ink transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/cart"
        aria-label="View cart"
        class="nav-cart relative inline-flex h-9 items-center gap-1.5 rounded-full px-3 text-[13.5px] text-ink hover:bg-black/[0.04] transition-colors"
        data-nav-cart
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 4h2l1.5 9.5a1.5 1.5 0 0 0 1.48 1.25h7.04a1.5 1.5 0 0 0 1.48-1.25L18 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="17" r="1.1" fill="currentColor"/>
          <circle cx="15" cy="17" r="1.1" fill="currentColor"/>
        </svg>
        <span class="nav-cart__count" data-nav-cart-count hidden>0</span>
      </a>
      <Button href="/contact" variant="secondary" class="!py-2 !px-4 !text-[15.5px]">
        Get in touch <span aria-hidden="true">→</span>
      </Button>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-controls="mobile-menu-panel"
      aria-expanded="false"
      aria-label="Toggle menu"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-md text-ink hover:bg-black/5 transition-colors"
    >
      <svg class="mobile-menu__icon-open" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <svg class="mobile-menu__icon-close is-hidden" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu-panel"
    class="md:hidden border-t border-border-soft bg-white"
    hidden
  >
    <nav class="mx-auto flex max-w-[1180px] flex-col px-6 pt-4 pb-6">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-muted">Services</p>
      <div class="mt-1 flex flex-col">
        {services.map((s) => (
          <a
            href={s.href}
            class="block py-2.5 text-[15px] text-ink hover:text-petrol transition-colors"
          >
            {s.label}
          </a>
        ))}
      </div>

      <hr class="my-4 border-border-soft" />

      <div class="flex flex-col">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block py-2.5 text-[15px] text-ink hover:text-petrol transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="mt-5 flex flex-col gap-2.5">
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-pill border border-[#1ebe5b] bg-[#25D366] px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-[#1ebe5b]"
        >
          <WhatsAppIcon size={16} />
          <span>WhatsApp us</span>
        </a>
        <Button href="/contact" variant="secondary" class="w-full">
          Get in touch <span aria-hidden="true">→</span>
        </Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .is-hidden {
    display: none !important;
  }
  .services-menu {
    position: relative;
  }
  .services-menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .services-menu__trigger::-webkit-details-marker {
    display: none;
  }
  .services-menu__chevron {
    transition: transform 150ms ease-out;
  }
  .services-menu[open] .services-menu__chevron {
    transform: rotate(180deg);
  }
  .services-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    max-width: calc(100vw - 32px);
    background: #fff;
    border: 1px solid var(--color-border-soft, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.20);
    padding: 14px;
    z-index: 50;
  }
  /* Invisible bridge so the cursor can travel from trigger to panel
     without the dropdown closing on a millimetre of dead-space. */
  .services-menu__panel::before {
    content: "";
    position: absolute;
    inset: -10px 0 calc(100% - 10px) 0;
    background: transparent;
  }
  .services-menu__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .services-menu__card {
    display: flex;
    flex-direction: column;
    padding: 8px 8px 12px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 150ms ease-out;
  }
  .services-menu__card:hover {
    background: rgba(0, 0, 0, 0.035);
  }
  .services-menu__card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: #f4efe7;
    margin-bottom: 10px;
  }
  .services-menu__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }
  .services-menu__card:hover .services-menu__card-image img {
    transform: scale(1.04);
  }
  .services-menu__card-title {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.25;
  }
  .services-menu__card-sub {
    font-size: 12.5px;
    color: var(--color-subtle);
    margin-top: 3px;
    line-height: 1.4;
  }
  .brand {
    display: inline-grid;
    gap: 1px;
    text-decoration: none;
    line-height: 1;
  }
  .brand__name {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .brand__sub {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    /* Darkened from 0.62 → 0.85 so the wide-tracked label passes WCAG
       AA (4.5:1) on white. Visually still reads as a quiet sub-label. */
    color: rgba(26, 53, 80, 0.88);
    letter-spacing: 0.22em;
    margin-top: 4px;
  }
  @media (max-width: 480px) {
    .brand__name { font-size: 18px; }
    .brand__sub { font-size: 9px; letter-spacing: 0.18em; }
  }

  .nav-cart__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-petrol);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
</style>

<script>
  import { cart } from "../lib/cart";

  function init() {
    // Cart count badge — show only when cart is non-empty.
    const countEl = document.querySelector<HTMLElement>("[data-nav-cart-count]");
    if (countEl) {
      const sync = (n: number) => {
        countEl.textContent = String(n);
        countEl.hidden = n === 0;
      };
      sync(cart.count());
      cart.onChange(sync);
    }

    // Services dropdown — close on outside click or Escape, plus
    // hover-to-open on devices with a fine pointer (i.e. mouse, not
    // touch) so the click affordance still works on tablets/phones.
    const menus = document.querySelectorAll<HTMLDetailsElement>(".services-menu");
    const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    menus.forEach((menu) => {
      document.addEventListener("click", (e) => {
        if (menu.open && !menu.contains(e.target as Node)) {
          menu.open = false;
        }
      });
      menu.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector<HTMLElement>("summary")?.focus();
        }
      });

      if (supportsHover) {
        let closeTimer: ReturnType<typeof setTimeout> | null = null;
        const cancelClose = () => {
          if (closeTimer) {
            clearTimeout(closeTimer);
            closeTimer = null;
          }
        };
        menu.addEventListener("mouseenter", () => {
          cancelClose();
          menu.open = true;
        });
        menu.addEventListener("mouseleave", () => {
          cancelClose();
          // Small grace period so the cursor can leave the trigger and
          // re-enter the panel without the menu collapsing.
          closeTimer = setTimeout(() => {
            menu.open = false;
          }, 120);
        });
        // On click of summary, prevent the default toggle so we don't
        // close a hover-opened panel when the user clicks (e.g. trying
        // to navigate to a card).
        const summary = menu.querySelector<HTMLElement>("summary");
        summary?.addEventListener("click", (e) => {
          if (menu.open) e.preventDefault();
        });
      }
    });

    // Mobile hamburger menu.
    const toggle = document.getElementById("mobile-menu-toggle");
    const panel = document.getElementById("mobile-menu-panel");
    if (!toggle || !panel) return;
    const iconOpen = toggle.querySelector<HTMLElement>(".mobile-menu__icon-open");
    const iconClose = toggle.querySelector<HTMLElement>(".mobile-menu__icon-close");

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      panel.hidden = !expanded;
      iconOpen?.classList.toggle("is-hidden", expanded);
      iconClose?.classList.toggle("is-hidden", !expanded);
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setExpanded(!expanded);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setExpanded(false);
        toggle.focus();
      }
    });

    // Close when navigating away to a hash on the same page.
    panel.querySelectorAll<HTMLAnchorElement>("a[href^='#']").forEach((a) => {
      a.addEventListener("click", () => setExpanded(false));
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
