---
interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Fine Art Printing admin</title>
    <link rel="stylesheet" href="/admin/admin.css" />
  </head>
  <body class="admin-shell admin-shell--app">
    <header class="admin-topbar">
      <div class="admin-topbar__inner">
        <a href="/admin" class="admin-topbar__brand">Fine Art Printing · admin</a>
        <nav class="admin-topbar__nav">
          <a href="/admin">Examples</a>
          <a href="/admin/artworks">Artworks</a>
          <a href="/admin/papers">Papers</a>
          <a href="/admin/canvases">Canvases</a>
          <a href="/admin/float-frames">Float frames</a>
        </nav>
        <div class="admin-topbar__user">
          <span>{user?.email}</span>
          <form method="POST" action="/admin/auth/signout">
            <button type="submit" class="admin-btn admin-btn--ghost" style="padding:6px 12px;font-size:12.5px;">
              Sign out
            </button>
          </form>
        </div>
      </div>
    </header>
    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>
